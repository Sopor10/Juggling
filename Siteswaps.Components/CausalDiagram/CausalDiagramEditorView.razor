    private void HandleThrowActionKey(string id, KeyboardEventArgs e, bool delete, int cycle = 0)
    {
        if (e.Key is not ("Enter" or " ")) return;
        if (delete) DeleteThrow(id);
        else ToggleHandMenu(id, cycle);
    }

    private void HandleHandMenuKey(string id, KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") ToggleThrowHand(id);
    }

    private void ToggleThrowHand(string id)
    {
        var item = _state.Throws.FirstOrDefault(throwNode => throwNode.Id == id);
        if (item is null) return;
        _state.Throws[_state.Throws.IndexOf(item)] = item with { Hand = item.Hand == "R" ? "L" : "R" };
        _handMenuThrow = null;
        PatternChanged();
    }

    private void AddThrow(string jugglerId)
    {
        if (_state.Throws.Count >= 500) return;
        var juggler = _state.Jugglers.FirstOrDefault(j => j.Id == jugglerId);
        if (juggler is null) return;
        _state.ActiveJugglerId = jugglerId;
        var last = _state.Throws.LastOrDefault(t => t.JugglerId == juggler.Id);
        var start = last is null ? 0m : Math.Min(_state.CycleLength - 0.25m, last.StartTime + 1m);
        var hand = last?.Hand == "R" ? "L" : "R";
        var item = new EditorThrow(Guid.NewGuid().ToString("N"), juggler.Id, hand, Math.Max(0m, start));
        _state.Throws.Add(item);
        _selectedId = item.Id;
        PatternChanged();
    }

    private void AddMultiplexThrow()
    {
        if (!CanAddMultiplexThrow || _selectedId is null)
            return;
        var source = _state.Throws.FirstOrDefault(item => item.Id == _selectedId);
        if (source is null)
            return;

        var originalNodes = _state.Throws.ToDictionary(node => node.Id, StringComparer.Ordinal);
        var originalEdges = _state.CausalEdges.ToDictionary(edge => edge.FromThrowId, StringComparer.Ordinal);
        var orbit = GetCausalOrbit(source.Id, originalEdges);
        if (_state.Throws.Count + orbit.Count > 500)
            return;

        var clones = orbit.ToDictionary(id => id, _ => Guid.NewGuid().ToString("N"), StringComparer.Ordinal);
        foreach (var originalId in orbit)
            _state.Throws.Add(originalNodes[originalId] with { Id = clones[originalId] });
        foreach (var originalId in orbit)
        {
            if (!originalEdges.TryGetValue(originalId, out var edge))
                continue;
            var targetId = clones.TryGetValue(edge.ToThrowId, out var clonedTarget) ? clonedTarget : edge.ToThrowId;
            _state.CausalEdges.Add(
                new EditorCausalEdge($"e-{clones[originalId]}", clones[originalId], targetId, edge.CycleOffset)
            );
        }
        _selectedId = clones[source.Id];
        _editingThrow = (_selectedId, 0);
        PatternChanged();
    }

    private bool CanAddMultiplexThrow => _selectedId is not null
        && _state.CausalEdges.Any(edge => edge.FromThrowId == _selectedId)
        && _state.Throws.Count + GetCausalOrbit(_selectedId).Count <= 500;

    private List<string> GetCausalOrbit(
        string sourceId,
        IReadOnlyDictionary<string, EditorCausalEdge>? edgeMap = null
    )
    {
        edgeMap ??= _state.CausalEdges.ToDictionary(edge => edge.FromThrowId, StringComparer.Ordinal);
        var orbit = new List<string>();
        var seen = new HashSet<string>(StringComparer.Ordinal);
        var currentId = sourceId;
        while (seen.Add(currentId) && edgeMap.TryGetValue(currentId, out var edge))
        {
            orbit.Add(currentId);
            currentId = edge.ToThrowId;
        }
        if (orbit.Count == 0)
            orbit.Add(sourceId);
        return orbit;
    }

    private void AddJuggler()
    {
        if (_state.Jugglers.Count >= 16) return;
        var index = _state.Jugglers.Count;
        var id = $"J{index + 1}";
        while (_state.Jugglers.Any(j => j.Id == id)) id = $"J-{Guid.NewGuid():N}";
        _state.Jugglers.Add(new EditorJuggler(id, $"Jongleur {index + 1}"));
        var throwId = $"{id}-1";
        _state.Throws.Add(new EditorThrow(throwId, id, "R", 0m));
        _state.CausalEdges.Add(new EditorCausalEdge($"e-{throwId}", throwId, throwId, -1));
        _state.ActiveJugglerId = id;
        _state.NormalizeCausalEdgeOffsets();
        PatternChanged();
    }

    private void DeleteThrow(string id)
    {
        var item = _state.Throws.FirstOrDefault(throwNode => throwNode.Id == id);
        if (item is null) return;
        var deleteIds = ShouldDeleteMultiplexOrbit(item)
            ? GetCausalOrbit(item.Id).ToHashSet(StringComparer.Ordinal)
            : new HashSet<string>([item.Id], StringComparer.Ordinal);
        _state.Throws.RemoveAll(throwNode => deleteIds.Contains(throwNode.Id));
        _state.CausalEdges.RemoveAll(edge => deleteIds.Contains(edge.FromThrowId) || deleteIds.Contains(edge.ToThrowId));
        _selectedId = null;
        _editingThrow = null;
        _handMenuThrow = null;
        PatternChanged();
    }

    private string DeleteThrowAccessibleLabel(EditorThrow node) => ShouldDeleteMultiplexOrbit(node)
        ? "Multiplex-Orbit löschen"
        : "Wurf löschen";

    private bool ShouldDeleteMultiplexOrbit(EditorThrow node) =>
        MultiplexCount(node) > 1 && CausalOrbitClosesAtSource(node.Id);

    private bool CausalOrbitClosesAtSource(string sourceId)
    {
        var edges = _state.CausalEdges.ToDictionary(edge => edge.FromThrowId, StringComparer.Ordinal);
        var seen = new HashSet<string>(StringComparer.Ordinal) { sourceId };
        var currentId = sourceId;
        while (edges.TryGetValue(currentId, out var edge))
        {
            currentId = edge.ToThrowId;
            if (currentId == sourceId)
                return true;
            if (!seen.Add(currentId))
                return false;
        }
        return false;
    }

    private bool IsPresetSelected(string id) => _preset == id || _selectedSavedPresetId == id;

    private async Task LoadPreset(string id)
    {
        _preset = id;
        _selectedSavedPresetId = null;
        _state = CausalDiagramEditorPresets.All.FirstOrDefault(preset => preset.Id == _preset)?.Create() ?? CausalDiagramEditorState.CreateEmpty();
        RebuildLayoutMetrics();
        _state.ActiveJugglerId = _state.Jugglers[0].Id;
        _selectedId = null;
        SyncSetupFromState();
        StateChanged();
        if (_module is not null)
            await _module.InvokeVoidAsync("closeDiagramOptionsOnMobile", _diagramOptions);
    }

    private void LoadSetupPreset(string id)
    {
        _preset = id;
        _selectedSavedPresetId = null;
        _state = CausalDiagramEditorPresets.All.FirstOrDefault(preset => preset.Id == _preset)?.Create()
            ?? CausalDiagramEditorState.CreateEmpty();
        if (_preset == "custom" && _state.Throws.Count == 0)
            _state.Throws.Add(new EditorThrow("A1", _state.Jugglers[0].Id, "R", 0m));
        _state.ActiveJugglerId = _state.Jugglers[0].Id;
        RebuildLayoutMetrics();
        _selectedId = null;
        SyncSetupFromState();
        RefreshAnimation();
        PersistSetupDraft(includeBaseState: true);
    }

    private async Task LoadSavedPreset(SavedEditorPreset preset)
    {
        if (!CausalDiagramEditorState.TryDecode(preset.StateToken, out var savedState) || savedState is null)
        {
            _presetMessage = "Diese gespeicherte Vorlage ist beschädigt.";
            return;
        }

        _state = savedState;
        _preset = "custom";
        _selectedSavedPresetId = preset.Id;
        _state.PresetId = "custom";
        RebuildLayoutMetrics();
        _selectedId = null;
        _handMenuThrow = null;
        SyncSetupFromState();
        RefreshAnimation();
        if (!Embedded && _wizardStep == 1)
            PersistSetupDraft(includeBaseState: true);
        else
            StateChanged();
        if (_module is not null)
            await _module.InvokeVoidAsync("closeDiagramOptionsOnMobile", _diagramOptions);
    }

    private async Task SaveCurrentPreset()
    {
        var name = _presetName.Trim();
        if (_module is null || name.Length == 0)
            return;

        _state.PresetId = "custom";
        var saved = new SavedEditorPreset(Guid.NewGuid().ToString("N"), name, _state.Encode());
        try
        {
            _savedPresets = (await _module.InvokeAsync<SavedEditorPreset[]>("saveEditorPreset", saved))?.ToList() ?? _savedPresets;
            _selectedSavedPresetId = saved.Id;
            _presetName = "";
            _presetMessage = $"Vorlage „{name}“ wurde auf diesem Gerät gespeichert.";
        }
        catch (JSException)
        {
            _presetMessage = "Die Vorlage konnte im lokalen Speicher nicht gespeichert werden.";
        }
    }

    private async Task DeleteSavedPreset(string id)
    {
        if (_module is null)
            return;

        _savedPresets = (await _module.InvokeAsync<SavedEditorPreset[]>("deleteEditorPreset", id))?.ToList() ?? _savedPresets;
        if (_selectedSavedPresetId == id)
            _selectedSavedPresetId = null;
    }

    private void SyncSetupFromState()
    {
        var setupRows = _state.Jugglers.Select(juggler =>
        {
            var throws = _state.Throws
                .Where(item => item.JugglerId == juggler.Id)
                .OrderBy(item => item.StartTime)
                .ToList();
            var beatCount = Math.Clamp(throws.Count, 1, 64);
            var handSequence = throws.Count == 0
                ? "R"
                : string.Concat(throws.Select(item => item.Hand == "L" ? 'L' : 'R'));
            var beatDuration = _state.CycleLength / beatCount;
            var phaseOffset = throws.Count == 0 || beatDuration <= 0
                ? 0m
                : Math.Clamp(Math.Round(throws[0].StartTime / beatDuration, 2, MidpointRounding.AwayFromZero), 0m, 1m);

            return new SetupJugglerSettings(
                juggler.Id,
                juggler.Name,
                beatCount,
                ShortestRepeatingHandOrder(handSequence),
                phaseOffset
            );
        }).ToList();

        if (setupRows.Count == 0)
            setupRows.Add(new SetupJugglerSettings("setup-1", "A", 1, "R", 0m));

        _setupJugglers = setupRows;
        _stateSetupJugglers = setupRows.ToList();
        _setupValidationError = null;
    }

    private static string ShortestRepeatingHandOrder(string sequence)
    {
        for (var length = 1; length <= Math.Min(16, sequence.Length); length++)
        {
            if (Enumerable.Range(length, sequence.Length - length)
                .All(index => sequence[index] == sequence[index % length]))
                return sequence[..length];
        }

        return sequence[..Math.Min(16, sequence.Length)];
    }

    private static string FormatPhaseOffset(decimal offset) =>
        offset.ToString("0.##", CultureInfo.InvariantCulture);

    private static string EncodeSetupDraft(SetupDraft draft) =>
        Convert.ToBase64String(JsonSerializer.SerializeToUtf8Bytes(draft))
            .TrimEnd('=')
            .Replace('+', '-')
            .Replace('/', '_');

    private static bool TryDecodeSetupDraft(string? token, out SetupDraft draft)
    {
        draft = new SetupDraft("custom", []);
        if (string.IsNullOrWhiteSpace(token) || token.Length > 8_000)
            return false;

        try
        {
            var base64 = token.Replace('-', '+').Replace('_', '/');
            base64 = base64.PadRight(base64.Length + (4 - base64.Length % 4) % 4, '=');
            var decoded = JsonSerializer.Deserialize<SetupDraft>(Convert.FromBase64String(base64));
            if (
                decoded is null
                || !CausalDiagramEditorPresets.IsKnownId(decoded.PresetId)
                || decoded.Jugglers is null
                || decoded.Jugglers.Length is < 1 or > 16
                || decoded.Jugglers.Any(juggler =>
                    juggler is null
                    || string.IsNullOrEmpty(juggler.Id)
                    || juggler.Id.Length > 64
                    || juggler.Name is null
                    || juggler.Name.Length > 128
                    || juggler.HandOrder is null
                    || juggler.HandOrder.Length > 64
                )
                || decoded.Jugglers.Select(juggler => juggler.Id)
                    .Distinct(StringComparer.Ordinal).Count() != decoded.Jugglers.Length
            )
                return false;

            draft = decoded;
            return true;
        }
        catch (Exception exception) when (exception is FormatException or JsonException or ArgumentException)
        {
            return false;
        }
    }

    private void PersistSetupDraft(bool includeBaseState = false)
    {
        if (Embedded)
            return;

        var token = EncodeSetupDraft(new SetupDraft(_preset, _setupJugglers.ToArray()));
        var uri = UrlStateNavigation.GetUriWithQueryParameter("setup", token);
        uri = UrlStateNavigation.WithQueryParameter(
            uri,
            "step",
            _wizardStep.ToString(CultureInfo.InvariantCulture)
        );
        if (includeBaseState)
            uri = UrlStateNavigation.WithQueryParameter(uri, "state", _state.Encode());

        UrlStateNavigation.NavigateTo(uri, replace: true);
    }

    private void SetSetupJugglerName(string id, string? name) =>
        UpdateSetupJuggler(id, juggler => juggler with { Name = name ?? string.Empty });

    private void SetSetupJugglerBeats(string id, string? value)
    {
        if (int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var beats))
            UpdateSetupJuggler(id, juggler => juggler with { BeatCount = beats });
    }

    private void SetSetupJugglerHands(string id, string? handOrder) =>
        UpdateSetupJuggler(id, juggler => juggler with
        {
            HandOrder = (handOrder ?? string.Empty).Replace(" ", string.Empty, StringComparison.Ordinal).ToUpperInvariant(),
        });

    private void SetSetupJugglerOffset(string id, string? value)
    {
        if (decimal.TryParse(value, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var offset))
            UpdateSetupJuggler(id, juggler => juggler with { PhaseOffset = offset });
    }

    private void UpdateSetupJuggler(string id, Func<SetupJugglerSettings, SetupJugglerSettings> update)
    {
        var index = _setupJugglers.FindIndex(juggler => juggler.Id == id);
        if (index >= 0)
            _setupJugglers[index] = update(_setupJugglers[index]);
        _setupValidationError = null;
        PersistSetupDraft();
    }

    private void AddSetupJuggler()
    {
        if (_setupJugglers.Count >= 16)
            return;

        var index = _setupJugglers.Count;
        var id = $"setup-{Guid.NewGuid():N}";
        _setupJugglers.Add(new SetupJugglerSettings(id, ((char)('A' + index)).ToString(), 1, "R", 0m));
        _setupValidationError = null;
        PersistSetupDraft();
    }

    private void RemoveSetupJuggler(string id)
    {
        if (_setupJugglers.Count <= 1)
            return;

        _setupJugglers.RemoveAll(juggler => juggler.Id == id);
        _setupValidationError = null;
        PersistSetupDraft();
    }

    private void BackToSetup()
    {
        SyncSetupFromState();
        _wizardStep = 1;
        PersistSetupDraft();
    }

    private void SelectWizardStep(int step)
    {
        if (step == 0)
            BackToSetup();
        else if (step == 1 && _visitedWizardSteps.Contains(step))
            ContinueToEditor();
    }

    private void ContinueToEditor()
    {
        if (!ValidateSetupJugglers(out var validationError))
        {
            _setupValidationError = validationError;
            return;
        }

        if (!ApplySetupChanges(out validationError))
        {
            _setupValidationError = validationError;
            return;
        }

        _setupValidationError = null;
        CompleteEditorTransition();
    }

    private bool ApplySetupChanges(out string error)
    {
        if (SetupSettingsChanged())
            return ApplyChangedJugglerSettings(out error);

        ApplyJugglerNames();
        error = string.Empty;
        return true;
    }

    private bool SetupSettingsChanged() => _setupJugglers.Count != _stateSetupJugglers.Count
        || _setupJugglers.Zip(_stateSetupJugglers).Any(pair =>
            pair.First.Id != pair.Second.Id
            || pair.First.BeatCount != pair.Second.BeatCount
            || pair.First.HandOrder != pair.Second.HandOrder
            || pair.First.PhaseOffset != pair.Second.PhaseOffset);

    private bool ApplyChangedJugglerSettings(out string error)
    {
        if (!TryCreateSetupState(out var configuredState, out error) || configuredState is null)
            return false;

        configuredState.Repetitions = _state.Repetitions;
        configuredState.SnapEnabled = _state.SnapEnabled;
        configuredState.TimelineWidth = _state.TimelineWidth;
        configuredState.LaneSpacing = _state.LaneSpacing;
        configuredState.SnapStep = _state.SnapStep;
        configuredState.PresetId = "custom";
        _state = configuredState;
        RebuildLayoutMetrics();
        _preset = "custom";
        return true;
    }

    private void ApplyJugglerNames()
    {
        var namesChanged = _setupJugglers.Count != _stateSetupJugglers.Count
            || _setupJugglers.Zip(_stateSetupJugglers).Any(pair =>
                pair.First.Id != pair.Second.Id || pair.First.Name != pair.Second.Name);
        foreach (var setupJuggler in _setupJugglers)
        {
            var index = _state.Jugglers.FindIndex(juggler => juggler.Id == setupJuggler.Id);
            if (index >= 0)
                _state.Jugglers[index] = _state.Jugglers[index] with { Name = setupJuggler.Name.Trim() };
        }

        if (namesChanged)
        {
            _preset = "custom";
            _state.PresetId = "custom";
        }
    }

    private void CompleteEditorTransition()
    {
        if (!_state.Jugglers.Any(item => item.Id == _state.ActiveJugglerId))
            _state.ActiveJugglerId = _state.Jugglers[0].Id;
        _state.NormalizeCausalEdgeOffsets();
        _selectedId = null;
        _visitedWizardSteps.Add(1);
        _wizardStep = 2;
        StateChanged();
    }

    private bool ValidateSetupJugglers(out string error)
    {
        if (_setupJugglers.Count is < 1 or > 16)
        {
            error = "Das Diagramm benötigt zwischen 1 und 16 Jongleure.";
            return false;
        }

        if (_setupJugglers.Any(juggler =>
            string.IsNullOrWhiteSpace(juggler.Name)
            || juggler.Name.Trim().Length > 32
            || juggler.Name.Any(char.IsControl)))
        {
            error = "Gib für jeden Jongleur einen Namen mit höchstens 32 Zeichen ein.";
            return false;
        }

        if (_setupJugglers.Select(juggler => juggler.Name.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).Count() != _setupJugglers.Count)
        {
            error = "Die Namen der Jongleure müssen eindeutig sein.";
            return false;
        }

        if (_setupJugglers.Any(juggler => juggler.BeatCount is < 1 or > 64))
        {
            error = "Die Beat-Zahl pro Jongleur muss zwischen 1 und 64 liegen.";
            return false;
        }

        if (_setupJugglers.Any(juggler =>
            juggler.HandOrder.Length is < 1 or > 16
            || juggler.HandOrder.Any(hand => hand is not ('R' or 'L'))))
        {
            error = "Die Handreihenfolge darf 1 bis 16 Zeichen enthalten: R und/oder L.";
            return false;
        }

        if (_setupJugglers.Any(juggler => juggler.PhaseOffset is < 0m or > 1m))
        {
            error = "Der Versatz muss zwischen 0 und 1 liegen.";
            return false;
        }

        if (_setupJugglers.Sum(juggler => juggler.BeatCount) > 500)
        {
            error = "Die Jongleur-Zeilen dürfen zusammen höchstens 500 Beats enthalten.";
            return false;
        }

        error = string.Empty;
        return true;
    }

    private bool TryCreateSetupState(out CausalDiagramEditorState? configuredState, out string error)
    {
        configuredState = null;
        var lines = _setupJugglers
            .Select((juggler, index) => CreateSetupJugglerLine(juggler, index))
            .ToList();

        if (!CausalDiagramEditorState.TryCreateFeeding(string.Join('\n', lines), out configuredState, out _)
            || configuredState is null)
        {
            error = "Diese Beat-Kombination erzeugt ein zu langes gemeinsames Wiederholungsmuster. Verringere eine Beat-Zahl.";
            return false;
        }

        for (var index = 0; index < _setupJugglers.Count; index++)
            configuredState.Jugglers[index] = configuredState.Jugglers[index] with
            {
                Name = _setupJugglers[index].Name.Trim(),
            };

        configuredState.PresetId = "custom";
        error = string.Empty;
        return true;
    }

    private string CreateSetupJugglerLine(SetupJugglerSettings setupJuggler, int index)
    {
        var existingThrows = _state.Throws
            .Where(item => item.JugglerId == setupJuggler.Id)
            .OrderBy(item => item.StartTime)
            .ToList();
        var throwTokens = Enumerable
            .Range(0, setupJuggler.BeatCount)
            .Select(beat => CreateSetupThrowToken(existingThrows, beat, index));
        var offset = setupJuggler.PhaseOffset.ToString("0.##", CultureInfo.InvariantCulture);
        return $"J{index + 1}: ({setupJuggler.HandOrder} {offset}) {string.Join(", ", throwTokens)}";
    }

    private string CreateSetupThrowToken(
        IReadOnlyList<EditorThrow> existingThrows,
        int beat,
        int defaultTargetIndex
    )
    {
        if (existingThrows.Count == 0)
            return $"1>J{defaultTargetIndex + 1}";

        var source = existingThrows[beat % existingThrows.Count];
        var height = Math.Clamp((int)Math.Round(_state.HeightOf(source.Id) ?? 1m, MidpointRounding.AwayFromZero), 1, 100);
        var targetIndex = FindTargetJugglerIndex(source, defaultTargetIndex);
        return $"{height}>J{targetIndex + 1}";
    }

    private int FindTargetJugglerIndex(EditorThrow source, int defaultTargetIndex)
    {
        var edge = _state.CausalEdges.FirstOrDefault(item => item.FromThrowId == source.Id);
        if (edge is null)
            return defaultTargetIndex;

        var targetThrow = _state.Throws.FirstOrDefault(item => item.Id == edge.ToThrowId);
        if (targetThrow is null)
            return defaultTargetIndex;

        var targetIndex = _setupJugglers.FindIndex(item => item.Id == targetThrow.JugglerId);
        return targetIndex >= 0 ? targetIndex : defaultTargetIndex;
    }

    private void StateChanged() => PersistState(diagramChanged: false);

    private void PatternChanged() => PersistState(diagramChanged: true);

    private void PersistState(bool diagramChanged)
    {
        if (diagramChanged)
        {
            _preset = "custom";
            _selectedSavedPresetId = null;
            _state.PresetId = _preset;
        }
        _state.Repetitions = Math.Clamp(_state.Repetitions, 1, 20);
        RebuildLayoutMetrics();
        RefreshAnimation();
        var uri = UrlStateNavigation.GetUriWithQueryParameter("state", _state.Encode());
        uri = UrlStateNavigation.WithQueryParameter(
            uri,
            "step",
            _wizardStep.ToString(CultureInfo.InvariantCulture)
        );
        if (_wizardStep == 2)
            uri = UrlStateNavigation.WithQueryParameter(uri, "setup", null);
        UrlStateNavigation.NavigateTo(uri);
    }

    private void RefreshAnimation()
    {
        if (CausalDiagramEditorJifAdapter.TryMap(_state, out var pattern, out var error, OrbitColorsEnabled) && pattern is not null)
        {
            _animationJif = pattern;
            _animationUnavailable = "";
        }
        else
        {
            _animationJif = null;
            _animationUnavailable = error;
        }
    }

    private void SetOrbitColors(bool enabled)
    {
        if (OrbitColorsEnabled == enabled)
            return;

        OrbitColorsEnabled = enabled;
        RefreshAnimation();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("unbindTouchDragTargets", _svg);
            if (ShowHorizontalScrollCue)
                await _module.InvokeVoidAsync("unbindDiagramScrollCue", _svg);
            if (ShowAnimation)
                await _module.InvokeVoidAsync("unbindOrbitRadioKeys", _orbitToggle);
            if (ShowOptions) await _module.InvokeVoidAsync("unbindOutsideClose", _diagramOptions);
            await _module.InvokeVoidAsync("stopDrag");
            await _module.InvokeVoidAsync("stopJugglerHold");
            await _module.DisposeAsync();
        }
        _dotNetRef?.Dispose();
    }
