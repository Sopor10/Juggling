            _editingThrow = null;
            _handMenuThrow = null;
            return;
        }

        Select(id);
    }

    private void HandleThrowClick(string id, int cycle)
    {
        // Touch and long-press selection happens on pointerdown. The synthesized
        // click that follows must not toggle that selection straight back off.
        if (_editingThrow == (id, cycle))
        {
            _selectedId = id;
            return;
        }
        ToggleSelection(id);
    }

