@using System.Globalization
@using System.Reflection
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using Siteswaps.Components.Layout
@using Siteswaps.Components.Wizard
@using Siteswaps.Components.CausalDiagram
@using Siteswaps.Jif.Components.Navigation
@using Siteswaps.Components.Details.Diagrams
@using Siteswaps.Jif.Components
@using Siteswap.Details.Jif
@inject NavigationManager Navigation
@inject UrlStateNavigation UrlStateNavigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="causal-editor @(Embedded ? "embedded" : "sd-page")">
  <WizardShell Enabled="@(!Embedded)" HeaderContent="@(Embedded ? null : WizardHeader)" FooterContent="@(Embedded ? null : WizardFooter)">
    @if (_invalidState)
    {
        <p class="editor-notice" role="status">Der Linkzustand war ungültig oder wird nicht unterstützt. Ein neues Diagramm wurde geladen.</p>
    }
    <div class="wizard-steps causal-wizard-steps">
      <WizardStepPanel StepIndex="0" IsActive="@(!Embedded && _wizardStep == 1)">
        <section class="editor-setup">
          <div class="editor-setup-grid">
            <label class="editor-field editor-setup-preset">Diagrammvorlage
              <select value="@_preset" @onchange="LoadSetupPreset">
                  <option value="custom">Eigenes Diagramm</option>
                  <optgroup label="Asynchron">
                      @foreach (var preset in CausalDiagramEditorPresets.VisibleAsynchronous)
                      {
                          <option value="@preset.Id">@preset.Label</option>
                      }
                  </optgroup>
                  <optgroup label="Synchron">
                      @foreach (var preset in CausalDiagramEditorPresets.VisibleSynchronous)
                      {
                          <option value="@preset.Id">@preset.Label</option>
                      }
                  </optgroup>
              </select>
            </label>
          </div>
          <section class="editor-jugglers" aria-labelledby="editor-jugglers-title">
            <div class="editor-jugglers-heading">
              <h2 id="editor-jugglers-title">Jongleure</h2>
              <button type="button" class="editor-action" @onclick="AddSetupJuggler" disabled="@(_setupJugglers.Count >= 16)">+ Jongleur</button>
            </div>
            <div class="editor-juggler-rows">
              @foreach (var (juggler, index) in _setupJugglers.Select((item, index) => (item, index)))
              {
                var currentJuggler = juggler;
                <div class="editor-juggler-row">
                  <label class="editor-field editor-juggler-name">
                    <span>Jongleur @(index + 1) · Name</span>
                    <input type="text" maxlength="32" value="@juggler.Name" @oninput="e => SetSetupJugglerName(currentJuggler.Id, e.Value?.ToString())" />
                  </label>
                  <label class="editor-field editor-juggler-beats">
                    <span>Beats</span>
                    <input type="number" min="1" max="64" value="@juggler.BeatCount" @onchange="e => SetSetupJugglerBeats(currentJuggler.Id, e.Value?.ToString())" />
                  </label>
                  <label class="editor-field editor-juggler-hands">
                    <span>Handreihenfolge</span>
                    <input type="text" maxlength="16" value="@juggler.HandOrder" aria-label="Handreihenfolge für Jongleur @(index + 1)" @oninput="e => SetSetupJugglerHands(currentJuggler.Id, e.Value?.ToString())" />
                  </label>
                  <label class="editor-field editor-juggler-offset">
                    <span>Versatz</span>
                    <input type="number" min="0" max="1" step="0.01" value="@FormatPhaseOffset(juggler.PhaseOffset)" @onchange="e => SetSetupJugglerOffset(currentJuggler.Id, e.Value?.ToString())" />
                  </label>
                  <button type="button" class="editor-action editor-remove-juggler" aria-label="Jongleur @(index + 1) löschen" title="Jongleur @(index + 1) löschen" @onclick="() => RemoveSetupJuggler(currentJuggler.Id)" disabled="@(_setupJugglers.Count <= 1)">
                    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M4 7h16M10 11v6m4-6v6M5.5 7l1 14h11l1-14M9 7V4h6v3M3 7h18" /></svg>
                  </button>
                </div>
              }
            </div>
          </section>
          @if (_setupValidationError is not null)
          {
            <p class="editor-notice" role="alert">@_setupValidationError</p>
          }
        </section>
      </WizardStepPanel>
      <WizardStepPanel StepIndex="1" IsActive="@(Embedded || _wizardStep == 2)">
      <div class="diagram-shell">
        @if (ShowOptions)
        {
        <details @ref="_diagramOptions" class="diagram-options">
          <summary aria-label="Diagrammoptionen" title="Diagrammoptionen">⋮</summary>
          <div class="diagram-options-content">
            <div class="diagram-options-grid">
              <label class="editor-field">Diagrammvorlage
                <select value="@_preset" @onchange="LoadPreset">
                    <option value="custom">Eigenes Diagramm</option>
                    <optgroup label="Asynchron">
                        @foreach (var preset in CausalDiagramEditorPresets.VisibleAsynchronous)
                        {
                            <option value="@preset.Id">@preset.Label</option>
                        }
                    </optgroup>
                    <optgroup label="Synchron">
                        @foreach (var preset in CausalDiagramEditorPresets.VisibleSynchronous)
                        {
                            <option value="@preset.Id">@preset.Label</option>
                        }
                    </optgroup>
                </select>
              </label>
              <label class="editor-field">Wiederholungen
                <input type="number" min="1" max="20" @bind="_state.Repetitions" @bind:after="StateChanged" />
              </label>
              <label class="snap-control"><input aria-label="Einrasten" type="checkbox" @bind="_state.SnapEnabled" @bind:after="StateChanged" /> Einrasten <small>(@_state.SnapStep.ToString("0.##"))</small></label>
              <label class="editor-field">Breite pro Zyklus
                <input type="range" min="280" max="1120" step="40" @bind="_state.TimelineWidth" @bind:after="StateChanged" />
                <output>@_state.TimelineWidth px je Zyklus · @EventSpacingSummary</output>
              </label>
              <label class="editor-field">Abstand zwischen Jongleuren
                <input type="range" min="80" max="180" step="5" @bind="_state.LaneSpacing" @bind:after="StateChanged" />
                <output>@_state.LaneSpacing px</output>
              </label>
            </div>
            <button type="button" class="editor-action" aria-label="Jongleur hinzufügen" @onclick="AddJuggler" disabled="@(_state.Jugglers.Count >= 16)">+ Jongleur hinzufügen</button>
          </div>
        </details>
        }
      <div class="diagram-scroll pd-wrap">
        @{ var connectionIssueIds = ShowConnectionIssues ? ConnectionIssues().Select(issue => issue.ThrowId).ToHashSet(StringComparer.Ordinal) : new HashSet<string>(StringComparer.Ordinal); }
        <svg @ref="_svg" class="diagram-canvas pd-svg" width="@SvgWidth" style="width: @(SvgWidth)px" viewBox="0 0 @SvgWidth @SvgHeight" role="group" aria-label="Kausales Jonglierdiagramm" @onpointerup="EndDrag" @onpointercancel="EndDrag">
            @foreach (var juggler in _state.Jugglers.Select((item, index) => (item, index)))
            {
                var y = RowY(juggler.index);
                <g class="juggler-add-target @(!AllowJugglerActions ? "read-only" : "")" data-juggler-id="@juggler.item.Id" role="@(AllowJugglerActions ? "button" : null)" tabindex="@(AllowJugglerActions ? 0 : -1)" aria-pressed="@(AllowJugglerActions && _state.ActiveJugglerId == juggler.item.Id)" aria-label="@(AllowJugglerActions ? JugglerActionLabel(juggler.item.Name) : juggler.item.Name)" @onclick="() => SelectJuggler(juggler.item.Id)" @onkeydown="e => HandleJugglerKey(juggler.item.Id, e)" @onkeydown:preventDefault="true" @onpointerdown="e => BeginJugglerHold(juggler.item.Id, e)">
                    <rect class="juggler-add-target-bg" x="8" y="@(y - 54)" width="96" height="40" rx="10" />
                    <SvgText CssClass="pd-juggler-label" X="18" Y="@((y - 28).ToString(CultureInfo.InvariantCulture))">@juggler.item.Name</SvgText>
                </g>
                <line class="timeline" x1="110" x2="@(SvgWidth - 20)" y1="@y" y2="@y" />
            }
            <defs><marker id="causal-arrowhead" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path class="pd-arrow-fill" d="M0,0 L0,6 L9,3 z" /></marker></defs>
            @foreach (var edge in _state.CausalEdges)
            {
                @for (var cycle = 0; cycle < _state.Repetitions; cycle++)
                {
                    var sourceCycle = cycle;
                    var targetCycle = cycle + edge.CycleOffset;
                    var source = _state.Throws.FirstOrDefault(item => item.Id == edge.FromThrowId);
                    var target = _state.Throws.FirstOrDefault(item => item.Id == edge.ToThrowId);
                    if (source is not null && target is not null && targetCycle >= 0 && targetCycle < _state.Repetitions)
                    {
                        var arrowPath = CausalPath(edge, sourceCycle);
                        if (_edgeDragPreview is { } preview && preview.EdgeId == edge.Id && preview.SourceCycle == sourceCycle)
                            arrowPath = CausalPathToPoint(edge, sourceCycle, preview.X, preview.Y);
                        <path class="pd-arrow-stroke causal-arrow" d="@arrowPath" marker-end="url(#causal-arrowhead)" />
                    }
                }
            }
            @for (var cycle = 0; cycle < _state.Repetitions; cycle++)
            {
                var currentCycle = cycle;
                @foreach (var item in _state.Throws)
                {
                    var nodeTime = item.StartTime + cycle * _state.CycleLength;
                    var nodeX = X(nodeTime);
                    var nodeY = RowY(JugglerIndex(item.JugglerId));
                    @if (AllowNodeMove || AllowThrowActions)
                    {
                        <circle class="throw-hit-target @(IsEditingThrow(item.Id, currentCycle) ? "editing" : "")" data-throw-id="@item.Id" data-cycle="@currentCycle" cx="@SvgNumber(nodeX)" cy="@nodeY" r="28" tabindex="0" role="button" aria-label="Wurf @DerivedHeightLabel(item), Hand @item.Hand von @JugglerName(item.JugglerId), Wiederholung @(currentCycle + 1). Kurz drücken zum Auswählen, lange drücken zum Bearbeiten." aria-pressed="@(item.Id == _selectedId)" @onclick="() => ToggleSelection(item.Id)" @onkeydown="e => HandleThrowKey(item.Id, currentCycle, e)" @onkeydown:preventDefault="true" @onpointerdown="e => BeginThrowInteraction(item.Id, currentCycle, e)" />
                    }
                    <g class="throw-node-visual @(IsEditingThrow(item.Id, currentCycle) ? "wiggling" : "")">
                        <circle class="pd-node @(item.Hand == "L" ? "left" : "right") @(item.Id == _selectedId ? "selected" : "") @(connectionIssueIds.Contains(item.Id) ? "connection-error" : "")" data-juggler-id="@item.JugglerId" data-throw-id="@item.Id" cx="@SvgNumber(nodeX)" cy="@nodeY" r="20" pointer-events="none" />
                        <SvgText CssClass="pd-node-label" data-throw-id="@item.Id" X="@nodeX.ToString(CultureInfo.InvariantCulture)" Y="@((nodeY + 5).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle" pointer-events="none">@DerivedHeightLabel(item)</SvgText>
                        <SvgText CssClass="pd-node-hand" X="@nodeX.ToString(CultureInfo.InvariantCulture)" Y="@((nodeY + 34).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle" pointer-events="none">@item.Hand</SvgText>
                    </g>
                }
            }
            @if (AllowArrowEditing)
            {
            @foreach (var edge in _state.CausalEdges)
            {
                @for (var cycle = 0; cycle < _state.Repetitions; cycle++)
                {
                    var sourceCycle = cycle;
                    var targetCycle = cycle + edge.CycleOffset;
                    if (targetCycle >= 0 && targetCycle < _state.Repetitions)
                    {
                        var targetHandle = _edgeDragPreview is { } drag && drag.EdgeId == edge.Id && drag.SourceCycle == sourceCycle
                            ? (X: drag.X, Y: drag.Y)
                            : ArrowTargetPoint(edge, sourceCycle);
                        var isDraggingHandle = _edgeDragPreview is { } activeDrag && activeDrag.EdgeId == edge.Id && activeDrag.SourceCycle == sourceCycle;
                        <circle class="arrow-target-handle @(isDraggingHandle ? "dragging" : "")" data-edge-id="@edge.Id" cx="@SvgNumber(targetHandle.X)" cy="@SvgNumber(targetHandle.Y)" r="22" role="button" tabindex="0" aria-label="Pfeilende ziehen, um den Zielknoten zu ändern" @onpointerdown="e => BeginEdgeDrag(edge.Id, sourceCycle, e)"><title>Pfeilende ziehen, um den Zielknoten zu ändern</title></circle>
                    }
                }
            }
            }
            @for (var cycle = 0; cycle < _state.Repetitions; cycle++)
            {
                var labelCycle = cycle;
                <SvgText CssClass="cycle-label" X="@X(labelCycle * _state.CycleLength).ToString(CultureInfo.InvariantCulture)" Y="@((SvgHeight - 20).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle">@labelCycle</SvgText>
            }
            @if (AllowThrowActions)
            {
            @for (var cycle = 0; cycle < _state.Repetitions; cycle++)
            {
                var currentCycle = cycle;
                @foreach (var item in _state.Throws.Where(item => IsEditingThrow(item.Id, currentCycle)))
                {
                    var nodeX = X(item.StartTime + currentCycle * _state.CycleLength);
                    var nodeY = RowY(JugglerIndex(item.JugglerId));
                    var menuX = nodeX > SvgWidth - 150 ? nodeX - 142 : nodeX + 30;
                    <g class="throw-edit-actions">
                        <g class="throw-delete-action" role="button" tabindex="0" aria-label="Wurf löschen" @onclick="() => DeleteThrow(item.Id)" @onkeydown="e => HandleThrowActionKey(item.Id, e, delete: true)" @onkeydown:preventDefault="true">
                            <circle cx="@(nodeX - 21)" cy="@(nodeY - 21)" r="11" />
                            <SvgText X="@((nodeX - 21).ToString(CultureInfo.InvariantCulture))" Y="@((nodeY - 17).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle">−</SvgText>
                        </g>
                        <g class="throw-menu-action" role="button" tabindex="0" aria-label="Hand-Menü öffnen" aria-expanded="@IsHandMenuOpen(item.Id, currentCycle)" @onclick="() => ToggleHandMenu(item.Id, currentCycle)" @onkeydown="e => HandleThrowActionKey(item.Id, e, delete: false, cycle: currentCycle)" @onkeydown:preventDefault="true">
                            <circle cx="@(nodeX + 21)" cy="@(nodeY - 21)" r="11" />
                            <SvgText X="@((nodeX + 21).ToString(CultureInfo.InvariantCulture))" Y="@((nodeY - 16).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle">⋯</SvgText>
                        </g>
                    </g>
                    @if (IsHandMenuOpen(item.Id, currentCycle))
                    {
                        <g class="throw-hand-menu" role="group" aria-label="Hand wechseln">
                            <rect x="@menuX" y="@(nodeY - 25)" width="132" height="38" rx="10" />
                            <g role="button" tabindex="0" aria-label="Hand wechseln von @(item.Hand == "R" ? "Rechts zu Links" : "Links zu Rechts")" @onclick="() => ToggleThrowHand(item.Id)" @onkeydown="e => HandleHandMenuKey(item.Id, e)" @onkeydown:preventDefault="true">
                                <SvgText X="@((menuX + 66).ToString(CultureInfo.InvariantCulture))" Y="@((nodeY + 1).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle">Hand wechseln: @(item.Hand == "R" ? "R → L" : "L → R")</SvgText>
                            </g>
                        </g>
                    }
                }
            }
            }
        </svg>
      </div>
      </div>
      @if (ShowAnimation)
      {
      <section class="causal-editor-animation sdv-card" aria-label="Passist-Animation">
        <div class="causal-editor-animation-heading">
          <h2>Passist-Animation</h2>
          <div class="causal-animation-orbit-toggle" role="radiogroup" aria-label="Wurffarben">
            <button type="button" role="radio" class="@(OrbitColorsEnabled ? "active" : null)"
                    aria-checked="@OrbitColorsEnabled" @onclick="() => SetOrbitColors(true)">Orbits</button>
            <button type="button" role="radio" class="@(!OrbitColorsEnabled ? "active" : null)"
                    aria-checked="@(!OrbitColorsEnabled)" @onclick="() => SetOrbitColors(false)">Pass / Self</button>
          </div>
        </div>
        @if (_animationJif is not null)
        {
            <PassistAnimation Jif="@(new JifInput.Structured(_animationJif))" AnimationSpeed="0.8" Teaser="true" EnableSettings="false" ShowSpeedLabel="false" ShowLayoutEditor="false" />
        }
        else
        {
            <p class="animation-unavailable" role="status">@_animationUnavailable</p>
        }
      </section>
      }
      </WizardStepPanel>
      </div>
  </WizardShell>
</div>

@code {
    private RenderFragment WizardHeader => @<ProgressDots Total="2" Current="@(_wizardStep - 1)" Visited="_visitedWizardSteps" StepSelected="SelectWizardStep" />;

    private RenderFragment WizardFooter => @<div class="wizard-nav">
        <div class="wizard-measure">
            <div class="wizard-nav-buttons">
                <button type="button" class="wizard-btn-ghost wizard-back-btn @(_wizardStep == 1 ? "wizard-invisible" : "")"
                        disabled="@(_wizardStep == 1)" @onclick="BackToSetup">Zurück</button>
                @if (_wizardStep == 1)
                {
                    <button type="button" class="wizard-flex-1 wizard-btn-primary" @onclick="ContinueToEditor">Weiter zum Diagramm</button>
                }
            </div>
        </div>
    </div>;

    [Parameter]
    public string? StateToken { get; set; }
    [Parameter]
    public string? SetupToken { get; set; }
    [Parameter]
    public int? WizardStep { get; set; }
    [Parameter]
    public CausalDiagramEditorState? ExternalState { get; set; }
    [Parameter]
    public bool Embedded { get; set; }
    [Parameter]
    public bool ShowOptions { get; set; } = true;
    [Parameter]
    public bool ShowAnimation { get; set; } = true;
    [Parameter]
    public bool AllowNodeMove { get; set; } = true;
    [Parameter]
    public bool AllowThrowActions { get; set; } = true;
    [Parameter]
    public bool AllowJugglerActions { get; set; } = true;
    [Parameter]
    public bool AllowArrowEditing { get; set; } = true;
    [Parameter]
    public bool ShowUnconnectedHeight { get; set; }
    [Parameter]
    public bool ShowConnectionIssues { get; set; } = true;

    private CausalDiagramEditorState _state = CausalDiagramEditorState.CreateFeeding75();
    private ElementReference _svg;
    private ElementReference _diagramOptions;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CausalDiagramEditorView>? _dotNetRef;
    private string? _selectedId;
    private (string ThrowId, int Cycle)? _editingThrow;
    private (string ThrowId, int Cycle)? _handMenuThrow;
    private bool _invalidState;
    private bool _wizardInitialized;
    private int? _lastWizardStepParameter;
    private int _wizardStep = 1;
    private readonly HashSet<int> _visitedWizardSteps = [0];
    private List<SetupJugglerSettings> _setupJugglers = [];
    private List<SetupJugglerSettings> _stateSetupJugglers = [];
    private string? _setupValidationError;
    private string _preset = "feeding-7-5";
    private (string EdgeId, int SourceCycle, decimal X, decimal Y)? _edgeDragPreview;
    private JifPattern? _animationJif;
    private bool OrbitColorsEnabled { get; set; } = true;
    private string _animationUnavailable = "Für dieses Diagramm ist keine Passist-Animation verfügbar.";
    private sealed record SetupJugglerSettings(
        string Id,
        string Name,
        int BeatCount,
        string HandOrder,
        decimal PhaseOffset
    );
    private sealed record SetupDraft(string PresetId, SetupJugglerSettings[] Jugglers);
    private static string EditorBuildVersion =>
        typeof(CausalDiagramEditorView)
            .Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()
            ?.InformationalVersion ?? "1.0.0";
    private decimal _timeMax
    {
        get
        {
            return Math.Max(1m, _state.CycleLength * _state.Repetitions);
        }
    }
    private int SvgHeight => Math.Max(180, RowY(_state.Jugglers.Count - 1) + 75);

    protected override void OnParametersSet()
    {
        InitializeWizardState();
        UpdateWizardStepFromParameter();
        LoadStateFromParameters();

        if (!Embedded && _wizardStep == 1 && TryDecodeSetupDraft(SetupToken, out var setupDraft))
        {
            _preset = setupDraft.PresetId;
            _setupJugglers = setupDraft.Jugglers.ToList();
        }

        if (ShowAnimation)
            RefreshAnimation();
    }

    private void InitializeWizardState()
    {
        if (!_wizardInitialized)
        {
            _wizardStep = GetInitialWizardStep();
            var hasState = ExternalState is not null || !string.IsNullOrEmpty(StateToken);
            if (hasState || _wizardStep == 2)
                _visitedWizardSteps.Add(1);
            _lastWizardStepParameter = WizardStep;
            _wizardInitialized = true;
        }
    }

    private int GetInitialWizardStep()
    {
        if (Embedded)
            return 2;
        if (WizardStep is 1 or 2)
            return WizardStep.Value;
        if (!string.IsNullOrEmpty(SetupToken))
            return 1;
        return ExternalState is not null || !string.IsNullOrEmpty(StateToken) ? 2 : 1;
    }

    private void UpdateWizardStepFromParameter()
    {
        if (Embedded || WizardStep is not (1 or 2) || WizardStep == _lastWizardStepParameter)
            return;
        _wizardStep = WizardStep.Value;
        _lastWizardStepParameter = WizardStep;
    }

    private void LoadStateFromParameters()
    {
        if (ExternalState is not null)
        {
            ApplyLoadedState(ExternalState, invalid: false);
            return;
        }

        if (CausalDiagramEditorState.TryDecode(StateToken, out var decoded) && decoded is not null)
        {
            ApplyLoadedState(decoded, invalid: false);
        }
        else
        {
            ApplyLoadedState(CausalDiagramEditorState.CreateFeeding75(), invalid: !string.IsNullOrEmpty(StateToken));
        }
    }

    private void ApplyLoadedState(CausalDiagramEditorState state, bool invalid)
    {
        _state = state;
        _preset = state.PresetId;
        _invalidState = invalid;
        SyncSetupFromState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Embedded)
        {
            if (_wizardStep == 1 && string.IsNullOrEmpty(SetupToken))
                PersistSetupDraft();
            else if (WizardStep is null)
                UrlStateNavigation.SetQueryParameter(
                    "step",
                    _wizardStep.ToString(CultureInfo.InvariantCulture),
                    replace: true
                );
        }

        if (firstRender && (ShowOptions || AllowNodeMove || AllowThrowActions || AllowJugglerActions || AllowArrowEditing))
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                Navigation.ToAbsoluteUri(
                    $"_content/Siteswaps.Components/causalDiagramEditor.js?v={Uri.EscapeDataString(EditorBuildVersion)}"
                ).ToString()
            );
            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("bindTouchDragTargets", _svg);
            if (ShowOptions) await _module.InvokeVoidAsync("bindOutsideClose", _diagramOptions);
        }
    }

    private int JugglerIndex(string id) => _state.Jugglers.FindIndex(j => j.Id == id);
    private string JugglerName(string id) => _state.Jugglers.FirstOrDefault(j => j.Id == id)?.Name ?? id;
    private int RowY(int index) => 70 + (int)(_state.LaneSpacing * index);
    private decimal TimeScale => Math.Clamp(_state.TimelineWidth / Math.Max(1m, _state.CycleLength), 6m, 120m);
    private int SvgWidth => Math.Max(640, (int)Math.Ceiling((double)(X(_timeMax) + 50m)));
    private decimal X(decimal time) => 120m + time * TimeScale;
    private string EventSpacingSummary => string.Join(" · ", _state.Jugglers.Select(juggler =>
    {
        var count = Math.Max(1, _state.Throws.Count(node => node.JugglerId == juggler.Id));
        var spacing = _state.TimelineWidth / count;
        return $"{juggler.Name}: {spacing.ToString("0.#", CultureInfo.InvariantCulture)} px";
    }));
    private string HeightLabel(decimal height) => height.ToString("0.##", CultureInfo.InvariantCulture);
    private string SvgNumber(decimal value) => value.ToString(CultureInfo.InvariantCulture);
    private string DerivedHeightLabel(EditorThrow node) =>
        _state.CausalEdges.Any(edge => edge.FromThrowId == node.Id) || ShowUnconnectedHeight
            ? HeightLabel(node.Height)
            : "—";
    private string NodeLabel(EditorThrow node) => $"{JugglerName(node.JugglerId)} · {DerivedHeightLabel(node)} @ {node.StartTime.ToString("0.##", CultureInfo.InvariantCulture)}";
    private static string JugglerActionLabel(string name) => $"{name}: kurz drücken zum Auswählen, lange drücken zum Hinzufügen eines Wurfs";
    private bool IsEditingThrow(string throwId, int cycle) => _editingThrow == (throwId, cycle);
    private bool IsHandMenuOpen(string throwId, int cycle) => _handMenuThrow == (throwId, cycle);
    private List<ConnectionIssue> ConnectionIssues()
    {
        var issues = new List<ConnectionIssue>();
        foreach (var node in _state.Throws)
        {
            var incoming = _state.CausalEdges.Count(edge => edge.ToThrowId == node.Id);
            var outgoing = _state.CausalEdges.Count(edge => edge.FromThrowId == node.Id);
            var messages = new List<string>();
            AddArrowCountMessage(messages, "eingehend", incoming);
            AddArrowCountMessage(messages, "ausgehend", outgoing);
            if (messages.Count > 0)
                issues.Add(new ConnectionIssue(node.Id, messages));
        }
        return issues;
    }

    private static void AddArrowCountMessage(List<string> messages, string direction, int count)
    {
        if (count == 0)
            messages.Add($"kein {direction}er Pfeil");
        else if (count > 1)
            messages.Add($"{count} {direction}e Pfeile");
    }


