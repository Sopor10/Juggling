@using System.Globalization
@using System.Reflection
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using Siteswaps.Components.Layout
@using Siteswaps.Components.Details
@using Siteswaps.Components.Wizard
@using Siteswaps.Components.CausalDiagram
@using Siteswaps.Jif.Components.Navigation
@using Siteswaps.Components.Details.Diagrams
@using Siteswaps.Jif.Components
@using Siteswap.Details.Jif
@inject NavigationManager Navigation
@inject UrlStateNavigation UrlStateNavigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="causal-editor @(Embedded ? "embedded" : "sd-page")">
  <WizardShell Enabled="@(!Embedded)" HeaderContent="@(Embedded ? null : WizardHeader)" FooterContent="@(Embedded ? null : WizardFooter)">
    @if (_invalidState)
    {
        <p class="editor-notice" role="status">Der Linkzustand war ungültig oder wird nicht unterstützt. Ein neues Diagramm wurde geladen.</p>
    }
    <div class="wizard-steps causal-wizard-steps">
      <WizardStepPanel StepIndex="0" IsActive="@(!Embedded && _wizardStep == 1)">
        <section class="editor-setup">
          <div class="editor-setup-grid">
            <section class="editor-field editor-setup-preset" aria-label="Diagrammvorlage">
              <span>Diagrammvorlage</span>
              <div class="editor-preset-list" role="group" aria-label="Vorlagen auswählen">
                <h3>Asynchron</h3>
                <button type="button" data-preset-id="custom" class="editor-preset-option @(IsPresetSelected("custom") ? "selected" : null)" aria-pressed="@Aria(IsPresetSelected("custom"))" @onclick='() => LoadSetupPreset("custom")'>Eigenes Diagramm</button>
                @foreach (var preset in CausalDiagramEditorPresets.VisibleAsynchronous)
                {
                  <button type="button" data-preset-id="@preset.Id" class="editor-preset-option @(IsPresetSelected(preset.Id) ? "selected" : null)" aria-pressed="@Aria(IsPresetSelected(preset.Id))" @onclick="() => LoadSetupPreset(preset.Id)">@preset.Label</button>
                }
                <h3>Synchron</h3>
                @foreach (var preset in CausalDiagramEditorPresets.VisibleSynchronous)
                {
                  <button type="button" class="editor-preset-option @(IsPresetSelected(preset.Id) ? "selected" : null)" aria-pressed="@Aria(IsPresetSelected(preset.Id))" @onclick="() => LoadSetupPreset(preset.Id)">@preset.Label</button>
                }
                @if (_savedPresets.Count > 0)
                {
                  <h3>Eigene Vorlagen</h3>
                  @foreach (var saved in _savedPresets)
                  {
                    <div class="editor-saved-preset">
                      <button type="button" class="editor-preset-option @(IsPresetSelected(saved.Id) ? "selected" : null)" aria-pressed="@Aria(IsPresetSelected(saved.Id))" @onclick="() => LoadSavedPreset(saved)">@saved.Name</button>
                      <button type="button" class="editor-preset-delete" aria-label="Vorlage @saved.Name löschen" @onclick="() => DeleteSavedPreset(saved.Id)">Löschen</button>
                    </div>
                  }
                }
              </div>
            </section>
          </div>
          <section class="editor-jugglers" aria-labelledby="editor-jugglers-title">
            <div class="editor-jugglers-heading">
              <h2 id="editor-jugglers-title">Jongleure</h2>
              <button type="button" class="editor-action" @onclick="AddSetupJuggler" disabled="@(_setupJugglers.Count >= 16)">+ Jongleur</button>
            </div>
            <div class="editor-juggler-rows">
              @foreach (var (juggler, index) in _setupJugglers.Select((item, index) => (item, index)))
              {
                var currentJuggler = juggler;
                <div class="editor-juggler-row">
                  <label class="editor-field editor-juggler-name">
                    <span>Jongleur @(index + 1) · Name</span>
                    <input type="text" maxlength="32" value="@juggler.Name" @oninput="e => SetSetupJugglerName(currentJuggler.Id, e.Value?.ToString())" />
                  </label>
                  <label class="editor-field editor-juggler-beats">
                    <span>Beats</span>
                    <input type="number" min="1" max="64" value="@juggler.BeatCount" @onchange="e => SetSetupJugglerBeats(currentJuggler.Id, e.Value?.ToString())" />
                  </label>
                  <label class="editor-field editor-juggler-hands">
                    <span>Handreihenfolge</span>
                    <input type="text" maxlength="16" value="@juggler.HandOrder" aria-label="Handreihenfolge für Jongleur @(index + 1)" @oninput="e => SetSetupJugglerHands(currentJuggler.Id, e.Value?.ToString())" />
                  </label>
                  <label class="editor-field editor-juggler-offset">
                    <span>Versatz</span>
                    <input type="number" min="0" max="1" step="0.01" value="@FormatPhaseOffset(juggler.PhaseOffset)" @onchange="e => SetSetupJugglerOffset(currentJuggler.Id, e.Value?.ToString())" />
                  </label>
                  <button type="button" class="editor-action editor-remove-juggler" aria-label="Jongleur @(index + 1) löschen" title="Jongleur @(index + 1) löschen" @onclick="() => RemoveSetupJuggler(currentJuggler.Id)" disabled="@(_setupJugglers.Count <= 1)">
                    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M4 7h16M10 11v6m4-6v6M5.5 7l1 14h11l1-14M9 7V4h6v3M3 7h18" /></svg>
                  </button>
                </div>
              }
            </div>
          </section>
          @if (_setupValidationError is not null)
          {
            <p class="editor-notice" role="alert">@_setupValidationError</p>
          }
        </section>
      </WizardStepPanel>
      <WizardStepPanel StepIndex="1" IsActive="@(Embedded || _wizardStep == 2)">
      <div class="diagram-shell">
        @if (ShowOptions)
        {
        <details @ref="_diagramOptions" class="diagram-options">
          <summary aria-label="Diagrammoptionen" title="Diagrammoptionen">⋮</summary>
          <div class="diagram-options-content">
            <div class="diagram-options-grid">
              <div class="editor-field">Diagrammvorlage
                <div class="editor-preset-list editor-preset-list-compact" role="group" aria-label="Diagrammvorlage auswählen">
                  <button type="button" data-preset-id="custom" class="editor-preset-option @(IsPresetSelected("custom") ? "selected" : null)" aria-pressed="@Aria(IsPresetSelected("custom"))" @onclick='() => LoadPreset("custom")'>Eigenes Diagramm</button>
                  @foreach (var preset in CausalDiagramEditorPresets.VisibleAsynchronous.Concat(CausalDiagramEditorPresets.VisibleSynchronous))
                  {
                  <button type="button" data-preset-id="@preset.Id" class="editor-preset-option @(IsPresetSelected(preset.Id) ? "selected" : null)" aria-pressed="@Aria(IsPresetSelected(preset.Id))" @onclick="() => LoadPreset(preset.Id)">@preset.Label</button>
                  }
                  @foreach (var saved in _savedPresets)
                  {
                    <button type="button" data-preset-id="@saved.Id" class="editor-preset-option @(IsPresetSelected(saved.Id) ? "selected" : null)" aria-pressed="@Aria(IsPresetSelected(saved.Id))" @onclick="() => LoadSavedPreset(saved)">@saved.Name</button>
                  }
                </div>
              </div>
              <label class="editor-field">Wiederholungen
                <input type="number" min="1" max="20" @bind="_state.Repetitions" @bind:after="StateChanged" />
              </label>
              <label class="snap-control"><input aria-label="Einrasten" type="checkbox" @bind="_state.SnapEnabled" @bind:after="StateChanged" /> Einrasten <small>(@_state.SnapStep.ToString("0.##"))</small></label>
              <label class="editor-field">Breite pro Zyklus
                <input type="range" min="280" max="1120" step="40" @bind="_state.TimelineWidth" @bind:after="StateChanged" />
                <output>@EffectiveTimelineWidth px je Zyklus (gewählt: @_state.TimelineWidth px) · @EventSpacingSummary</output>
              </label>
              <label class="editor-field">Abstand zwischen Jongleuren
                <input type="range" min="80" max="180" step="5" @bind="_state.LaneSpacing" @bind:after="StateChanged" />
                <output>@_state.LaneSpacing px</output>
              </label>
            </div>
            <div class="editor-save-preset">
              <label class="editor-field" for="saved-preset-name">Eigene Vorlage speichern</label>
              <div class="editor-save-preset-row">
                <input id="saved-preset-name" maxlength="48" placeholder="Name der Vorlage" @bind="_presetName" />
                <button type="button" class="editor-action" @onclick="SaveCurrentPreset" disabled="@string.IsNullOrWhiteSpace(_presetName)">Speichern</button>
              </div>
              @if (_presetMessage is not null) { <p class="editor-notice" role="status">@_presetMessage</p> }
            </div>
            <button type="button" class="editor-action" aria-label="Jongleur hinzufügen" @onclick="AddJuggler" disabled="@(_state.Jugglers.Count >= 16)">+ Jongleur hinzufügen</button>
          </div>
        </details>
        }
      <div class="diagram-scroll-frame">
      <div class="diagram-scroll pd-wrap">
        @{ var connectionIssueIds = ShowConnectionIssues ? ConnectionIssues().Select(issue => issue.ThrowId).ToHashSet(StringComparer.Ordinal) : new HashSet<string>(StringComparer.Ordinal); }
        <svg @ref="_svg" class="diagram-canvas pd-svg" width="@SvgWidth" style="width: @(SvgWidth)px" viewBox="0 0 @SvgWidth @SvgHeight" role="group" aria-label="Kausales Jonglierdiagramm" @onpointerup="EndDrag" @onpointercancel="EndDrag">
            @foreach (var juggler in _state.Jugglers.Select((item, index) => (item, index)))
            {
                var y = RowY(juggler.index);
                <g class="juggler-add-target @(!AllowJugglerActions ? "read-only" : "")" data-juggler-id="@juggler.item.Id" role="@(AllowJugglerActions ? "button" : null)" tabindex="@(AllowJugglerActions ? 0 : -1)" aria-pressed="@Aria(AllowJugglerActions && _state.ActiveJugglerId == juggler.item.Id)" aria-label="@(AllowJugglerActions ? JugglerActionLabel(juggler.item.Name) : juggler.item.Name)" @onclick="() => SelectJuggler(juggler.item.Id)" @onkeydown="e => HandleJugglerKey(juggler.item.Id, e)" @onpointerdown="e => BeginJugglerHold(juggler.item.Id, e)">
                    <rect class="juggler-add-target-bg" x="8" y="@(y - 22)" width="96" height="44" rx="10" />
                    <SvgText CssClass="pd-juggler-label" X="18" Y="@((y + 5).ToString(CultureInfo.InvariantCulture))">@juggler.item.Name</SvgText>
                </g>
                <line class="timeline" x1="110" x2="@(SvgWidth - 20)" y1="@y" y2="@y" />
            }
            <defs><marker id="causal-arrowhead" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path class="pd-arrow-fill" d="M0,0 L0,6 L9,3 z" /></marker></defs>
            @foreach (var edge in _state.CausalEdges)
            {
                @for (var cycle = 0; cycle < _state.Repetitions; cycle++)
                {
                    var sourceCycle = cycle;
                    var targetCycle = cycle + edge.CycleOffset;
                    var source = _state.Throws.FirstOrDefault(item => item.Id == edge.FromThrowId);
                    var target = _state.Throws.FirstOrDefault(item => item.Id == edge.ToThrowId);
                    if (source is not null && target is not null && targetCycle >= 0 && targetCycle < _state.Repetitions)
                    {
                        var arrowPath = CausalPath(edge, sourceCycle);
                        if (_edgeDragPreview is { } preview && preview.EdgeId == edge.Id && preview.SourceCycle == sourceCycle)
                            arrowPath = CausalPathToPoint(edge, sourceCycle, preview.X, preview.Y);
                        <path class="pd-arrow-stroke causal-arrow" d="@arrowPath" marker-end="url(#causal-arrowhead)" />
                    }
                }
            }
            @foreach (var group in _state.Throws.GroupBy(node => (node.JugglerId, node.StartTime)).Where(group => group.Count() > 1))
            {
                var groupedThrows = group.OrderBy(node => node.Id, StringComparer.Ordinal).ToArray();
                @for (var cycle = 0; cycle < _state.Repetitions; cycle++)
                {
                    var groupCycle = cycle;
                    var firstX = NodeX(groupedThrows[0], groupCycle);
                    var lastX = NodeX(groupedThrows[^1], groupCycle);
                    var groupY = RowY(JugglerIndex(group.Key.JugglerId));
                    <rect class="multiplex-group-outline" x="@SvgNumber(Math.Min(firstX, lastX) - 30)" y="@(groupY - 30)" width="@SvgNumber(Math.Abs(lastX - firstX) + 60)" height="60" rx="24" pointer-events="none" aria-hidden="true" />
                    <SvgText CssClass="multiplex-group-label" X="@(((firstX + lastX) / 2m).ToString(CultureInfo.InvariantCulture))" Y="@((groupY + 54).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle" aria-hidden="true">×@groupedThrows.Length Multiplex</SvgText>
                }
            }
            @for (var cycle = 0; cycle < _state.Repetitions; cycle++)
            {
                var currentCycle = cycle;
                @foreach (var item in _state.Throws)
                {
                    var nodeX = NodeX(item, currentCycle);
                    var nodeY = RowY(JugglerIndex(item.JugglerId));
                    @if (AllowNodeMove || AllowThrowActions)
                    {
                        <circle class="throw-hit-target @(IsEditingThrow(item.Id, currentCycle) ? "editing" : "")" data-throw-id="@item.Id" data-cycle="@currentCycle" cx="@SvgNumber(nodeX)" cy="@nodeY" r="28" tabindex="0" role="button" aria-label="@ThrowAccessibleLabel(item, currentCycle)" aria-pressed="@Aria(item.Id == _selectedId)" @onclick="() => HandleThrowClick(item.Id, currentCycle)" @onkeydown="e => HandleThrowKey(item.Id, currentCycle, e)" @onpointerdown="e => BeginThrowInteraction(item.Id, currentCycle, e)" />
                    }
                    <g class="throw-node-visual @(IsEditingThrow(item.Id, currentCycle) ? "wiggling" : "")">
                        <circle class="pd-node @(item.Hand == "L" ? "left" : "right") @(item.Id == _selectedId ? "selected" : "") @(connectionIssueIds.Contains(item.Id) ? "connection-error" : "")" data-juggler-id="@item.JugglerId" data-throw-id="@item.Id" cx="@SvgNumber(nodeX)" cy="@nodeY" r="20" pointer-events="none" />
                        <SvgText CssClass="pd-node-label" data-throw-id="@item.Id" X="@nodeX.ToString(CultureInfo.InvariantCulture)" Y="@((nodeY + 5).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle" pointer-events="none">@DerivedHeightLabel(item)</SvgText>
                        <SvgText CssClass="pd-node-hand" X="@nodeX.ToString(CultureInfo.InvariantCulture)" Y="@((nodeY + 34).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle" pointer-events="none">@item.Hand</SvgText>
                    </g>
                }
            }
            @if (AllowArrowEditing)
            {
            @foreach (var edge in _state.CausalEdges)
            {
                @for (var cycle = 0; cycle < _state.Repetitions; cycle++)
                {
                    var sourceCycle = cycle;
                    var targetCycle = cycle + edge.CycleOffset;
                    if (targetCycle >= 0 && targetCycle < _state.Repetitions)
                    {
                        var targetHandle = _edgeDragPreview is { } drag && drag.EdgeId == edge.Id && drag.SourceCycle == sourceCycle
                            ? (X: drag.X, Y: drag.Y)
                            : ArrowTargetPoint(edge, sourceCycle);
                        var isDraggingHandle = _edgeDragPreview is { } activeDrag && activeDrag.EdgeId == edge.Id && activeDrag.SourceCycle == sourceCycle;
                        <circle class="arrow-target-handle @(isDraggingHandle ? "dragging" : "")" data-edge-id="@edge.Id" data-target-throw-id="@edge.ToThrowId" data-cycle="@sourceCycle" cx="@SvgNumber(targetHandle.X)" cy="@SvgNumber(targetHandle.Y)" r="22" role="button" tabindex="0" aria-label="@ArrowTargetAccessibleLabel(edge, sourceCycle)" @onpointerdown="e => BeginEdgeDrag(edge.Id, sourceCycle, e)" @onkeydown="e => HandleArrowTargetKey(edge.Id, sourceCycle, e)"><title>Zielknoten mit Enter, Leertaste oder Pfeil links/rechts wechseln</title></circle>
                    }
                }
            }
            }
            @for (var cycle = 0; cycle < _state.Repetitions; cycle++)
            {
                var labelCycle = cycle;
                <SvgText CssClass="cycle-label" X="@X(labelCycle * _state.CycleLength).ToString(CultureInfo.InvariantCulture)" Y="@((SvgHeight - 20).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle">@labelCycle</SvgText>
            }
            @if (AllowThrowActions)
            {
            @for (var cycle = 0; cycle < _state.Repetitions; cycle++)
            {
                var currentCycle = cycle;
                @foreach (var item in _state.Throws.Where(item => IsEditingThrow(item.Id, currentCycle)))
                {
                    var nodeX = NodeX(item, currentCycle);
                    var nodeY = RowY(JugglerIndex(item.JugglerId));
                    var menuX = nodeX > SvgWidth - 150 ? nodeX - 142 : nodeX + 30;
                    <g class="throw-edit-actions">
                        <g class="throw-delete-action" role="button" tabindex="0" aria-label="@DeleteThrowAccessibleLabel(item)" @onclick="() => DeleteThrow(item.Id)" @onkeydown="e => HandleThrowActionKey(item.Id, e, delete: true)">
                            <circle class="throw-action-hit-target" cx="@SvgNumber(nodeX - 30)" cy="@(nodeY - 32)" r="22" />
                            <circle class="throw-action-icon" cx="@SvgNumber(nodeX - 30)" cy="@(nodeY - 32)" r="12" />
                            <SvgText X="@((nodeX - 30).ToString(CultureInfo.InvariantCulture))" Y="@((nodeY - 27).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle">−</SvgText>
                        </g>
                        <g class="throw-menu-action" role="button" tabindex="0" aria-label="Hand-Menü öffnen" aria-expanded="@Aria(IsHandMenuOpen(item.Id, currentCycle))" @onclick="() => ToggleHandMenu(item.Id, currentCycle)" @onkeydown="e => HandleThrowActionKey(item.Id, e, delete: false, cycle: currentCycle)">
                            <circle class="throw-action-hit-target" cx="@SvgNumber(nodeX + 30)" cy="@(nodeY - 32)" r="22" />
                            <circle class="throw-action-icon" cx="@SvgNumber(nodeX + 30)" cy="@(nodeY - 32)" r="12" />
                            <SvgText X="@((nodeX + 30).ToString(CultureInfo.InvariantCulture))" Y="@((nodeY - 27).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle">⋯</SvgText>
                        </g>
                    </g>
                    @if (IsHandMenuOpen(item.Id, currentCycle))
                    {
                        <g class="throw-hand-menu" role="group" aria-label="Hand wechseln">
                            <g role="button" tabindex="0" aria-label="Hand wechseln von @(item.Hand == "R" ? "Rechts zu Links" : "Links zu Rechts")" @onclick="() => ToggleThrowHand(item.Id)" @onkeydown="e => HandleHandMenuKey(item.Id, e)">
                                <rect x="@SvgNumber(menuX)" y="@(nodeY - 28)" width="144" height="44" rx="10" />
                                <SvgText X="@((menuX + 72).ToString(CultureInfo.InvariantCulture))" Y="@((nodeY + 1).ToString(CultureInfo.InvariantCulture))" TextAnchor="middle">Hand wechseln: @(item.Hand == "R" ? "R → L" : "L → R")</SvgText>
                            </g>
                        </g>
                    }
                }
            }
            }
        </svg>
      </div>
      <span class="diagram-scroll-cue" aria-hidden="true">↔</span>
      </div>
      </div>
      @if (AllowThrowActions)
      {
        <section class="causal-editor-throw-actions" aria-label="Würfe bearbeiten">
          <button type="button" class="editor-action" data-testid="add-multiplex-throw" disabled="@(!CanAddMultiplexThrow)" @onclick="AddMultiplexThrow">
            + Kausalen Wurfverlauf verdoppeln
          </button>
          @if (_selectedId is not null)
          {
            <span role="status" aria-live="polite">Ausgewählt: @SelectedThrowDescription</span>
          }
        </section>
      }
      <section class="causal-editor-table-section" aria-label="Tabellarische Wurfübersicht">
        <button type="button" class="editor-action causal-editor-table-toggle" aria-expanded="@Aria(_showTable)"
                @onclick="() => _showTable = !_showTable">
          @(_showTable ? "Tabelle ausblenden" : "Tabelle einblenden")
        </button>
        @if (_showTable)
        {
          <div class="causal-editor-table-scroll" tabindex="0" aria-label="Zeitleiste horizontal scrollen">
            <table class="causal-editor-pattern-table">
              <thead><tr><th scope="col">Jongleur</th>@foreach (var time in EditorTable.Times) { <th scope="col">@time.ToString("0.##", CultureInfo.InvariantCulture)</th> }</tr></thead>
              <tbody>
                @foreach (var row in EditorTable.Rows)
                {
                  <tr>
                    <th scope="row">@row.Juggler</th>
                    @foreach (var (chips, timeIndex) in row.Cells.Select((cell, index) => (cell, index)))
                    {
                      <td>
                        @if (chips is not null)
                        {
                          <ThrowChipRow Chips="chips" ColorOrbits="false" ShowPassDestinations="true" ShowHands="true" AriaLabel="@($"{chips.Count} Wurf(e) {row.Juggler} bei {EditorTable.Times[timeIndex]:0.##}")" />
                        }
                      </td>
                    }
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
      </section>
      @if (ShowAnimation)
      {
      <section class="causal-editor-animation sdv-card" aria-label="Passist-Animation">
        <div class="causal-editor-animation-heading">
          <h2>Passist-Animation</h2>
          <div @ref="_orbitToggle" class="causal-animation-orbit-toggle" role="radiogroup" aria-label="Wurffarben">
            <button type="button" role="radio" class="@(OrbitColorsEnabled ? "active" : null)"
                    aria-checked="@Aria(OrbitColorsEnabled)" tabindex="@(OrbitColorsEnabled ? 0 : -1)" @onclick="() => SetOrbitColors(true)">Orbits</button>
            <button type="button" role="radio" class="@(!OrbitColorsEnabled ? "active" : null)"
                    aria-checked="@Aria(!OrbitColorsEnabled)" tabindex="@(!OrbitColorsEnabled ? 0 : -1)" @onclick="() => SetOrbitColors(false)">Pass / Self</button>
          </div>
        </div>
        @if (_animationJif is not null)
        {
            <PassistAnimation Jif="@(new JifInput.Structured(_animationJif))" AnimationSpeed="0.8" Teaser="true" EnableSettings="false" ShowSpeedLabel="false" />
        }
        else
        {
            <p class="animation-unavailable" role="status">@_animationUnavailable</p>
        }
      </section>
      }
      </WizardStepPanel>
      </div>
  </WizardShell>
</div>

@code {
    private RenderFragment WizardHeader => @<ProgressDots Total="2" Current="@(_wizardStep - 1)" Visited="_visitedWizardSteps" StepSelected="SelectWizardStep" />;

    private RenderFragment WizardFooter => @<div class="wizard-nav">
        <div class="wizard-measure">
            <div class="wizard-nav-buttons">
                <button type="button" class="wizard-btn-ghost wizard-back-btn @(_wizardStep == 1 ? "wizard-invisible" : "")"
                        disabled="@(_wizardStep == 1)" @onclick="BackToSetup">Zurück</button>
                @if (_wizardStep == 1)
                {
                    <button type="button" class="wizard-flex-1 wizard-btn-primary" @onclick="ContinueToEditor">Weiter zum Diagramm</button>
                }
            </div>
        </div>
    </div>;

    [Parameter]
    public string? StateToken { get; set; }
    [Parameter]
    public string? SetupToken { get; set; }
    [Parameter]
    public int? WizardStep { get; set; }
    [Parameter]
    public CausalDiagramEditorState? ExternalState { get; set; }
    [Parameter]
    public bool Embedded { get; set; }
    [Parameter]
    public bool ShowOptions { get; set; } = true;
    [Parameter]
    public bool ShowAnimation { get; set; } = true;
    [Parameter]
    public bool AllowNodeMove { get; set; } = true;
    [Parameter]
    public bool AllowThrowActions { get; set; } = true;
    [Parameter]
    public bool AllowJugglerActions { get; set; } = true;
    [Parameter]
    public bool AllowArrowEditing { get; set; } = true;
    [Parameter]
    public bool ShowUnconnectedHeight { get; set; }
    [Parameter]
    public bool ShowConnectionIssues { get; set; } = true;
    [Parameter]
    public bool ShowHorizontalScrollCue { get; set; } = true;

    private CausalDiagramEditorState _state = CausalDiagramEditorPresets.All.First(preset => preset.Id == "jugglers-2").Create();
    private decimal _effectiveTimeScale = 6m;
    private decimal _nodeSpread;
    private readonly Dictionary<string, (int Index, int Count)> _throwGroupPositions = new(StringComparer.Ordinal);
    private ElementReference _svg;
    private ElementReference _diagramOptions;
    private ElementReference _orbitToggle;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CausalDiagramEditorView>? _dotNetRef;
    private string? _selectedId;
    private (string ThrowId, int Cycle)? _editingThrow;
    private (string ThrowId, int Cycle)? _handMenuThrow;
    private bool _invalidState;
    private bool _wizardInitialized;
    private int? _lastWizardStepParameter;
