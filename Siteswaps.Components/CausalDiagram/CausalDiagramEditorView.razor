    private void AddThrow(string jugglerId)
    {
        if (_state.Throws.Count >= 500) return;
        var juggler = _state.Jugglers.FirstOrDefault(j => j.Id == jugglerId);
        if (juggler is null) return;
        _state.ActiveJugglerId = jugglerId;
        var last = _state.Throws.LastOrDefault(t => t.JugglerId == juggler.Id);
        var start = last is null ? 0m : Math.Min(_state.CycleLength - 0.25m, last.StartTime + 1m);
        var hand = last?.Hand == "R" ? "L" : "R";
        var item = new EditorThrow(Guid.NewGuid().ToString("N"), juggler.Id, hand, Math.Max(0m, start), 1m);
        _state.Throws.Add(item);
        _selectedId = item.Id;
        PatternChanged();
    }

    private void AddJuggler()
    {
        if (_state.Jugglers.Count >= 16) return;
        var index = _state.Jugglers.Count;
        var id = $"J{index + 1}";
        while (_state.Jugglers.Any(j => j.Id == id)) id = $"J-{Guid.NewGuid():N}";
        _state.Jugglers.Add(new EditorJuggler(id, $"Jongleur {index + 1}"));
        var throwId = $"{id}-1";
        _state.Throws.Add(new EditorThrow(throwId, id, "R", 0m, 1m));
        _state.CausalEdges.Add(new EditorCausalEdge($"e-{throwId}", throwId, throwId, -1));
        _state.ActiveJugglerId = id;
        _state.SynchronizeHeights();
        PatternChanged();
    }

    private void DeleteThrow(string id)
    {
        var item = _state.Throws.FirstOrDefault(throwNode => throwNode.Id == id);
        if (item is null) return;
        _state.Throws.Remove(item);
        _state.CausalEdges.RemoveAll(edge => edge.FromThrowId == item.Id || edge.ToThrowId == item.Id);
        _selectedId = null;
        _editingThrow = null;
        _handMenuThrow = null;
        PatternChanged();
    }

