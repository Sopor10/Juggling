    {
        get
        {
            var selected = _state.Throws.FirstOrDefault(item => item.Id == _selectedId);
            if (selected is null)
                return "";

            var connection = _state.CausalEdges.Any(edge => edge.FromThrowId == selected.Id)
                ? "verbunden"
                : "ohne Pfeil";
