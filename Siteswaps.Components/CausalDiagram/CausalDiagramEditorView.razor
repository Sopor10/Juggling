    private void BackToSetup()
    {
        SyncSetupFromState();
        _wizardStep = 1;
        PersistSetupDraft();
    }

    private void SelectWizardStep(int step)
    {
        if (step == 0)
            BackToSetup();
        else if (step == 1 && _visitedWizardSteps.Contains(step))
            ContinueToEditor();
    }

    private void ContinueToEditor()
    {
        if (!ValidateSetupJugglers(out var validationError))
        {
            _setupValidationError = validationError;
            return;
        }

        if (!ApplySetupChanges(out validationError))
        {
            _setupValidationError = validationError;
            return;
        }

        _setupValidationError = null;
        CompleteEditorTransition();
    }

    private bool ApplySetupChanges(out string error)
    {
        if (SetupSettingsChanged())
            return ApplyChangedJugglerSettings(out error);

        ApplyJugglerNames();
        error = string.Empty;
        return true;
    }

    private bool SetupSettingsChanged() => _setupJugglers.Count != _stateSetupJugglers.Count
        || _setupJugglers.Zip(_stateSetupJugglers).Any(pair =>
            pair.First.Id != pair.Second.Id
            || pair.First.BeatCount != pair.Second.BeatCount
            || pair.First.HandOrder != pair.Second.HandOrder
            || pair.First.PhaseOffset != pair.Second.PhaseOffset);

    private bool ApplyChangedJugglerSettings(out string error)
    {
        if (!TryCreateSetupState(out var configuredState, out error) || configuredState is null)
            return false;

        configuredState.Repetitions = _state.Repetitions;
        configuredState.SnapEnabled = _state.SnapEnabled;
        configuredState.TimelineWidth = _state.TimelineWidth;
        configuredState.LaneSpacing = _state.LaneSpacing;
        configuredState.SnapStep = _state.SnapStep;
        configuredState.PresetId = "custom";
        _state = configuredState;
        _preset = "custom";
        return true;
    }

    private void ApplyJugglerNames()
    {
        var namesChanged = _setupJugglers.Count != _stateSetupJugglers.Count
            || _setupJugglers.Zip(_stateSetupJugglers).Any(pair =>
                pair.First.Id != pair.Second.Id || pair.First.Name != pair.Second.Name);
        foreach (var setupJuggler in _setupJugglers)
        {
            var index = _state.Jugglers.FindIndex(juggler => juggler.Id == setupJuggler.Id);
            if (index >= 0)
                _state.Jugglers[index] = _state.Jugglers[index] with { Name = setupJuggler.Name.Trim() };
        }

        if (namesChanged)
        {
            _preset = "custom";
            _state.PresetId = "custom";
        }
    }

    private void CompleteEditorTransition()
    {
        if (!_state.Jugglers.Any(item => item.Id == _state.ActiveJugglerId))
            _state.ActiveJugglerId = _state.Jugglers[0].Id;
        _state.SynchronizeHeights();
        _selectedId = null;
        _visitedWizardSteps.Add(1);
        _wizardStep = 2;
        StateChanged();
    }

    private bool ValidateSetupJugglers(out string error)
    {
        if (_setupJugglers.Count is < 1 or > 16)
        {
            error = "Das Diagramm benötigt zwischen 1 und 16 Jongleure.";
            return false;
        }

        if (_setupJugglers.Any(juggler =>
            string.IsNullOrWhiteSpace(juggler.Name)
            || juggler.Name.Trim().Length > 32
            || juggler.Name.Any(char.IsControl)))
        {
            error = "Gib für jeden Jongleur einen Namen mit höchstens 32 Zeichen ein.";
            return false;
        }

        if (_setupJugglers.Select(juggler => juggler.Name.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).Count() != _setupJugglers.Count)
        {
            error = "Die Namen der Jongleure müssen eindeutig sein.";
            return false;
        }

        if (_setupJugglers.Any(juggler => juggler.BeatCount is < 1 or > 64))
        {
            error = "Die Beat-Zahl pro Jongleur muss zwischen 1 und 64 liegen.";
            return false;
        }

        if (_setupJugglers.Any(juggler =>
            juggler.HandOrder.Length is < 1 or > 16
            || juggler.HandOrder.Any(hand => hand is not ('R' or 'L'))))
        {
            error = "Die Handreihenfolge darf 1 bis 16 Zeichen enthalten: R und/oder L.";
            return false;
        }

        if (_setupJugglers.Any(juggler => juggler.PhaseOffset is < 0m or > 1m))
        {
            error = "Der Versatz muss zwischen 0 und 1 liegen.";
            return false;
        }

        if (_setupJugglers.Sum(juggler => juggler.BeatCount) > 500)
        {
            error = "Die Jongleur-Zeilen dürfen zusammen höchstens 500 Beats enthalten.";
            return false;
        }

        error = string.Empty;
        return true;
    }

    private bool TryCreateSetupState(out CausalDiagramEditorState? configuredState, out string error)
    {
        configuredState = null;
        var lines = _setupJugglers
            .Select((juggler, index) => CreateSetupJugglerLine(juggler, index))
            .ToList();

        if (!CausalDiagramEditorState.TryCreateFeeding(string.Join('\n', lines), out configuredState, out _)
            || configuredState is null)
        {
            error = "Diese Beat-Kombination erzeugt ein zu langes gemeinsames Wiederholungsmuster. Verringere eine Beat-Zahl.";
            return false;
        }

        for (var index = 0; index < _setupJugglers.Count; index++)
            configuredState.Jugglers[index] = configuredState.Jugglers[index] with
            {
                Name = _setupJugglers[index].Name.Trim(),
            };

        configuredState.PresetId = "custom";
        error = string.Empty;
        return true;
    }

    private string CreateSetupJugglerLine(SetupJugglerSettings setupJuggler, int index)
    {
        var existingThrows = _state.Throws
            .Where(item => item.JugglerId == setupJuggler.Id)
            .OrderBy(item => item.StartTime)
            .ToList();
        var throwTokens = Enumerable
            .Range(0, setupJuggler.BeatCount)
            .Select(beat => CreateSetupThrowToken(existingThrows, beat, index));
        var offset = setupJuggler.PhaseOffset.ToString("0.##", CultureInfo.InvariantCulture);
        return $"J{index + 1}: ({setupJuggler.HandOrder} {offset}) {string.Join(", ", throwTokens)}";
    }

    private string CreateSetupThrowToken(
        IReadOnlyList<EditorThrow> existingThrows,
        int beat,
        int defaultTargetIndex
    )
    {
        if (existingThrows.Count == 0)
            return $"1>J{defaultTargetIndex + 1}";

        var source = existingThrows[beat % existingThrows.Count];
        var height = Math.Clamp((int)Math.Round(source.Height, MidpointRounding.AwayFromZero), 1, 100);
        var targetIndex = FindTargetJugglerIndex(source, defaultTargetIndex);
        return $"{height}>J{targetIndex + 1}";
    }

    private int FindTargetJugglerIndex(EditorThrow source, int defaultTargetIndex)
    {
        var edge = _state.CausalEdges.FirstOrDefault(item => item.FromThrowId == source.Id);
        if (edge is null)
            return defaultTargetIndex;

        var targetThrow = _state.Throws.FirstOrDefault(item => item.Id == edge.ToThrowId);
        if (targetThrow is null)
            return defaultTargetIndex;

        var targetIndex = _setupJugglers.FindIndex(item => item.Id == targetThrow.JugglerId);
        return targetIndex >= 0 ? targetIndex : defaultTargetIndex;
    }

    private void StateChanged() => PersistState(diagramChanged: false);

    private void PatternChanged() => PersistState(diagramChanged: true);

    private void PersistState(bool diagramChanged)
    {
        if (diagramChanged)
        {
            _preset = "custom";
            _state.PresetId = _preset;
        }
        _state.Repetitions = Math.Clamp(_state.Repetitions, 1, 20);
        RefreshAnimation();
        var uri = UrlStateNavigation.GetUriWithQueryParameter("state", _state.Encode());
        uri = UrlStateNavigation.WithQueryParameter(
            uri,
            "step",
            _wizardStep.ToString(CultureInfo.InvariantCulture)
        );
        if (_wizardStep == 2)
            uri = UrlStateNavigation.WithQueryParameter(uri, "setup", null);
        UrlStateNavigation.NavigateTo(uri);
    }

    private void RefreshAnimation()
    {
        if (CausalDiagramEditorJifAdapter.TryMap(_state, out var pattern, out var error, OrbitColorsEnabled) && pattern is not null)
        {
            _animationJif = pattern;
            _animationUnavailable = "";
        }
        else
        {
            _animationJif = null;
            _animationUnavailable = error;
        }
    }

    private void SetOrbitColors(bool enabled)
    {
        if (OrbitColorsEnabled == enabled)
            return;

        OrbitColorsEnabled = enabled;
        RefreshAnimation();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("unbindTouchDragTargets", _svg);
            if (ShowOptions) await _module.InvokeVoidAsync("unbindOutsideClose", _diagramOptions);
            await _module.InvokeVoidAsync("stopDrag");
            await _module.InvokeVoidAsync("stopJugglerHold");
            await _module.DisposeAsync();
        }
        _dotNetRef?.Dispose();
    }
}
