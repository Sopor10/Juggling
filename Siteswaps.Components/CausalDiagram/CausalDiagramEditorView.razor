    protected override void OnParametersSet()
    {
        InitializeWizardState();
        UpdateWizardStepFromParameter();
        LoadStateFromParameters();

        if (!Embedded && _wizardStep == 1 && TryDecodeSetupDraft(SetupToken, out var setupDraft))
        {
            _preset = setupDraft.PresetId;
            _setupJugglers = setupDraft.Jugglers.ToList();
        }

        if (ShowAnimation)
            RefreshAnimation();
    }

    private void InitializeWizardState()
    {
        if (!_wizardInitialized)
        {
            _wizardStep = GetInitialWizardStep();
            var hasState = ExternalState is not null || !string.IsNullOrEmpty(StateToken);
            if (hasState || _wizardStep == 2)
                _visitedWizardSteps.Add(1);
            _lastWizardStepParameter = WizardStep;
            _wizardInitialized = true;
        }
    }

    private int GetInitialWizardStep()
    {
        if (Embedded)
            return 2;
        if (WizardStep is 1 or 2)
            return WizardStep.Value;
        if (!string.IsNullOrEmpty(SetupToken))
            return 1;
        return ExternalState is not null || !string.IsNullOrEmpty(StateToken) ? 2 : 1;
    }

    private void UpdateWizardStepFromParameter()
    {
        if (Embedded || WizardStep is not (1 or 2) || WizardStep == _lastWizardStepParameter)
            return;
        _wizardStep = WizardStep.Value;
        _lastWizardStepParameter = WizardStep;
    }

    private void LoadStateFromParameters()
    {
        if (ExternalState is not null)
        {
            ApplyLoadedState(ExternalState, invalid: false);
            return;
        }

        if (CausalDiagramEditorState.TryDecode(StateToken, out var decoded) && decoded is not null)
        {
            ApplyLoadedState(decoded, invalid: false);
        }
        else
        {
            ApplyLoadedState(CausalDiagramEditorPresets.All.First(preset => preset.Id == "jugglers-2").Create(), invalid: !string.IsNullOrEmpty(StateToken));
        }
    }

    private void ApplyLoadedState(CausalDiagramEditorState state, bool invalid)
    {
        _state = state;
        RebuildLayoutMetrics();
        _preset = state.PresetId;
        _invalidState = invalid;
        SyncSetupFromState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        if (!Embedded)
            InitializeWizardLocation();
        if (ShouldLoadEditorModule)
            await InitializeEditorModuleAsync();
    }

    private bool ShouldLoadEditorModule => ShowOptions
        || AllowNodeMove
        || AllowThrowActions
        || AllowJugglerActions
        || AllowArrowEditing
        || ShowHorizontalScrollCue;

    private void InitializeWizardLocation()
    {
        if (_wizardStep == 1 && string.IsNullOrEmpty(SetupToken))
            PersistSetupDraft();
        else if (WizardStep is null)
            UrlStateNavigation.SetQueryParameter(
                "step",
                _wizardStep.ToString(CultureInfo.InvariantCulture),
                replace: true
            );
    }

    private async Task InitializeEditorModuleAsync()
    {
        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import",
            Navigation.ToAbsoluteUri(
                $"_content/Siteswaps.Components/causalDiagramEditor.js?v={Uri.EscapeDataString(EditorBuildVersion)}"
            ).ToString()
        );
        _dotNetRef = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("bindTouchDragTargets", _svg);
        if (ShowHorizontalScrollCue)
            await _module.InvokeVoidAsync("bindDiagramScrollCue", _svg);
        if (ShowAnimation)
            await _module.InvokeVoidAsync("bindOrbitRadioKeys", _orbitToggle);
        if (ShowOptions)
            await _module.InvokeVoidAsync("bindOutsideClose", _diagramOptions);
        if (!Embedded)
        {
            _savedPresets = (await _module.InvokeAsync<SavedEditorPreset[]>("getSavedEditorPresets"))?.ToList() ?? [];
            await InvokeAsync(StateHasChanged);
        }
    }

    private int JugglerIndex(string id) => _state.Jugglers.FindIndex(j => j.Id == id);
    private string JugglerName(string id) => _state.Jugglers.FirstOrDefault(j => j.Id == id)?.Name ?? id;
    private int RowY(int index) => 70 + (int)(_state.LaneSpacing * index);
    private decimal TimeScale => _effectiveTimeScale;
    private decimal EffectiveTimelineWidth => TimeScale * Math.Max(1m, _state.CycleLength);
    private decimal NodeSpread => _nodeSpread;

    private void RebuildLayoutMetrics()
    {
        _throwGroupPositions.Clear();
        var rows = new Dictionary<string, List<(decimal Time, decimal HalfWidth)>>(StringComparer.Ordinal);
        foreach (var group in _state.Throws.GroupBy(node => (node.JugglerId, node.StartTime)))
        {
            var nodes = group.OrderBy(node => node.Id, StringComparer.Ordinal).ToArray();
            for (var index = 0; index < nodes.Length; index++)
                _throwGroupPositions[nodes[index].Id] = (index, nodes.Length);

            if (!rows.TryGetValue(group.Key.JugglerId, out var row))
                rows[group.Key.JugglerId] = row = [];
            row.Add((group.Key.StartTime, (nodes.Length - 1) * 30m));
        }

        _nodeSpread = _throwGroupPositions.Values
            .Select(group => (group.Count - 1) * 30m)
            .DefaultIfEmpty(0m)
            .Max();
        var touchSafeScale = rows.Values
            .SelectMany(rowGroups =>
            {
                var ordered = rowGroups.OrderBy(group => group.Time).ToArray();
                return Enumerable.Range(0, ordered.Length).Select(index =>
                {
                    var current = ordered[index];
                    var next = ordered[(index + 1) % ordered.Length];
                    var gap = index + 1 < ordered.Length
                        ? next.Time - current.Time
                        : next.Time + _state.CycleLength - current.Time;
                    return gap <= 0 ? 6m : (56m + current.HalfWidth + next.HalfWidth) / gap;
                });
            })
            .DefaultIfEmpty(6m)
            .Max();
        _effectiveTimeScale = Math.Max(
            Math.Clamp(_state.TimelineWidth / Math.Max(1m, _state.CycleLength), 6m, 120m),
            touchSafeScale
        );
    }
    private int SvgWidth => Math.Max(640, (int)Math.Ceiling((double)(X(_timeMax) + NodeSpread + 50m)));
    private decimal X(decimal time) => 120m + time * TimeScale;
    private decimal NodeX(EditorThrow node, int cycle)
    {
        var group = _throwGroupPositions.GetValueOrDefault(node.Id);
        return X(node.StartTime + cycle * _state.CycleLength) + (group.Index - (group.Count - 1) / 2m) * 60m;
    }
    private int MultiplexCount(EditorThrow node) => _throwGroupPositions.GetValueOrDefault(node.Id).Count;
    private string EventSpacingSummary => string.Join(" · ", _state.Jugglers.Select(juggler =>
    {
        var groups = _state.Throws
            .Where(node => node.JugglerId == juggler.Id)
            .GroupBy(node => node.StartTime)
            .Select(group => (Time: group.Key, Count: group.Count(), HalfWidth: (group.Count() - 1) * 30m))
            .OrderBy(group => group.Time)
            .ToArray();
        if (groups.Length == 0)
            return $"{juggler.Name}: —";

        var groupSpacings = Enumerable.Range(0, groups.Length).Select(index =>
        {
            var current = groups[index];
            var next = groups[(index + 1) % groups.Length];
            var gap = index + 1 < groups.Length
                ? next.Time - current.Time
                : next.Time + _state.CycleLength - current.Time;
            return gap * TimeScale - current.HalfWidth - next.HalfWidth;
        });
        IEnumerable<decimal> withinMultiplexSpacing = groups.Any(group => group.Count > 1) ? [60m] : [];
        var minimumSpacing = groupSpacings.Concat(withinMultiplexSpacing).Min();
        return $"{juggler.Name}: min. Abstand zwischen Wurfknoten {minimumSpacing.ToString("0.#", CultureInfo.InvariantCulture)} px";
    }));
    private string HeightLabel(decimal height) => height.ToString("0.##", CultureInfo.InvariantCulture);
    private string SvgNumber(decimal value) => value.ToString(CultureInfo.InvariantCulture);
    private string DerivedHeightLabel(EditorThrow node) =>
        _state.HeightOf(node.Id) is { } height ? HeightLabel(height) : "—";
    private string NodeLabel(EditorThrow node) => $"{JugglerName(node.JugglerId)} · {DerivedHeightLabel(node)} @ {node.StartTime.ToString("0.##", CultureInfo.InvariantCulture)}";
    private string ThrowAccessibleLabel(EditorThrow node, int cycle)
    {
        var group = _throwGroupPositions.GetValueOrDefault(node.Id);
        var index = group.Index + 1;
        var multiplex = group.Count > 1 ? $"Multiplex, Wurf {index} von {group.Count}. " : "";
        return $"{multiplex}Wurf {DerivedHeightLabel(node)}, Hand {node.Hand} von {JugglerName(node.JugglerId)}, Wiederholung {cycle + 1}. Enter oder Leertaste wählt aus; Touch: antippen zum Bearbeiten; Maus: lange drücken zum Bearbeiten. Pfeiltasten verschieben den Wurf.";
    }
    private string ArrowTargetAccessibleLabel(EditorCausalEdge edge, int sourceCycle)
    {
        var target = _state.Throws.FirstOrDefault(node => node.Id == edge.ToThrowId);
        if (target is null)
            return $"Pfeilziel in Wiederholung {sourceCycle + 1}: unbekannter Wurf. Ziehen, Enter oder Leertaste zum nächsten Ziel, Pfeil links zurück und Pfeil rechts vor.";

        var group = _throwGroupPositions.GetValueOrDefault(target.Id);
        var index = group.Index + 1;
        var multiplexLabel = group.Count > 1 ? $"Multiplex-Wurf {index} von {group.Count}, " : "";
        return $"Pfeilziel in Wiederholung {sourceCycle + 1}: {multiplexLabel}{JugglerName(target.JugglerId)}, Hand {target.Hand}, {DerivedHeightLabel(target)} bei Beat {target.StartTime.ToString("0.##", CultureInfo.InvariantCulture)}. Ziehen, Enter oder Leertaste zum nächsten Ziel, Pfeil links zurück und Pfeil rechts vor.";
    }
    private static string JugglerActionLabel(string name) => $"{name}: kurz drücken zum Auswählen, lange drücken zum Hinzufügen eines Wurfs";
    private static string Aria(bool value) => value ? "true" : "false";
    private bool IsEditingThrow(string throwId, int cycle) => _editingThrow == (throwId, cycle);
    private bool IsHandMenuOpen(string throwId, int cycle) => _handMenuThrow == (throwId, cycle);
    private List<ConnectionIssue> ConnectionIssues()
    {
        var issues = new List<ConnectionIssue>();
        foreach (var node in _state.Throws)
        {
            var incoming = _state.CausalEdges.Count(edge => edge.ToThrowId == node.Id);
            var outgoing = _state.CausalEdges.Count(edge => edge.FromThrowId == node.Id);
            var messages = new List<string>();
            AddArrowCountMessage(messages, "eingehend", incoming);
            AddArrowCountMessage(messages, "ausgehend", outgoing);
            if (messages.Count > 0)
                issues.Add(new ConnectionIssue(node.Id, messages));
        }
        return issues;
    }

    private static void AddArrowCountMessage(List<string> messages, string direction, int count)
    {
        if (count == 0)
            messages.Add($"kein {direction}er Pfeil");
        else if (count > 1)
            messages.Add($"{count} {direction}e Pfeile");
    }


