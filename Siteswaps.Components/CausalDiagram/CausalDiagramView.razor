@using System.Globalization
@using Siteswap.Details.CausalDiagram
@using Siteswap.Details
@using Throw = Siteswap.Details.CausalDiagram.Throw
@page "/causal-diagram-view"
<svg width="@Width" height="200" viewBox="-100 -100 200 200">
    @foreach (var person in Persons)
    {
        @foreach (var node in NodesForJuggler(person))
        {
            <circle cx="@GetXPositionFor(node)" cy="@(GetHeightForPerson(person))" r="@GetRadius()" stroke="@GetColor(node)" stroke-width="4" fill="@GetColor(node)"/>
            <text>
                <text x="@GetXPositionFor(node)"
                      y="@(GetHeightForPerson(person))"
                      text-anchor="middle"
                      stroke="red"
                      stroke-width="1px"
                      alignment-baseline="middle">
                    @node.Hand.Name
                </text>
            </text>
        }
        
        @foreach (var transition in Value.Transitions)
        {
            <path id="lineBC" 
                  d="M @GetXPositionFor(transition.Start) @(GetHeightForPerson(transition.Start.Hand.Person)) l @GetXPositionFor(transition.End) @(GetHeightForPerson(transition.End.Hand.Person))" 
                  stroke="red" 
                  stroke-width="3" 
                  fill="none" />
        }
    }
</svg>

@code {

    [Parameter, SupplyParameterFromQuery(Name = "s")]
    public string? SiteswapNotation { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "h")]
    public string? HandsNotation { get; set; }

    [Parameter]
    public CausalDiagram Value { get; set; } = CausalDiagramGenerator.Generate(new Siteswap(5,3,1), new CyclicArray<Hand>(new Hand("R", new Person("A")), new Hand("L", new Person("A"))));

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(SiteswapNotation))
        {
            return;
        }

        if (!Siteswap.TryCreate(SiteswapNotation, out var siteswap) || siteswap is null)
        {
            return;
        }

        var hands = ParseHands(HandsNotation);
        Value = CausalDiagramGenerator.Generate(siteswap, hands);
        base.OnParametersSet();
    }

    private static CyclicArray<Hand> ParseHands(string? notation)
    {
        if (string.IsNullOrWhiteSpace(notation) || notation.Length > 80)
        {
            return DefaultHands();
        }

        var hands = notation.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (hands.Length is < 1 or > 16 || hands.Any(hand => hand.Length is < 2 or > 12 || !char.IsAsciiLetter(hand[^1])))
        {
            return DefaultHands();
        }

        return new CyclicArray<Hand>(hands.Select(hand => new Hand(hand[^1].ToString(), new Person(hand[..^1]))));
    }

    private static CyclicArray<Hand> DefaultHands() =>
        new(new Hand("R", new Person("A")), new Hand("L", new Person("A")));

    private List<Person> Persons => Value.Throws.Select(x => x.Hand.Person).Distinct().ToList();

    private List<Throw> NodesForJuggler(Person person)
    {
        return Value.Throws.Where(x => x.Hand.Person == person).ToList();
    }

    private int GetHeightForPerson(Person person)
    {
        return (int)(100 * (1.0 * Persons.IndexOf(person) / Persons.Count));
    }

    private int GetXPositionFor(Throw @throw)
    {
        return (int)(@throw.Time * 50);
    }

    private string GetColor(Throw @throw)
    {
        var differentHands = Value.Throws.Select(x => x.Hand.Name).Distinct().ToList();
        List<(string Hand, double Value)> mapping = differentHands.Select((x, i) => (x, 255.0 * i / differentHands.Count)).ToList();
        var value = mapping.FirstOrDefault(x => x.Hand == @throw.Hand.Name).Value;
        return $"rgb(100, 100, {value}";
    }

    private string GetRadius()
    {
        return (20 * Value.MaxTime / Width).ToString(CultureInfo.InvariantCulture);
    }

    private int Width => 200;

}
