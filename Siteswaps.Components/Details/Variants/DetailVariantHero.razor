@namespace Siteswaps.Components.Details.Variants
@using Siteswaps.Components.Details
@inject IStringLocalizer<DetailVariantHero> L

@if (Model is null)
{
    return;
}

<section class="sdv-hero">
    <JugglerBeatRows Model="Model" />

    @if (Model.CanCreateThreePersonFeed)
    {
        <section class="sdv-continue" aria-labelledby="sdv-continue-heading">
            <h2 id="sdv-continue-heading" class="sdv-section-title sdv-continue-heading">@L["Continue with this siteswap"]</h2>
            <p class="sdv-muted sdv-continue-lead">
                @L["Turn this two-person pattern into a normal three-person feed by assigning A's passes to B1 and B2."]
            </p>
            <div class="sdv-continue-actions">
                <a class="sdv-continue-primary"
                   href="@Model.ThreePersonFeedHref">
                    @L["Create 3-person feed"]
                </a>
                <a class="sdv-continue-secondary"
                   href="@Model.PassistLink"
                   target="_blank"
                   rel="noopener">
                    @L["Open in Passist ↗"]
                </a>
            </div>
        </section>
    }
</section>

@code {
    [Parameter] public DetailViewModel? Model { get; set; }
}
