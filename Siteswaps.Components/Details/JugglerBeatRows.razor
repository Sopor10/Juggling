@namespace Siteswaps.Components.Details
@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage
@inject IStringLocalizer<JugglerBeatRows> L

@if (Model is null || Model.Jugglers.Count == 0)
{
    return;
}

<div class="sdv-hero-jugglers @ExtraClass">
    <div class="sdv-hero-jugglers-body">
        @if (!string.IsNullOrEmpty(Title))
        {
            <h3 class="sdv-section-title @TitleClass">@Title</h3>
        }

        @foreach (var juggler in Model.Jugglers)
        {
            Model.Diagrams.StartProps.TryGetValue(juggler.Label, out var start);
            var chips = juggler.Throws.Select(t => t.ForMode(_mode)).ToList();
            <div class="sdv-hero-juggler">
                <div class="sdv-hero-beats">
                    <div class="sdv-hero-id">
                        <span class="sdv-hero-label">@juggler.Label</span>
                        @if (Model.ShowLocalAverages)
                        {
                            <span class="sdv-muted sdv-hero-avg">Ø @juggler.AverageObjects.ToString("0.##")</span>
                        }
                    </div>
                    @if (start is not null)
                    {
                        <div class="sdv-start-props"
                             title="@L["Starting club distribution (L / R)"]"
                             aria-label="@($"Start clubs {juggler.Label}: left {start.Left}, right {start.Right}")">
                            <span class="sdv-start-props-hand">@start.Left</span>
                            <span class="sdv-start-props-hand">@start.Right</span>
                        </div>
                    }
                    <div class="sdv-hero-throws"
                         style="@($"--sdv-stagger:{juggler.Index};--sdv-jugglers:{Model.NumberOfJugglers}")">
                        <ThrowChipRow Chips="chips" AriaLabel="@($"Throws {juggler.Label}")" />
                    </div>
                </div>
            </div>
        }

        <div class="sdv-hero-footer">
            @if (ShowLegend)
            {
                <div class="sdv-beat-legend" aria-label="@L["Legend"]">
                    <span class="sdv-start-props sdv-start-props-legend" aria-hidden="true">
                        <span class="sdv-start-props-hand">L</span>
                        <span class="sdv-start-props-hand">R</span>
                    </span>
                    <span class="sdv-muted">@L["Start clubs"]</span>
                    <span class="sdv-beat pass"><span class="sdv-beat-throw">·</span></span>
                    <span class="sdv-muted">Pass</span>
                    <span class="sdv-beat self"><span class="sdv-beat-throw">·</span></span>
                    <span class="sdv-muted">Self</span>
                </div>
            }
            else
            {
                <span></span>
            }

            <div class="sdv-throw-mode" role="radiogroup" aria-label="Wurf-Anzeige">
                <button type="button"
                        role="radio"
                        class="@ModeClass(DetailViewModel.ThrowDisplayMode.Local)"
                        aria-checked="@(_mode == DetailViewModel.ThrowDisplayMode.Local)"
                        @onclick="() => SetModeAsync(DetailViewModel.ThrowDisplayMode.Local)">
                    Lokal
                </button>
                <button type="button"
                        role="radio"
                        class="@ModeClass(DetailViewModel.ThrowDisplayMode.Global)"
                        aria-checked="@(_mode == DetailViewModel.ThrowDisplayMode.Global)"
                        @onclick="() => SetModeAsync(DetailViewModel.ThrowDisplayMode.Global)">
                    Global
                </button>
                <button type="button"
                        role="radio"
                        class="@ModeClass(DetailViewModel.ThrowDisplayMode.Name)"
                        aria-checked="@(_mode == DetailViewModel.ThrowDisplayMode.Name)"
                        @onclick="() => SetModeAsync(DetailViewModel.ThrowDisplayMode.Name)">
                    Namen
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public DetailViewModel? Model { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? TitleClass { get; set; }
    [Parameter] public string? ExtraClass { get; set; }
    [Parameter] public bool ShowLegend { get; set; } = true;

    private DetailViewModel.ThrowDisplayMode _mode = DetailViewModel.ThrowDisplayMode.Global;

    protected override async Task OnInitializedAsync()
    {
        var settings = await LocalStorage.GetItemAsync<PersistedSettings>(PersistedSettings.StorageKey);
        _mode = PersistedSettings.ParseThrowDisplayMode(settings?.ThrowDisplayMode);
    }

    private async Task SetModeAsync(DetailViewModel.ThrowDisplayMode mode)
    {
        if (_mode == mode)
        {
            return;
        }

        _mode = mode;
        var settings = await LocalStorage.GetItemAsync<PersistedSettings>(PersistedSettings.StorageKey)
                       ?? new PersistedSettings();
        settings.ThrowDisplayMode = mode.ToString();
        await LocalStorage.SetItemAsync(PersistedSettings.StorageKey, settings);
    }

    private string? ModeClass(DetailViewModel.ThrowDisplayMode mode) =>
        _mode == mode ? "active" : null;
}
