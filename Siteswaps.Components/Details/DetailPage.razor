@page "/details"
@namespace Siteswaps.Components.Details
@using Siteswaps.Components.Details.Variants
@inject NavigationManager Navigation

<div class="sd-page">
    <header class="sd-header">
        <div class="sd-header-row">
            <a class="sd-back" href="/">← Assistent</a>
            @if (Model is not null)
            {
                <a class="sd-external" href="@Model.PassistLink" target="_blank" rel="noopener">Passist</a>
            }
        </div>
        @if (Model is not null)
        {
            <div class="sd-header-notation" role="group" aria-label="Siteswap rotation">
                <button type="button"
                        class="sd-rotate"
                        aria-label="Siteswap nach links rotieren"
                        disabled="@(Model.Period <= 1)"
                        @onclick="() => Rotate(-1)">
                    ◄
                </button>
                <span class="sd-header-notation-value">@Model.Notation</span>
                <button type="button"
                        class="sd-rotate"
                        aria-label="Siteswap nach rechts rotieren"
                        disabled="@(Model.Period <= 1)"
                        @onclick="() => Rotate(1)">
                    ►
                </button>
            </div>
            <div class="sd-header-meta" role="group" aria-label="Jongleure und Keulen">
                <div class="sd-juggler-stepper" role="group" aria-label="Anzahl Jongleure">
                    <button type="button"
                            class="sd-rotate sd-juggler-step"
                            aria-label="Weniger Jongleure"
                            disabled="@(Model.NumberOfJugglers <= MinJugglers)"
                            @onclick="() => ChangeJugglers(-1)">
                        ◄
                    </button>
                    <span class="sd-header-meta-value">@Model.NumberOfJugglers Jongleure</span>
                    <button type="button"
                            class="sd-rotate sd-juggler-step"
                            aria-label="Mehr Jongleure"
                            disabled="@(Model.NumberOfJugglers >= MaxJugglers)"
                            @onclick="() => ChangeJugglers(1)">
                        ►
                    </button>
                </div>
                <span class="sd-header-meta-clubs">@Model.NumberOfClubs Keulen</span>
            </div>
        }
    </header>

    <div class="sd-sheet">
        @if (Model is null)
        {
            <div class="sd-empty">
                <h2>Kein gültiger Siteswap</h2>
                <p>Öffne einen Siteswap aus dem Wizard oder setze <code>?s=</code> und optional <code>&amp;n=</code>.</p>
            </div>
        }
        else
        {
            <div class="sd-tabs" role="tablist" aria-label="Detail-Varianten">
                @foreach (var tab in Tabs)
                {
                    <button type="button"
                            role="tab"
                            class="sd-tab @(ActiveTab == tab.Id ? "active" : null)"
                            aria-selected="@(ActiveTab == tab.Id)"
                            @onclick="() => SelectTab(tab.Id)">
                        @tab.Label
                    </button>
                }
            </div>

            <div class="sd-variant" role="tabpanel">
                @switch (ActiveTab)
                {
                    case "hero":
                        <DetailVariantHero Model="Model" />
                        break;
                    case "analysis":
                        <DetailVariantAnalysis Model="Model" />
                        break;
                    case "transitions":
                        <DetailVariantTransitions Model="Model" />
                        break;
                    case "diagrams":
                        <DetailVariantDiagrams Model="Model" />
                        break;
                }
            </div>
        }
    </div>
</div>

@code {
    private const int MinJugglers = 1;
    private const int MaxJugglers = 20;

    [Parameter, SupplyParameterFromQuery(Name = "s")]
    public string StringValue { get; set; } = "";

    [Parameter, SupplyParameterFromQuery(Name = "n")]
    public int NumberOfJugglers { get; set; } = 2;

    private DetailViewModel? Model { get; set; }
    private string ActiveTab { get; set; } = "hero";

    private static readonly TabInfo[] Tabs =
    [
        new("hero", "Übersicht"),
        new("analysis", "Analyse"),
        new("transitions", "Transitions"),
        new("diagrams", "Diagramme"),
    ];

    protected override void OnParametersSet()
    {
        var jugglers = NumberOfJugglers < MinJugglers ? 2 : Math.Clamp(NumberOfJugglers, MinJugglers, MaxJugglers);
        Model = DetailViewModel.TryCreate(StringValue, jugglers);
        base.OnParametersSet();
    }

    private void SelectTab(string id) => ActiveTab = id;

    private void Rotate(int steps)
    {
        if (Model is null || Model.Period <= 1)
        {
            return;
        }

        var rotated = Model.Value.Rotate(steps).ToString();
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("s", rotated));
    }

    private void ChangeJugglers(int delta)
    {
        if (Model is null)
        {
            return;
        }

        var next = Math.Clamp(Model.NumberOfJugglers + delta, MinJugglers, MaxJugglers);
        if (next == Model.NumberOfJugglers)
        {
            return;
        }

        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("n", next.ToString()));
    }

    private sealed record TabInfo(string Id, string Label);
}
