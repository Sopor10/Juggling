@using Siteswap.Details
<input value="@_siteswapInputValue" @oninput="OnInput" />

@code {
    [Parameter]
    public Siteswap? Siteswap { get; set; }

    [Parameter]
    public EventCallback<Siteswap?> SiteswapChanged { get; set; }

    private string? _siteswapInputValue;

    protected override void OnParametersSet()
    {
        if (Siteswap is not null)
        {
            _siteswapInputValue = Siteswap.ToString();
        }

        base.OnParametersSet();
    }

    private async Task OnInput(ChangeEventArgs args)
    {
        _siteswapInputValue = args.Value as string;

        if (string.IsNullOrWhiteSpace(_siteswapInputValue))
        {
            await SiteswapChanged.InvokeAsync(null);
            return;
        }

        if (Siteswap.TryCreate(_siteswapInputValue, out var siteswap))
        {
            await SiteswapChanged.InvokeAsync(siteswap);
        }
        else
        {
            await SiteswapChanged.InvokeAsync(null);
        }
    }
}
