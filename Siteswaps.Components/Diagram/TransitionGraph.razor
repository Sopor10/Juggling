@using Siteswap.Details
@using VisNetwork.Blazor.Models
@using Siteswap.Details.StateDiagram

<Network Id="@NetworkId" Data="@Data" Options="DiagramStyle.Options" style="width: 100%; max-width: 640px; height: 360px"/>

@code {
    [Parameter]
    public Transition? Transition { get; set; }

    [Parameter]
    public string? Id { get; set; }

    private string NetworkId => string.IsNullOrWhiteSpace(Id) ? "transition-graph" : Id;

    private Transition? _renderedTransition;

    private NetworkData Data { get; set; } = new() { Nodes = [], Edges = [] };

    protected override void OnParametersSet()
    {
        if (_renderedTransition?.PrettyPrint() != Transition?.PrettyPrint())
        {
            _renderedTransition = Transition;
            CreateNetworkData(Transition);
        }

        base.OnParametersSet();
    }

    private void CreateNetworkData(Transition? transition)
    {
        var nodes = new List<Node>();
        var edges = new List<Edge>();

        if (transition is null)
        {
            Data = new NetworkData { Edges = edges, Nodes = nodes };
            return;
        }

        var fromGraph = StateGraphFromSiteswapGenerator.CalculateGraph(transition.From);
        var toGraph = StateGraphFromSiteswapGenerator.CalculateGraph(transition.To);

        AddNodes(fromGraph, nodes);
        AddNodes(toGraph, nodes);

        AddEdges(fromGraph, edges);
        AddEdges(toGraph, edges);

        var fromMatch = transition
            .From.AllStates()
            .FirstOrDefault(x => x.Value.Contains(transition.From));
        if (fromMatch.Equals(default(KeyValuePair<State, List<Siteswap>>)))
        {
            Data = new NetworkData { Edges = edges, Nodes = nodes };
            return;
        }

        var state = fromMatch.Key;

        foreach (var transitionThrow in transition.Throws)
        {
            var nextState = state.Advance().Throw(transitionThrow.Value);

            AddState(nodes, state);
            AddState(nodes, nextState);

            AddEdge(
                edges,
                state.StateRepresentation(),
                nextState.StateRepresentation(),
                transitionThrow.Value.ToSiteswapString(),
                highlight: true
            );
            state = nextState;
        }

        Data = new NetworkData { Edges = edges, Nodes = nodes };
    }

    private static void AddEdges(StateGraph fromGraph, List<Edge> edges)
    {
        foreach (var edge in fromGraph.Graph.Edges)
        {
            AddEdge(
                edges,
                edge.N1.StateRepresentation(),
                edge.N2.StateRepresentation(),
                edge.Data.ToString()
            );
        }
    }

    private static void AddEdge(
        List<Edge> edges,
        string from,
        string to,
        string data,
        bool highlight = false
    )
    {
        if (edges.Any(x => x.From == from && x.To == to))
        {
            return;
        }

        edges.Add(DiagramStyle.CreateEdge(from, to, data, highlight));
    }

    private static void AddNodes(StateGraph fromGraph, ICollection<Node> nodes)
    {
        foreach (var node in fromGraph.Graph.Nodes)
        {
            AddState(nodes, node);
        }
    }

    private static void AddState(ICollection<Node> nodes, State node)
    {
        if (nodes.All(x => x.Id != node.StateRepresentation()))
        {
            nodes.Add(DiagramStyle.CreateStateNode(node.StateRepresentation(), node.StateRepresentation()));
        }
    }
}
