@using Siteswap.Details
@using VisNetwork.Blazor.Models
@using Siteswap.Details.StateDiagram
@inject IJSRuntime JS

@if (_designDecisions is { } decisions)
{
    <Network Id="@NetworkId" Data="@Data" Options="@(network => DiagramStyle.Options(network, decisions))" style="width: 100%; max-width: 640px; height: 360px"/>
}

@code {
    [Parameter]
    public Transition? Transition { get; set; }

    [Parameter]
    public string? Id { get; set; }

    private string NetworkId => string.IsNullOrWhiteSpace(Id) ? "transition-graph" : Id;

    private Transition? _renderedTransition;

    private DiagramDesignDecisions? _designDecisions;

    private NetworkData Data { get; set; } = new() { Nodes = [], Edges = [] };

    protected override void OnParametersSet()
    {
        if (_designDecisions is not null && _renderedTransition?.PrettyPrint() != Transition?.PrettyPrint())
        {
            _renderedTransition = Transition;
            CreateNetworkData(Transition);
        }

        base.OnParametersSet();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _designDecisions = await DesignDecisionTokens.ReadDiagramAsync(JS);
        _renderedTransition = Transition;
        CreateNetworkData(Transition);
        await InvokeAsync(StateHasChanged);
    }

    private void CreateNetworkData(Transition? transition)
    {
        if (_designDecisions is not { } decisions)
        {
            return;
        }

        var nodes = new List<Node>();
        var edges = new List<Edge>();

        if (transition is null)
        {
            Data = new NetworkData { Edges = edges, Nodes = nodes };
            return;
        }

        var fromGraph = StateGraphFromSiteswapGenerator.CalculateGraph(transition.From);
        var toGraph = StateGraphFromSiteswapGenerator.CalculateGraph(transition.To);

        AddNodes(fromGraph, nodes, decisions);
        AddNodes(toGraph, nodes, decisions);

        AddEdges(fromGraph, edges, decisions);
        AddEdges(toGraph, edges, decisions);

        var fromMatch = transition
            .From.AllStates()
            .FirstOrDefault(x => x.Value.Contains(transition.From));
        if (fromMatch.Equals(default(KeyValuePair<State, List<Siteswap>>)))
        {
            Data = new NetworkData { Edges = edges, Nodes = nodes };
            return;
        }

        var state = fromMatch.Key;

        foreach (var transitionThrow in transition.Throws)
        {
            var nextState = state.Advance().Throw(transitionThrow.Value);

            AddState(nodes, state, decisions);
            AddState(nodes, nextState, decisions);

            AddEdge(
                edges,
                state.StateRepresentation(),
                nextState.StateRepresentation(),
                transitionThrow.Value.ToSiteswapString(),
                decisions,
                highlight: true
            );
            state = nextState;
        }

        Data = new NetworkData { Edges = edges, Nodes = nodes };
    }

    private static void AddEdges(StateGraph fromGraph, List<Edge> edges, DiagramDesignDecisions decisions)
    {
        foreach (var edge in fromGraph.Graph.Edges)
        {
            AddEdge(
                edges,
                edge.N1.StateRepresentation(),
                edge.N2.StateRepresentation(),
                edge.Data.ToString(),
                decisions
            );
        }
    }

    private static void AddEdge(
        List<Edge> edges,
        string from,
        string to,
        string data,
        DiagramDesignDecisions decisions,
        bool highlight = false
    )
    {
        if (edges.Any(x => x.From == from && x.To == to))
        {
            return;
        }

        edges.Add(DiagramStyle.CreateEdge(from, to, data, decisions, highlight));
    }

    private static void AddNodes(
        StateGraph fromGraph,
        ICollection<Node> nodes,
        DiagramDesignDecisions decisions
    )
    {
        foreach (var node in fromGraph.Graph.Nodes)
        {
            AddState(nodes, node, decisions);
        }
    }

    private static void AddState(
        ICollection<Node> nodes,
        State node,
        DiagramDesignDecisions decisions
    )
    {
        if (nodes.All(x => x.Id != node.StateRepresentation()))
        {
            nodes.Add(
                DiagramStyle.CreateStateNode(
                    node.StateRepresentation(),
                    node.StateRepresentation(),
                    decisions
                )
            );
        }
    }
}
