@namespace Siteswaps.Generator.Components.Feeding
@using Siteswaps.Components.CausalDiagram
@using Siteswaps.Jif.Components
@using Siteswaps.Generator.Core.Generator
@inject IStringLocalizer<FeedingCombinationView> L

<section class="feeding-combination" aria-labelledby="feeding-title">
    <FeedingJugglerOverview Session="Session"
                            Rows="BuildRows()"
                            Mode="_mode"
                            ModeChanged="OnModeChanged"
                            RotationRequested="RotationRequested" />

    @if (PassingPattern is { } passing)
    {
        <section class="feeding-combination-visuals" aria-label="Passist und Kausaldiagramm">
            <PassistAnimation Jif="@(new JifInput.Json(passing.JifJson))"
                              TimeZones="@(new[] { Session.Topology.A.TimeZone, Session.Topology.B1.TimeZone, Session.Topology.B2.TimeZone })"
                              EnableSettings="true"
                              ShowSpeedLabel="false" />
            <CausalDiagramEditorView Embedded="true"
                                      ExternalState="passing.DiagramState"
                                      ShowOptions="false"
                                      ShowAnimation="false"
                                      AllowNodeMove="false"
                                      AllowThrowActions="false"
                                      AllowJugglerActions="false"
                                      AllowArrowEditing="false"
                                      ShowConnectionIssues="false" />
        </section>
    }

    @if (ShowBack)
    {
        <button type="button" class="feeding-btn-ghost" @onclick="Back">@L["Back"]</button>
    }
</section>

@code {
    private FeedingThrowDisplay.Mode _mode = FeedingThrowDisplay.Mode.Global;

    private PassingPatternViewModel? PassingPattern => BuildPassingPattern();

    [Parameter, EditorRequired]
    public NormalFeedSession Session { get; set; } = null!;

    [Parameter]
    public EventCallback Back { get; set; }

    [Parameter]
    public EventCallback<int> RotationRequested { get; set; }

    /// <summary>When false, host owns Back in a sticky footer (FeedingPage).</summary>
    [Parameter]
    public bool ShowBack { get; set; } = true;

    private Task OnModeChanged(FeedingThrowDisplay.Mode mode)
    {
        _mode = mode;
        return Task.CompletedTask;
    }

    private IReadOnlyList<FeedingJugglerOverview.Row> BuildRows()
    {
        const int pairJugglers = 2;
        var rows = new List<FeedingJugglerOverview.Row>(3);
        var feeder = Session.FeederSiteswap;
        var aLocal = feeder.GetLocalSiteswap(Session.Topology.A.TimeZone, pairJugglers);
        ClubHands? aClubs = Session.TryStartingClubs("A", out var clubsA) ? clubsA : null;
        rows.Add(
            new FeedingJugglerOverview.Row(
                "A",
                feeder,
                Session.Topology.A.TimeZone,
                pairJugglers,
                aLocal.Average(),
                ShowAverage: feeder.Period.Value % pairJugglers == 0,
                aClubs
            )
        );

        AddPartner("B1", Session.Topology.B1.TimeZone);
        AddPartner("B2", Session.Topology.B2.TimeZone);
        return rows;

        void AddPartner(string role, int timeZone)
        {
            if (Session.SelectedSiteswap(role) is not { } siteswap)
            {
                return;
            }

            var local = siteswap.GetLocalSiteswap(timeZone, pairJugglers);
            ClubHands? clubs = Session.TryStartingClubs(role, out var c) ? c : null;
            rows.Add(
                new FeedingJugglerOverview.Row(
                    role,
                    siteswap,
                    timeZone,
                    pairJugglers,
                    local.Average(),
                    ShowAverage: siteswap.Period.Value % pairJugglers == 0,
                    clubs
                )
            );
        }
    }

    private PassingPatternViewModel? BuildPassingPattern()
    {
        string[] roles = ["A", "B1", "B2"];
        var siteswaps = new Siteswap?[roles.Length];
        siteswaps[0] = Session.FeederSiteswap;
        siteswaps[1] = Session.SelectedSiteswap("B1");
        siteswaps[2] = Session.SelectedSiteswap("B2");
        if (siteswaps.Any(siteswap => siteswap is null))
        {
            return null;
        }

        const int pairJugglers = 2;
        var timeZones = roles.Select(role => Session.Topology[role].TimeZone).ToArray();
        var heights = roles.Select((role, index) => (IReadOnlyList<int>)FeedingThrowDisplay
            .ChipsFor(siteswaps[index]!, timeZones[index], pairJugglers, FeedingThrowDisplay.Mode.Global)
            .Select(chip => chip.Height)
            .ToArray()).ToArray();
        var targets = roles.Select((role, person) => (IReadOnlyList<int>)Enumerable.Range(0, heights[person].Count)
            .Select(beat =>
            {
                var globalBeat = (timeZones[person] + beat * pairJugglers) % Session.FeederSiteswap.Items.Length;
                if (FeedingThrowDisplay.Kind(heights[person][beat], pairJugglers) == PassOrSelf.Self)
                {
                    return person;
                }

                if (person == 0)
                {
                    var recipient = Session.PassAssignments[globalBeat];
                    return recipient == "B1" ? 1 : recipient == "B2" ? 2 : person;
                }

                return 0;
            }).ToArray()).ToArray();

        try
        {
            var state = CausalDiagramEditorState.CreatePassingPattern(timeZones, heights, targets);
            var jifJson = Siteswaps.Generator.Components.SiteswapLab.SiteswapLabJifMapper.MapViaCausalDiagram(
                timeZones,
                heights,
                targets,
                propType: "club",
                layout: JugglerLayoutPresets.CreateWvLayout(timeZones));
            return new PassingPatternViewModel(state, jifJson);
        }
        catch (ArgumentException)
        {
            return null;
        }
        catch (InvalidOperationException)
        {
            return null;
        }
    }

    private sealed record PassingPatternViewModel(CausalDiagramEditorState DiagramState, string JifJson);
}
