@using Siteswaps.Generator.Components.Internal.EasyFilter
@using Siteswaps.Generator.Components.State
@using Siteswaps.Generator.Core.Generator
@using Siteswaps.Generator.Core.Generator.Filter
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<FilterBottomSheet> L

@if (_isOpen)
{
<div class="wizard-sheet-backdrop open" @onclick="Close"></div>
<div @ref="_sheetElement" class="wizard-bottom-sheet open" role="dialog" aria-modal="true"
     aria-labelledby="wizard-sheet-title" tabindex="-1" @onkeydown="OnKeyDown">
    <div class="wizard-sheet-handle"></div>
    <div class="wizard-sheet-heading">
        <h3 id="wizard-sheet-title" class="wizard-sheet-title">@SheetTitle</h3>
    </div>

    <div class="wizard-tabs" role="tablist" aria-label="@L["Filter type"]">
        <button type="button" class="wizard-tab @(_activeTab == FilterTabKind.Number ? "active" : "")"
                id="wizard-filter-tab-number" role="tab" aria-selected="@(_activeTab == FilterTabKind.Number ? "true" : "false")"
                aria-controls="wizard-filter-panel-number" tabindex="@(_activeTab == FilterTabKind.Number ? "0" : "-1")"
                @onkeydown="e => OnTabKeyDown(e, FilterTabKind.Number)"
                @onclick="() => SelectTab(FilterTabKind.Number)">@L["Number"]</button>
        <button type="button" class="wizard-tab @(_activeTab == FilterTabKind.Pattern ? "active" : "")"
                id="wizard-filter-tab-pattern" role="tab" aria-selected="@(_activeTab == FilterTabKind.Pattern ? "true" : "false")"
                aria-controls="wizard-filter-panel-pattern" tabindex="@(_activeTab == FilterTabKind.Pattern ? "0" : "-1")"
                @onkeydown="e => OnTabKeyDown(e, FilterTabKind.Pattern)"
                @onclick="() => SelectTab(FilterTabKind.Pattern)">@L["Pattern"]</button>
        <button type="button" class="wizard-tab @(_activeTab == FilterTabKind.State ? "active" : "")"
                id="wizard-filter-tab-state" role="tab" aria-selected="@(_activeTab == FilterTabKind.State ? "true" : "false")"
                aria-controls="wizard-filter-panel-state" tabindex="@(_activeTab == FilterTabKind.State ? "0" : "-1")"
                @onkeydown="e => OnTabKeyDown(e, FilterTabKind.State)"
                @onclick="() => SelectTab(FilterTabKind.State)">@L["State"]</button>
    </div>

    <div class="wizard-sheet-body">
        <div id="wizard-filter-panel-number" class="wizard-sheet-panel @(_activeTab == FilterTabKind.Number ? "active" : null)" role="tabpanel" aria-labelledby="wizard-filter-tab-number" aria-hidden="@(_activeTab == FilterTabKind.Number ? "false" : "true")">
            <NumberFilterEditor @key="_sessionId" PossibleThrows="AllowedThrows" Value="_numberDraft"
                                 ValueChanged="v => _numberDraft = v" NumberOfJugglers="NumberOfJugglers" />
        </div>
        <div id="wizard-filter-panel-pattern" class="wizard-sheet-panel @(_activeTab == FilterTabKind.Pattern ? "active" : null)" role="tabpanel" aria-labelledby="wizard-filter-tab-pattern" aria-hidden="@(_activeTab == FilterTabKind.Pattern ? "false" : "true")">
            <PatternFilterEditor @key="_sessionId" PossibleThrows="AllowedThrows" Value="_patternDraft"
                                  ValueChanged="v => _patternDraft = v" Period="Period" NumberOfJugglers="NumberOfJugglers" />
        </div>
        <div id="wizard-filter-panel-state" class="wizard-sheet-panel @(_activeTab == FilterTabKind.State ? "active" : null)" role="tabpanel" aria-labelledby="wizard-filter-tab-state" aria-hidden="@(_activeTab == FilterTabKind.State ? "false" : "true")">
            <StateFilterEditor @key="_sessionId" Value="_stateDraft" ValueChanged="v => _stateDraft = v" />
        </div>
    </div>

    <div class="wizard-sheet-actions">
        @if (_editingId is not null)
        {
            <button type="button" class="wizard-btn-ghost" @onclick="Delete">@L["Remove filter"]</button>
        }
        <button type="button" class="wizard-btn-filter-primary wizard-flex-1" @onclick="Save">
            @(_editingId is null ? L["Apply filter"] : L["Save changes"])
        </button>
    </div>
    @if (_validationMessage is not null)
    {
        <p class="wizard-validation" role="alert">@_validationMessage</p>
    }
</div>
}

@code {
    private enum FilterTabKind
    {
        Number,
        Pattern,
        State,
    }

    [Parameter, EditorRequired]
    public IReadOnlyList<Throw> AllowedThrows { get; set; } = Array.Empty<Throw>();

    [Parameter]
    public int Period { get; set; } = 5;

    [Parameter]
    public int NumberOfJugglers { get; set; } = 3;

    [Parameter]
    public bool ShowThrowNames { get; set; } = true;

    [Parameter]
    public EventCallback<IFilterInformation> FilterAdded { get; set; }

    [Parameter]
    public EventCallback<(int Id, IFilterInformation Filter)> FilterEdited { get; set; }

    [Parameter]
    public EventCallback<int> FilterDeleted { get; set; }

    private bool _isOpen;
    private int? _editingId;
    private FilterTabKind _activeTab = FilterTabKind.Number;
    private int _sessionId;
    private ElementReference _sheetElement;
    private string? _validationMessage;
    private bool _focusPending;
    private bool _restoreFocusPending;
    private bool _focusTrapActive;
    private IJSObjectReference? _jsModule;

    private EasyNumberFilter.NumberFilter _numberDraft = NewNumberDraft(Array.Empty<Throw>());
    private NewPatternFilterInformation _patternDraft = NewPatternDraft(5);
    private EasyStateFilter.StateFilter _stateDraft = EasyStateFilter.NewDraft(1);

    private int StateDraftLength =>
        EasyStateFilter.MaxBeatFromAllowedThrows(AllowedThrows, NumberOfJugglers, ShowThrowNames);

    private string SheetTitle => _editingId is null ? L["Add filter"] : L["Edit filter"];

    private string ActiveTabElementId => $"wizard-filter-tab-{_activeTab.ToString().ToLowerInvariant()}";

    public bool IsOpen => _isOpen;

    public void OpenForNew()
    {
        _editingId = null;
        _sessionId++;
        _numberDraft = NewNumberDraft(AllowedThrows);
        _patternDraft = NewPatternDraft(Period);
        _stateDraft = EasyStateFilter.NewDraft(StateDraftLength);
        _activeTab = FilterTabKind.Number;
        _isOpen = true;
        _validationMessage = null;
        _focusPending = true;
    }

    public void OpenForEdit(WizardFilterEntry entry)
    {
        _editingId = entry.Id;
        _sessionId++;
        _numberDraft = NewNumberDraft(AllowedThrows);
        _patternDraft = NewPatternDraft(Period);
        _stateDraft = EasyStateFilter.NewDraft(StateDraftLength);

        switch (entry.Filter)
        {
            case EasyNumberFilter.NumberFilter numberFilter:
                _numberDraft = numberFilter;
                _activeTab = FilterTabKind.Number;
                break;
            case NewPatternFilterInformation patternFilter:
                // Clone the mutable Pattern list - PatternFilterEditor mutates it in-place
                // (Clear()/AddRange()/index-set), so editing without cloning would corrupt
                // the saved filter immediately, even if the user later cancels/closes.
                _patternDraft = patternFilter with { Pattern = new List<Throw>(patternFilter.Pattern) };
                _activeTab = FilterTabKind.Pattern;
                break;
            case EasyStateFilter.StateFilter stateFilter:
                _stateDraft = EasyStateFilter.FitToLength(stateFilter, StateDraftLength);
                _activeTab = FilterTabKind.State;
                break;
        }

        _isOpen = true;
        _validationMessage = null;
        _focusPending = true;
    }

    private void SelectTab(FilterTabKind kind) => _activeTab = kind;

    private async Task Close()
    {
        if (_focusTrapActive && _jsModule is not null)
        {
            await _jsModule.InvokeVoidAsync("deactivateFocusTrap", _sheetElement);
            _focusTrapActive = false;
        }

        _isOpen = false;
        _validationMessage = null;
        _restoreFocusPending = true;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Siteswaps.Generator/Components/WizardPage/WizardPage.razor.js");
        }

        if (_isOpen && _focusPending)
        {
            _focusPending = false;
            if (_jsModule is not null)
            {
                await _jsModule.InvokeVoidAsync("captureActiveElement");
                await _jsModule.InvokeVoidAsync("activateFocusTrap", _sheetElement);
                _focusTrapActive = true;
                await _jsModule.InvokeVoidAsync("focusElement", ActiveTabElementId);
            }
        }
        else if (!_isOpen && _restoreFocusPending)
        {
            _restoreFocusPending = false;
            if (_jsModule is not null)
            {
                await _jsModule.InvokeVoidAsync("restoreActiveElement");
            }
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
        }
    }

    private async Task OnTabKeyDown(KeyboardEventArgs e, FilterTabKind current)
    {
        if (e.Key is not ("ArrowRight" or "ArrowDown" or "ArrowLeft" or "ArrowUp"))
        {
            return;
        }

        var delta = e.Key is "ArrowRight" or "ArrowDown" ? 1 : -1;
        var next = (FilterTabKind)(((int)current + delta + 3) % 3);
        SelectTab(next);
        await InvokeAsync(StateHasChanged);
        if (_jsModule is not null)
        {
            await _jsModule.InvokeVoidAsync("focusElement", $"wizard-filter-tab-{next.ToString().ToLowerInvariant()}");
        }
    }

    private async Task Save()
    {
        if (_activeTab == FilterTabKind.State && !_stateDraft.Items.Any(item => item != StateValue.DontCare))
        {
            _validationMessage = L["Specify at least one occupied or free throw."];
            return;
        }

        IFilterInformation value = _activeTab switch
        {
            FilterTabKind.Number => _numberDraft,
            FilterTabKind.Pattern => _patternDraft,
            FilterTabKind.State => _stateDraft,
            _ => throw new ArgumentOutOfRangeException(),
        };

        if (_focusTrapActive && _jsModule is not null)
        {
            await _jsModule.InvokeVoidAsync("deactivateFocusTrap", _sheetElement);
            _focusTrapActive = false;
        }

        _isOpen = false;
        _validationMessage = null;
        _restoreFocusPending = true;

        if (_editingId is { } id)
        {
            await FilterEdited.InvokeAsync((id, value));
        }
        else
        {
            await FilterAdded.InvokeAsync(value);
        }
    }

    private async Task Delete()
    {
        if (_focusTrapActive && _jsModule is not null)
        {
            await _jsModule.InvokeVoidAsync("deactivateFocusTrap", _sheetElement);
            _focusTrapActive = false;
        }

        _isOpen = false;
        _restoreFocusPending = true;
        if (_editingId is { } id)
        {
            await FilterDeleted.InvokeAsync(id);
        }
    }

    private static EasyNumberFilter.NumberFilter NewNumberDraft(IReadOnlyList<Throw> throws) =>
        new()
        {
            Amount = 2,
            Type = EasyNumberFilter.NumberFilterType.Exactly,
            Throw = throws.FirstOrDefault() ?? Throw.Empty,
        };

    private static NewPatternFilterInformation NewPatternDraft(int period) =>
        new(
            WizardPatternFilterUi.DefaultSlots(period),
            PatternRotation.Global,
            true,
            false
        );
}
