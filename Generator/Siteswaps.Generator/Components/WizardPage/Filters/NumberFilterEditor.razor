@using Siteswaps.Generator.Components.Internal.EasyFilter
@using Siteswaps.Generator.Core.Generator

<p class="wizard-hint">z. B. „genau 2× Heff“</p>
<div class="wizard-number-row">
    <label class="wizard-sr-only" for="numComparison">Vergleich</label>
    <select id="numComparison" class="wizard-select" value="@Value.Type" @onchange="OnTypeChanged">
        <option value="@EasyNumberFilter.NumberFilterType.Exactly">Genau</option>
        <option value="@EasyNumberFilter.NumberFilterType.Maximum">Maximal</option>
        <option value="@EasyNumberFilter.NumberFilterType.AtLeast">Mindestens</option>
    </select>
    <label class="wizard-sr-only" for="numAmount">Anzahl</label>
    <input id="numAmount" type="number" min="0" max="30" class="wizard-input-number"
           value="@Value.Amount" @oninput="OnAmountChanged" />
    <label class="wizard-sr-only" for="numThrow">Wurf</label>
    <select id="numThrow" class="wizard-select" value="@Value.Throw.Height" @onchange="OnThrowChanged">
        @foreach (var t in PossibleThrows)
        {
            <option value="@t.Height">@t.GetDisplayValue(true)</option>
        }
    </select>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Throw> PossibleThrows { get; set; } = Array.Empty<Throw>();

    [Parameter, EditorRequired]
    public EasyNumberFilter.NumberFilter Value { get; set; } = null!;

    [Parameter]
    public EventCallback<EasyNumberFilter.NumberFilter> ValueChanged { get; set; }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<EasyNumberFilter.NumberFilterType>(e.Value?.ToString(), out var type))
        {
            await Update(Value with { Type = type });
        }
    }

    private async Task OnAmountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var amount))
        {
            await Update(Value with { Amount = Math.Max(0, amount) });
        }
    }

    private async Task OnThrowChanged(ChangeEventArgs e)
    {
        if (
            int.TryParse(e.Value?.ToString(), out var height)
            && PossibleThrows.FirstOrDefault(t => t.Height == height) is { } t
        )
        {
            await Update(Value with { Throw = t });
        }
    }

    private async Task Update(EasyNumberFilter.NumberFilter value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
