@using Siteswaps.Generator.Components.State
@using Siteswaps.Generator.Core.Generator

<p class="wizard-hint">Tippe ein Feld an, dann einen Wurf darunter.</p>
<div class="wizard-pattern-row">
    <label class="wizard-sr-only" for="patRotation">Bezug</label>
    <select id="patRotation" class="wizard-select" value="@Value.PatternRotation.Value" @onchange="OnRotationChanged">
        @foreach (var r in RotationOptions)
        {
            <option value="@r.Value">@RotationLabel(r)</option>
        }
    </select>
    <div class="wizard-segmented" role="radiogroup" aria-label="Muster soll">
        <button type="button" class="wizard-chip wizard-segment @(Value.IsIncludePattern ? "active" : "")"
                role="radio" aria-checked="@(Value.IsIncludePattern ? "true" : "false")"
                @onpointerdown:stopPropagation="true"
                @onclick="() => SetInclude(true)">enthalten sein</button>
        <button type="button" class="wizard-chip wizard-segment @(!Value.IsIncludePattern ? "active" : "")"
                role="radio" aria-checked="@(!Value.IsIncludePattern ? "true" : "false")"
                @onpointerdown:stopPropagation="true"
                @onclick="() => SetInclude(false)">ausgeschlossen sein</button>
    </div>
</div>

<div class="wizard-pattern-slots" role="group" aria-label="Muster-Sequenz, Feld antippen und dann Wurf unten wählen">
    @for (var i = 0; i < Value.Pattern.Count; i++)
    {
        var index = i;
        var isActive = index == _activeSlotIndex;
        <button type="button" class="wizard-chip wizard-pattern-slot @(isActive ? "active" : "")"
                aria-pressed="@(isActive ? "true" : "false")"
                @onpointerdown:stopPropagation="true"
                @onclick="() => SelectSlot(index)">
            @Value.Pattern[index].GetDisplayValue(true)
        </button>
    }
</div>
<div class="wizard-chip-grid wizard-pattern-palette" role="group" aria-label="Wurf-Palette">
    @foreach (var t in PossibleThrows)
    {
        <button type="button" class="wizard-chip"
                @onpointerdown:stopPropagation="true"
                @onclick="() => AssignActiveSlot(t)">
            @t.GetDisplayValue(true)
        </button>
    }
</div>

<label class="wizard-checkbox-row">
    <input type="checkbox" checked="@Value.IsValidLocally"
           @onpointerdown:stopPropagation="true"
           @onchange="OnValidLocallyChanged" />
    <span>Muss auch lokal gültig sein</span>
</label>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Throw> PossibleThrows { get; set; } = Array.Empty<Throw>();

    [Parameter, EditorRequired]
    public NewPatternFilterInformation Value { get; set; } = null!;

    [Parameter]
    public EventCallback<NewPatternFilterInformation> ValueChanged { get; set; }

    [Parameter]
    public int Period { get; set; } = 5;

    [Parameter]
    public int NumberOfJugglers { get; set; } = 2;

    private int _activeSlotIndex;

    protected override void OnInitialized()
    {
        ResizePatternToCurrentLength();
    }

    private IEnumerable<PatternRotation> RotationOptions =>
        Enumerable
            .Range(0, NumberOfJugglers)
            .Select(x => new PatternRotation(x))
            .Prepend(PatternRotation.Local)
            .Prepend(PatternRotation.Global);

    private static string RotationLabel(PatternRotation r) =>
        r.Value switch
        {
            -2 => "Global (ganzer Zyklus)",
            -1 => "Lokal (flexibel)",
            _ => $"Lokal - Jongleur {r.Display}",
        };

    private int ComputeLength(PatternRotation rotation) =>
        rotation == PatternRotation.Global
            ? Math.Max(1, Period)
            : Math.Max(1, new Period(Period).GetLocalPeriod(NumberOfJugglers).Value);

    private void ResizePatternToCurrentLength()
    {
        var length = ComputeLength(Value.PatternRotation);
        if (Value.Pattern.Count == length)
        {
            return;
        }

        var fallback = PossibleThrows.FirstOrDefault() ?? Throw.Empty;
        var resized = Enumerable
            .Range(0, length)
            .Select(i => i < Value.Pattern.Count ? Value.Pattern[i] : fallback)
            .ToList();
        Value.Pattern.Clear();
        Value.Pattern.AddRange(resized);
        if (_activeSlotIndex >= length)
        {
            _activeSlotIndex = 0;
        }
    }

    private async Task OnRotationChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v))
        {
            return;
        }

        // NewPatternFilterInformation has two rotation-ish properties (the positional
        // "PatternRotation" and the explicit mutable "Rotation" used by the real app's own
        // EasyPatternFilter binding). FilterTranslation only reads "PatternRotation", so that's
        // the one we keep authoritative here; a plain `with` keeps everything else untouched.
        Value = Value with { PatternRotation = new PatternRotation(v) };
        ResizePatternToCurrentLength();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task SetInclude(bool include)
    {
        Value = Value with { IsIncludePattern = include };
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnValidLocallyChanged(ChangeEventArgs e)
    {
        Value = Value with { IsValidLocally = e.Value is true };
        await ValueChanged.InvokeAsync(Value);
    }

    private void SelectSlot(int index) => _activeSlotIndex = index;

    private async Task AssignActiveSlot(Throw t)
    {
        if (_activeSlotIndex < 0 || _activeSlotIndex >= Value.Pattern.Count)
        {
            return;
        }

        Value.Pattern[_activeSlotIndex] = t;
        _activeSlotIndex = Math.Min(_activeSlotIndex + 1, Value.Pattern.Count - 1);
        await ValueChanged.InvokeAsync(Value);
    }
}
