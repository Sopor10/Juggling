@using Siteswaps.Generator.Components.Internal.EasyFilter
@using Siteswaps.Generator.Components.State
@using Siteswaps.Generator.Components.State.FilterTrees
@using Siteswaps.Generator.Core.Generator

@if (WizardFilterTree.IsEmpty(Tree))
{
    <p class="wizard-filters-empty">Noch keine Filter – das Muster ist noch unbeschränkt.</p>
}
else
{
    <div class="wizard-filter-groups" role="list">
        @RenderNode(Tree.Root!, isRoot: true)
    </div>
    <p class="wizard-filters-hint">Gruppen können UND/ODER mischen und ineinander geschachtelt werden.</p>
}

@code {
    [Parameter, EditorRequired]
    public FilterTree Tree { get; set; } = new(null);

    [Parameter]
    public EventCallback<WizardFilterEntry> Edit { get; set; }

    [Parameter]
    public EventCallback<int> RemoveRequested { get; set; }

    [Parameter]
    public EventCallback<FilterNode?> AddInGroup { get; set; }

    [Parameter]
    public EventCallback<FilterTree> TreeChanged { get; set; }

    private RenderFragment RenderNode(FilterNode node, bool isRoot) => builder =>
    {
        switch (node)
        {
            case FilterLeaf leaf:
                builder.AddContent(0, RenderLeaf(leaf));
                break;
            case AndNode andNode:
                builder.AddContent(1, RenderGroup(andNode, isOr: false, isRoot));
                break;
            case OrNode orNode:
                builder.AddContent(2, RenderGroup(orNode, isOr: true, isRoot));
                break;
        }
    };

    private RenderFragment RenderLeaf(FilterLeaf leaf) => __builder =>
    {
        var identified = leaf.Filter as WizardIdentifiedFilter;
        var id = identified?.Id ?? 0;
        var inner = WizardFilterTree.Unwrap(leaf.Filter);
        var desc = Describe(inner);
        <div class="wizard-filter-card" role="listitem">
            <div class="wizard-filter-desc">@desc</div>
            <button type="button" class="wizard-icon-btn"
                    aria-label="Bearbeiten: @desc"
                    @onpointerdown:stopPropagation="true"
                    @onclick="() => Edit.InvokeAsync(new WizardFilterEntry(id, inner))">✎</button>
            <button type="button" class="wizard-icon-btn wizard-icon-btn-danger"
                    aria-label="Entfernen: @desc"
                    @onpointerdown:stopPropagation="true"
                    @onclick="() => RemoveRequested.InvokeAsync(id)">✕</button>
        </div>
    };

    private RenderFragment RenderGroup(FilterNode group, bool isOr, bool isRoot) => __builder =>
    {
        var children = group switch
        {
            AndNode andNode => andNode.Children,
            OrNode orNode => orNode.Children,
            _ => [],
        };
        var opLabel = isOr ? "ODER" : "UND";
        var opHint = isOr
            ? "ODER – antippen für UND"
            : "UND – antippen für ODER";

        <div class="wizard-filter-group @(isRoot ? "wizard-filter-group-root" : null)" role="group" aria-label="Filtergruppe @opLabel">
            <div class="wizard-filter-group-header">
                <button type="button" class="wizard-pill @(isOr ? "wizard-connector-or" : "wizard-connector-and")"
                        @onpointerdown:stopPropagation="true"
                        aria-label="@opHint"
                        @onclick="() => ToggleGroup(group)">@opLabel</button>
            </div>

            @for (var i = 0; i < children.Count; i++)
            {
                var index = i;
                var child = children[index];
                @if (index > 0)
                {
                    <div class="wizard-connector-row wizard-connector-row-and">
                        <span class="wizard-group-op-label">@opLabel</span>
                        <button type="button" class="wizard-wrap-btn"
                                @onpointerdown:stopPropagation="true"
                                aria-label="Vorherige und diese Zeile einklammern"
                                title="Einklammern"
                                @onclick="() => WrapAt(group, index - 1)">⊂</button>
                    </div>
                }
                @RenderNode(child, isRoot: false)
            }

            <button type="button" class="wizard-add-in-group-btn"
                    @onpointerdown:stopPropagation="true"
                    @onclick="() => AddInGroup.InvokeAsync(group)">+ Filter in Gruppe</button>
        </div>
    };

    private async Task ToggleGroup(FilterNode group)
    {
        await TreeChanged.InvokeAsync(WizardFilterTree.ToggleGroupOperator(Tree, group));
    }

    private async Task WrapAt(FilterNode parent, int childIndex)
    {
        await TreeChanged.InvokeAsync(WizardFilterTree.WrapAdjacentChildren(Tree, parent, childIndex));
    }

    private static string Describe(IFilterInformation filter) =>
        filter switch
        {
            EasyNumberFilter.NumberFilter numberFilter => DescribeNumber(numberFilter),
            NewPatternFilterInformation patternFilter => DescribePattern(patternFilter),
            EasyStateFilter.StateFilter stateFilter => DescribeState(stateFilter),
            _ => filter.Display(),
        };

    private static string DescribeNumber(EasyNumberFilter.NumberFilter filter)
    {
        var comparison = filter.Type switch
        {
            EasyNumberFilter.NumberFilterType.Exactly => "Genau",
            EasyNumberFilter.NumberFilterType.Maximum => "Maximal",
            EasyNumberFilter.NumberFilterType.AtLeast => "Mindestens",
            _ => "",
        };
        return $"{comparison} {filter.Amount}× {filter.Throw.GetDisplayValue(true)}";
    }

    private static string DescribePattern(NewPatternFilterInformation filter)
    {
        var sequence = filter.Pattern.Count == 0
            ? "leer"
            : string.Join(" ", filter.Pattern.Select(t => t.GetDisplayValue(true)));
        var verb = filter.IsIncludePattern ? "enthält" : "ohne";
        return $"Muster {verb} „{sequence}“ · {filter.PatternRotation.Display}";
    }

    private static string DescribeState(EasyStateFilter.StateFilter filter) =>
        $"Zustand · {filter.Notation()}";
}
