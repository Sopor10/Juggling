@using Siteswaps.Generator.Core.Generator
@inject IStringLocalizer<ThrowsChipGrid> L

<div class="wizard-throws">
    <div class="wizard-throws-header">
        <p class="wizard-section-label">@L["Allowed throws"]</p>
    </div>
    <div class="wizard-chip-grid" role="group" aria-label="@L["Allowed throws"]">
        @foreach (var t in AllThrows)
        {
            var isActive = Selected.Any(x => x.Height == t.Height);
            <button type="button"
                    class="wizard-chip @(isActive ? "active" : "")"
                    aria-pressed="@(isActive ? "true" : "false")"
                    title="@L["{0} (height {1})", t.Name, t.Height]"
                    @onpointerdown:stopPropagation="true"
                    @onclick="() => Toggle(t)">
                @t.GetDisplayValue(true)
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public List<Throw> Selected { get; set; } = new();

    [Parameter]
    public int MaxHeight { get; set; } = 13;

    [Parameter]
    public EventCallback SelectionChanged { get; set; }

    private IEnumerable<Throw> AllThrows => Throw.All(MaxHeight);

    private async Task Toggle(Throw t)
    {
        var existing = Selected.FirstOrDefault(x => x.Height == t.Height);
        if (existing is not null)
        {
            Selected.Remove(existing);
        }
        else
        {
            Selected.Add(t);
        }

        await SelectionChanged.InvokeAsync();
    }
}
