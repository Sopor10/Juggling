@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<ProgressDots> L

<div class="wizard-dots" role="tablist" aria-label="@L["Progress: step {0} of {1}", Current + 1, Total]">
    @for (var i = 0; i < Total; i++)
    {
        var step = i;
        var isDone = Visited.Contains(step) && step != Current;
        var isActive = step == Current;
        var isReachable = Visited.Contains(step);
        var stepLabel = step == Total - 1 && Total > 1
            ? L["Results"].Value
            : L["Step {0}", step + 1].Value;
        <button id="wizard-step-tab-@step" type="button" class="wizard-dot @(isActive ? "active" : "") @(isDone ? "done" : "")"
                role="tab" aria-selected="@(isActive ? "true" : "false")"
                aria-controls="wizard-panel-@step"
                tabindex="@(isActive ? "0" : "-1")"
                aria-label="@stepLabel"
                disabled="@(!isReachable)"
                @onpointerdown:stopPropagation="true"
                @onkeydown="e => OnKeyDown(e, step)"
                @onclick="() => Jump(step)"></button>
    }
</div>

@code {
    [Parameter]
    public int Total { get; set; }

    [Parameter]
    public int Current { get; set; }

    [Parameter]
    public IReadOnlySet<int> Visited { get; set; } = new HashSet<int>();

    [Parameter]
    public EventCallback<int> StepSelected { get; set; }

    private IJSObjectReference? _jsModule;
    private int? _focusTarget;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Siteswaps.Generator/Components/WizardPage/WizardPage.razor.js");
        }

        if (_focusTarget is { } target && _jsModule is not null)
        {
            _focusTarget = null;
            await _jsModule.InvokeVoidAsync("focusElement", $"wizard-step-tab-{target}");
        }
    }

    private async Task Jump(int step)
    {
        if (Visited.Contains(step) && step != Current)
        {
            await StepSelected.InvokeAsync(step);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e, int step)
    {
        var target = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => Math.Min(Total - 1, step + 1),
            "ArrowLeft" or "ArrowUp" => Math.Max(0, step - 1),
            "Home" => 0,
            "End" => Total - 1,
            _ => -1,
        };

        if (target >= 0 && Visited.Contains(target))
        {
            await StepSelected.InvokeAsync(target);
            _focusTarget = target;
            await InvokeAsync(StateHasChanged);
        }
    }
}
