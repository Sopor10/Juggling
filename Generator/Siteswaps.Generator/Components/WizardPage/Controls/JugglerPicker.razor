@inject IStringLocalizer<JugglerPicker> L

<PeriodStepper Value="Value"
               ValueChanged="ValueChanged"
               Min="Min"
               Max="Max"
               DecreaseLabel="@L["Decrease jugglers"]"
               IncreaseLabel="@L["Increase jugglers"]"
               ValueLabel="@L["Enter juggler count exactly"]" />

@code {
    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    [Parameter]
    public int Min { get; set; } = WizardState.MinJugglers;

    [Parameter]
    public int Max { get; set; } = WizardState.MaxJugglersExact;
}
