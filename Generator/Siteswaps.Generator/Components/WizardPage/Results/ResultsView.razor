@using Siteswaps.Generator.Components.Internal

<div class="wizard-results">
    <div class="wizard-results-header">
        <h2 class="wizard-results-title">
            @if (IsGenerating)
            {
                <text>Generiere…</text>
            }
            else
            {
                <text>@Results.Count Ergebnis@(Results.Count == 1 ? "" : "se")</text>
            }
        </h2>
        @if (IsGenerating)
        {
            <button type="button" class="wizard-btn-ghost" @onclick="Cancel">Abbrechen</button>
        }
    </div>

    @if (IsGenerating && Results.Count == 0)
    {
        <div class="wizard-spinner" role="status" aria-live="polite" aria-label="Generiere Ergebnisse">
            <div class="wizard-spinner-dot"></div>
            <div class="wizard-spinner-dot"></div>
            <div class="wizard-spinner-dot"></div>
        </div>
    }
    else if (!IsGenerating && Results.Count == 0)
    {
        <p class="wizard-filters-empty">Keine passenden Muster gefunden. Versuche es mit anderen Einstellungen oder weniger Filtern.</p>
    }
    else
    {
        @if (IsGenerating)
        {
            <p class="wizard-loading-more" role="status" aria-live="polite">Lädt weitere Ergebnisse…</p>
        }
        <div class="wizard-results-grid" role="list">
            @foreach (var s in Results.Take(_visibleResultCount))
            {
                <SiteswapCard Siteswap="s" NumberOfJugglers="NumberOfJugglers" />
            }
        </div>
        @if (!IsGenerating && _visibleResultCount < Results.Count)
        {
            <button type="button" class="wizard-btn-ghost wizard-load-more" @onclick="LoadMore">
                Mehr laden (@Math.Min(_visibleResultCount, Results.Count) von @Results.Count)
            </button>
        }
    }

    @if (!IsGenerating)
    {
        <div class="wizard-results-actions">
            <button type="button" class="wizard-btn-ghost" @onclick="BackToEditing">Filter anpassen</button>
            <button type="button" class="wizard-btn-primary wizard-flex-1" @onclick="StartOver">Neue Suche</button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<Siteswap> Results { get; set; } = new();

    [Parameter]
    public bool IsGenerating { get; set; }

    [Parameter]
    public int NumberOfJugglers { get; set; }

    [Parameter]
    public EventCallback CancelRequested { get; set; }

    [Parameter]
    public EventCallback BackToEditingRequested { get; set; }

    [Parameter]
    public EventCallback StartOverRequested { get; set; }

    private Task Cancel() => CancelRequested.InvokeAsync();

    private Task BackToEditing() => BackToEditingRequested.InvokeAsync();

    private Task StartOver() => StartOverRequested.InvokeAsync();

    private int _visibleResultCount = BatchSize;
    private const int BatchSize = 40;

    protected override void OnParametersSet()
    {
        if (_visibleResultCount == 0 || Results.Count <= BatchSize || _visibleResultCount > Results.Count)
        {
            _visibleResultCount = Math.Min(BatchSize, Results.Count);
        }
    }

    private void LoadMore() => _visibleResultCount = Math.Min(_visibleResultCount + BatchSize, Results.Count);
}
