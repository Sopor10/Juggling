@page "/siteswap-lab"
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.AspNetCore.Components.Web
@using Siteswaps.Generator.Components.Feeding
@using Siteswaps.Generator.Components.WizardPage.Controls
@using Siteswaps.Generator.Core.Generator
@using Siteswaps.Components.Details.Diagrams
@using Siteswaps.Components.CausalDiagram
@using Siteswaps.Jif.Components.Navigation
@using Siteswaps.Components.Details
@using Siteswaps.Jif.Components
@using System.Text.Json
@inject IStringLocalizer<SiteswapLabPage> L
@inject ILocalStorageService LocalStorage
@inject UrlStateNavigation UrlStateNavigation

<PageTitle>@L["Siteswap lab"]</PageTitle>

<SectionContent SectionName="@WizardShellSections.Header">
    <ProgressDots Total="2"
                  Current="_cellsStep"
                  Visited="_visitedCellsSteps"
                  StepSelected="SelectCellsStep" />
    <p class="wizard-swipe-hint">@L["← swipe left/right →"]</p>
</SectionContent>

<SectionContent SectionName="@WizardShellSections.Body">
    <div class="wizard-steps">
        <div class="wizard-sr-only" aria-live="polite">@StepAnnouncement</div>

        <WizardStepPanel StepIndex="0" IsActive="@IsStepActive(0)">
            <div class="wizard-measure">
                <div class="lab-config" aria-label="@L["Passing configuration"]">
                        <div class="lab-config-field">
                            <span>@L["People"]</span>
                            <PeriodStepper Value="_direct.People.Count"
                                           ValueChanged="SetPersonCount"
                                           Min="PassingEditorState.MinPeople"
                                           Max="PassingEditorState.MaxPeople"
                                           DecreaseLabel="@L["Remove person, People"]"
                                           IncreaseLabel="@L["Add person, People"]"
                                           ValueLabel="@L["People"]" />
                        </div>
                        <div class="lab-config-field">
                            <span>@L["Period"]</span>
                            <PeriodStepper Value="_direct.Period"
                                           ValueChanged="SetPeriod"
                                           Min="1"
                                           Max="Siteswap.MaxPeriodLength"
                                           DecreaseLabel="@L["Remove last beat, Period"]"
                                           IncreaseLabel="@L["Append beat, Period"]"
                                           ValueLabel="@L["Period"]" />
                        </div>
                    </div>

                    <div class="lab-timezones"
                         style="@($"--lab-phase-count:{_direct.PhaseCount}")">
                        <h3>@L["People and TimeZones"]</h3>
                        <p class="lab-timezone-hint">@L["People in the same timezone throw synchronously"]</p>
                        <div class="lab-timezone-table-wrap">
                        <table class="lab-timezone-table">
                            <thead>
                                <tr>
                                    <th scope="col" class="lab-timezone-corner"></th>
                                    @for (var phase = 0; phase < _direct.PhaseCount; phase++)
                                    {
                                        <th scope="col"
                                            class="lab-timezone-phase"
                                            style="@($"--lab-phase:{phase};--lab-phase-count:{_direct.PhaseCount}")">
                                            <span class="lab-timezone-phase-marker" aria-hidden="true"></span>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (var person = 0; person < _direct.People.Count; person++)
                                {
                                    var personIndex = person;
                                    var personTimeZone = _direct.People[person].TimeZone;
                                    <tr class="lab-timezone-row"
                                        role="button"
                                        tabindex="0"
                                        aria-label="@L[
                                            "{0}, TimeZone {1}. Tap for next phase.",
                                            _direct.People[person].Name,
                                            personTimeZone
                                        ]"
                                        @onclick="() => CycleTimeZone(personIndex)"
                                        @onkeydown="e => OnTimeZoneRowKeyDown(e, personIndex)">
                                        <th scope="row" class="lab-timezone-row-label">
                                            @_direct.People[person].Name
                                        </th>
                                        @for (var phase = 0; phase < _direct.PhaseCount; phase++)
                                        {
                                            if (personTimeZone == phase)
                                            {
                                                <td class="lab-timezone-cell lab-timezone-cell-active"
                                                    data-timezone="@phase"
                                                    style="@($"--lab-phase:{phase};--lab-phase-count:{_direct.PhaseCount}")"
                                                    aria-hidden="true">
                                                    <span class="lab-timezone-marker">@phase</span>
                                                </td>
                                            }
                                            else
                                            {
                                                <td aria-hidden="true"></td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                </div>
            </div>
        </WizardStepPanel>

        <WizardStepPanel StepIndex="1" IsActive="@IsStepActive(1)">
            <div class="wizard-measure">
                    <div class="lab-passing-overview" @ref="_dragScope" style="@($"--lab-period:{_direct.Period}")">
                        <PatternTable Rows="LabTableRows" Class="lab-pattern-table" RowClass="lab-overview-row"
                                      RowClassFor="LabRowClass"
                                      MetaClass="lab-overview-meta"
                                      StartClubsClass="lab-start-props" StartClubsHandClass="lab-start-props-hand" ThrowsClass="lab-overview-throws">
                            <Toolbar>
                                <div class="lab-overview-toolbar">
                                    <div class="lab-overview-toolbar-group">
                                        <span class="lab-overview-toolbar-label" id="lab-rotation-label">@L["Rotate starting position"]</span>
                                        <div class="lab-overview-rotation" role="group" aria-labelledby="lab-rotation-label">
                                            <button type="button" class="lab-rotate" aria-label="@L["Rotate pattern left"]" disabled="@(_direct.Period <= 1)" @onclick="() => Rotate(1)">◄</button>
                                            <button type="button" class="lab-rotate" aria-label="@L["Rotate pattern right"]" disabled="@(_direct.Period <= 1)" @onclick="() => Rotate(-1)">►</button>
                                        </div>
                                    </div>
                                </div>
                            </Toolbar>
                            <LabelTemplate Context="tableRow">
                                @{ var personIndex = PersonIndex(tableRow.Label); }
                                <div class="lab-overview-person" aria-label="@($"{tableRow.Label}, {L["TimeZone {0}", _direct.People[personIndex].TimeZone]}")">
                                    <strong aria-hidden="true">@tableRow.Label</strong>
                                </div>
                            </LabelTemplate>
                            <RowTemplate Context="tableRow">
                                @{ var personIndex = PersonIndex(tableRow.Label); }
                                    <FeedingThrowChipRow Chips="PassingChipsFor(personIndex)"
                                                         AriaLabel="@L["Throws {0}", tableRow.Label]"
                                                         SelectedLocalBeat="@SelectedBeatFor(personIndex)"
                                                         LandingLocalBeat="@LandingBeatFor(personIndex)"
                                                         EnableDragDrop="true"
                                                         ShowPassDestinations="_showPassDestinations"
                                                         RowPersonIndex="@personIndex"
                                                         DragScope="_dragScope"
                                                         ShowHeightSteppers="@(_direct.HasSelection && _direct.SelectedPerson == personIndex)"
                                                         CanIncreaseHeight="@CanIncreaseSelectedHeight(personIndex)"
                                                         CanDecreaseHeight="@CanDecreaseSelectedHeight(personIndex)"
                                                         HeightIncreaseAriaLabel="@L["Increase throw"].Value"
                                                         HeightDecreaseAriaLabel="@L["Decrease throw"].Value"
                                                         HeightIncreaseRequested="IncreaseSelectedHeight"
                                                         HeightDecreaseRequested="DecreaseSelectedHeight"
                                                         TargetPills="SelectedTargetPillsFor(personIndex)"
                                                         SelectedTargetPerson="@SelectedTargetPersonFor(personIndex)"
                                                         TargetGroupAriaLabel="@SelectedTargetGroupAriaLabel(personIndex)"
                                                         TargetPillAriaLabel="SelectedTargetPillAriaLabel"
                                                         TargetPersonSelected="OnSelectedTargetPersonChanged"
                                                         DragSourceBeat="@DragSourceBeatFor(personIndex)"
                                                         ActiveDragSourcePerson="@_dragSourcePerson"
                                                         ActiveDragSourceBeat="@_dragSourceBeat"
                                                         DropTargetBeat="@DropTargetBeatFor(personIndex)"
                                                         IsValidDropTarget="beat => IsValidDropTargetForDrag(personIndex, beat)"
                                                         ChipClicked="beat => OnChipClicked(personIndex, beat)"
                                                         ChipDragStarted="beat => OnChipDragStarted(personIndex, beat)"
                                                         ChipDragEntered="beat => OnChipDragEntered(personIndex, beat)"
                                                         ChipDragTargetEntered="OnChipDragTargetEntered"
                                                         ChipDropped="beat => OnChipDropped(personIndex, beat)"
                                                         ChipDragTargetDropped="OnChipDragTargetDropped"
                                                         ChipDragEnded="OnChipDragEnded"
                                                         AccessibleName="chip => PassingChipAccessibleName(personIndex, chip)"
                                                         StateClass="chip => PassingChipStateClass(personIndex, chip.LocalBeat)"
                                                         KindName="PassingKindName" />
                            </RowTemplate>
                            <Legend>
                                <div class="lab-pattern-footer">
                                    <button type="button" class="lab-legend-toggle" aria-expanded="@_showThrowLegend" @onclick="() => _showThrowLegend = !_showThrowLegend">
                                        @(_showThrowLegend ? "Legende ausblenden" : "Legende einblenden")
                                    </button>
                                    <button type="button" class="lab-destination-toggle @(_showPassDestinations ? "active" : null)"
                                            aria-pressed="@_showPassDestinations" @onclick="TogglePassDestinationsAsync">
                                        @L["Pass destinations"]
                                    </button>
                                    <FeedingThrowDisplayModeToggle Mode="_throwDisplayMode" ModeChanged="OnThrowDisplayModeChanged" />
                                </div>
                                @if (_showThrowLegend)
                                {
                                    <ul class="lab-chip-legend" aria-label="@L["Throw state legend"]">
                                        <li><span class="lab-start-props lab-start-props-legend" aria-hidden="true"><span class="lab-start-props-hand">L</span><span class="lab-start-props-hand">R</span></span><span>@L["Start clubs"]</span></li>
                                        <li><span class="feeding-beat self" aria-hidden="true">·</span><span>@L["Self"]</span></li>
                                        <li><span class="feeding-beat pass" aria-hidden="true">·</span><span>@L["Pass"]</span></li>
                                        <li><span class="feeding-beat self is-selected" aria-hidden="true">·</span><span>@L["Selected throw"]</span></li>
                                        <li><span class="feeding-beat self is-landing" aria-hidden="true">·</span><span>@L["Landing target"]</span></li>
                                        <li><span class="feeding-beat self is-incoming" aria-hidden="true">·</span><span>@L["Incoming throw"]</span></li>
                                        <li><span class="feeding-beat self collision" aria-hidden="true">!</span><span>@L["Collision"]</span></li>
                                        <li><span class="feeding-beat self unfilled" aria-hidden="true">○</span><span>@L["No incoming throw"]</span></li>
                                    </ul>
                                }
                            </Legend>
                        </PatternTable>
                    </div>
                    @if (_direct.ThrowsInitialized)
                    {
                        var jifJson = PassingJifJson;
                        <section class="lab-jif" aria-label="JIF animation">
                            <h3>JIF-Animation</h3>
                            @if (_passingJifError is null)
                            {
                                <PassistAnimation Jif="@(new JifInput.Json(jifJson))"
                                                  ShowSpeedLabel="false"
                                                  JugglerNames="@(_direct.People.Select(person => person.Name).ToArray())"
                                                  TimeZones="@(_direct.People.Select(person => person.TimeZone).ToArray())"
                                                  LayoutPoses="_layoutPoses"
                                                  LayoutPreset="_layoutPreset"
                                                  LayoutChanged="OnLayoutChanged" />
                                <JifCopyButton JifJson="jifJson" />
                                <section class="jif-causal-diagram" aria-label="Kausales Diagramm">
                                    <h3 class="sdv-section-title">Kausales Diagramm</h3>
                                    <CausalDiagramEditorView Embedded="true"
                                                              ExternalState="@PassingDiagramState"
                                                              ShowOptions="false"
                                                              ShowAnimation="false"
                                                              AllowNodeMove="false"
                                                              AllowThrowActions="false"
                                                              AllowJugglerActions="false"
                                                              AllowArrowEditing="false"
                                                              ShowConnectionIssues="false" />
                                </section>
                            }
                            else
                            {
                                <p role="alert">Dieses Muster hat keinen periodisch darstellbaren JIF-Prop-Fluss: @_passingJifError</p>
                            }
                        </section>
                    }
            </div>
        </WizardStepPanel>
    </div>
</SectionContent>

<SectionContent SectionName="@WizardShellSections.Footer">
    <div class="wizard-nav">
        <div class="wizard-measure">
            @if (NextPreviewText is not null)
            {
                <p class="wizard-next-preview">@NextPreviewText</p>
            }
            <div class="wizard-nav-buttons">
                <button type="button"
                        class="wizard-btn-ghost wizard-back-btn @(_cellsStep == 0 ? "wizard-invisible" : "")"
                        disabled="@(_cellsStep == 0)"
                        @onclick="ReturnToPeopleStep">@L["Back"]</button>
                @if (_cellsStep == 0)
                {
                    <button type="button"
                            class="wizard-flex-1 wizard-btn-primary"
                            disabled="@(!CanEnterThrows)"
                            @onclick="EnterThrowsStep">@L["Next"]</button>
                }
            </div>
        </div>
    </div>
</SectionContent>

@code {
    private const int CellsStepCount = 2;
    private PassingEditorState _direct = new();
    private JugglerLayoutPose[] _layoutPoses = [];
    private string _layoutPreset = "w-v";
    private FeedingThrowDisplay.Mode _throwDisplayMode = FeedingThrowDisplay.Mode.Global;
    private readonly HashSet<int> _visitedCellsSteps = [0];
    private int _cellsStep;
    [Parameter, SupplyParameterFromQuery(Name = "state")]
    public string? StateQuery { get; set; }
    private ElementReference _dragScope;
    private int? _dragSourcePerson;
    private int? _dragSourceBeat;
    private int? _dropTargetPerson;
    private int? _dropTargetBeat;
    private string? _passingJifError;
    private bool _showThrowLegend;
    private bool _showPassDestinations;
    private bool _stateInitialized;
    private string? _lastAppliedState;

    private string PassingJifJson
    {
        get
        {
            try
            {
                _passingJifError = null;
                return SiteswapLabJifMapper.MapViaCausalDiagram(
                    _direct.People.Select(person => person.TimeZone).ToArray(),
                    _direct.People.Select(person => (IReadOnlyList<int>)person.Cells.Select(cell => cell.Height).ToArray()).ToArray(),
                    _direct.People.Select((person, index) => (IReadOnlyList<int>)person.Cells.Select(cell => cell.TargetPerson ?? index).ToArray()).ToArray(),
                    propType: "club",
                    layout: _layoutPoses
                );
            }
            catch (ArgumentException exception)
            {
                _passingJifError = exception.Message;
            }
            catch (InvalidOperationException exception)
            {
                _passingJifError = exception.Message;
            }

            return "{}";
        }
    }

    private CausalDiagramEditorState PassingDiagramState => CausalDiagramEditorState.CreatePassingPattern(
        _direct.People.Select(person => person.TimeZone).ToArray(),
        _direct.People.Select(person => (IReadOnlyList<int>)person.Cells.Select(cell => cell.Height).ToArray()).ToArray(),
        _direct.People.Select((person, index) => (IReadOnlyList<int>)person.Cells.Select(cell => cell.TargetPerson ?? index).ToArray()).ToArray()
    );

    private IReadOnlyList<PatternTable.PatternRow> LabTableRows
    {
        get
        {
            var causalStarts = SiteswapLabJifMapper.CalculateCausalStartProps(
                _direct.People.Select(person => person.TimeZone).ToArray(),
                _direct.People.Select(person => (IReadOnlyList<int>)person.Cells.Select(cell => cell.Height).ToArray()).ToArray(),
                _direct.People.Select((person, index) =>
                    (IReadOnlyList<int>)person.Cells.Select(cell => cell.TargetPerson ?? index).ToArray()).ToArray()
            );
            return _direct.People.Select((person, index) =>
            {
                causalStarts.TryGetValue(person.Name, out var clubs);
                return new PatternTable.PatternRow(
                    person.Name,
                    Phase: _direct.TimelinePhaseFor(index),
                    PhaseCount: _direct.ActiveTimeZoneCount,
                    LeftClubs: clubs?.Left,
                    RightClubs: clubs?.Right,
                    TimeZone: person.TimeZone,
                    StartClubsAriaLabel: clubs is null
                        ? null
                        : L["Start clubs {0}: left {1}, right {2}", person.Name, clubs.Left, clubs.Right].Value
                );
            }).ToList();
        }
    }

    private int PersonIndex(string label) =>
        _direct.People.Select((person, index) => (person, index)).First(item => item.person.Name == label).index;

    private string? LabRowClass(PatternTable.PatternRow row) =>
        _direct.HasSelection && PersonIndex(row.Label) == _direct.SelectedPerson ? "is-editing-throw" : null;

    protected override async Task OnInitializedAsync()
    {
        var settings = await LocalStorage.GetItemAsync<SettingsDto>("settings");
        _direct = new PassingEditorState(maxThrowHeight: settings?.MaxHeight);
        _throwDisplayMode = FeedingThrowDisplay.ParseMode(settings?.ThrowDisplayMode);
        _showPassDestinations = settings?.ShowPassDestinations ?? false;
        var restored = TryRestoreState(StateQuery, settings?.MaxHeight);
        _stateInitialized = true;
        _lastAppliedState = StateQuery;
        if (!restored)
        {
            ApplyLayoutPreset("w-v", save: false);
            SaveStateToUrl(replace: true);
        }
    }

    protected override void OnParametersSet()
    {
        if (!_stateInitialized || string.Equals(StateQuery, _lastAppliedState, StringComparison.Ordinal))
        {
            return;
        }

        _lastAppliedState = StateQuery;
        if (string.IsNullOrWhiteSpace(StateQuery))
        {
            return;
        }

        TryRestoreState(StateQuery, _direct.MaxThrowHeight);
    }
    private void SetPersonCount(int count)
    {
        _direct.SetPersonCount(count);
        RebuildLayoutForCurrentPreset();
        SaveStateToUrl();
    }

    private void CycleTimeZone(int person)
    {
        _direct.CycleTimeZone(person);
        RebuildLayoutForCurrentPreset();
        SaveStateToUrl();
    }

    private void Rotate(int steps)
    {
        _direct.Rotate(steps);
        SaveStateToUrl();
    }

    private void OnThrowDisplayModeChanged(FeedingThrowDisplay.Mode mode)
    {
        _throwDisplayMode = mode;
        SaveStateToUrl();
    }

    private void SetPeriod(int period)
    {
        while (_direct.Period < period)
        {
            _direct.AddBeat();
        }

        while (_direct.Period > period)
        {
            _direct.RemoveBeat();
        }

        SaveStateToUrl();
    }

    private bool CanEnterThrows => _direct.People.Count >= PassingEditorState.MinPeople;

    private string StepTitle(int step) =>
        step switch
        {
            0 => L["People + TimeZones"],
            1 => L["Throws"],
            _ => string.Empty,
        };

    private bool IsStepActive(int step) => _cellsStep == step;

    private string StepAnnouncement =>
        L["Step {0} / {1}: {2}", _cellsStep + 1, CellsStepCount, StepTitle(_cellsStep)];

    private string? NextPreviewText =>
        _cellsStep == 0 ? L["Next: {0}", StepTitle(1)].Value : null;

    private void EnterThrowsStep()
    {
        if (!CanEnterThrows)
        {
            return;
        }

        _direct.InitializeThrowsForFirstEntry();
        _direct.SelectCell(0, 0);
        _visitedCellsSteps.Add(1);
        _cellsStep = 1;
        SaveStateToUrl();
    }

    private void ReturnToPeopleStep()
    {
        _cellsStep = 0;
        SaveStateToUrl();
    }

    private void SelectCellsStep(int step)
    {
        if (step == 1)
        {
            EnterThrowsStep();
            return;
        }

        if (step == 0)
        {
            ReturnToPeopleStep();
        }
    }

    private void OnChipClicked(int person, int beat)
    {
        if (
            _direct.HasSelection
            && _direct.SelectedPerson == person
            && _direct.SelectedBeat == beat
        )
        {
            _direct.ToggleCellSelection(person, beat);
            SaveStateToUrl();
            return;
        }

        _direct.SelectCell(person, beat);
        SaveStateToUrl();
    }

    private void OnChipDragStarted(int person, int beat)
    {
        if (_dragSourcePerson == person && _dragSourceBeat == beat)
        {
            return;
        }

        if (_dragSourcePerson is not null && _dragSourceBeat is not null)
        {
            return;
        }

        _dragSourcePerson = person;
        _dragSourceBeat = beat;
        _dropTargetPerson = null;
        _dropTargetBeat = null;
    }

    private void OnChipDragEntered(int person, int beat) =>
        ApplyDragTarget(person, beat);

    private void OnChipDragTargetEntered(FeedingThrowChipDragTarget target) =>
        ApplyDragTarget(target.Person, target.Beat);

    private void ApplyDragTarget(int person, int beat)
    {
        if (_dragSourcePerson is null || _dragSourceBeat is null)
        {
            return;
        }

        if (beat < 0)
        {
            if (person < 0 || _dropTargetPerson == person)
            {
                _dropTargetPerson = null;
                _dropTargetBeat = null;
            }

            return;
        }

        _dropTargetPerson = person;
        _dropTargetBeat = beat;
    }

    private void OnChipDragTargetDropped(FeedingThrowChipDragTarget target) =>
        OnChipDropped(target.Person, target.Beat);

    private void OnChipDropped(int person, int beat)
    {
        if (_dragSourcePerson is not int sourcePerson || _dragSourceBeat is not int sourceBeat)
        {
            return;
        }

        _direct.ApplyChipDrop(sourcePerson, sourceBeat, person, beat);
        ClearDragState();
        SaveStateToUrl();
    }

    private void OnChipDragEnded()
    {
        if (_dragSourcePerson is int sourcePerson && _dragSourceBeat is int sourceBeat)
        {
            _direct.SelectCell(sourcePerson, sourceBeat);
        }

        ClearDragState();
    }

    private void ClearDragState()
    {
        _dragSourcePerson = null;
        _dragSourceBeat = null;
        _dropTargetPerson = null;
        _dropTargetBeat = null;
    }

    private int? DragSourceBeatFor(int person) =>
        _dragSourcePerson == person ? _dragSourceBeat : null;

    private int? DropTargetBeatFor(int person) =>
        _dropTargetPerson == person ? _dropTargetBeat : null;

    private bool IsValidDropTargetForDrag(int person, int beat)
    {
        if (_dragSourcePerson is not int sourcePerson || _dragSourceBeat is not int sourceBeat)
        {
            return false;
        }

        return _direct.CanSetLandingTarget(sourcePerson, sourceBeat, person, beat);
    }

    private int? SelectedBeatFor(int person) =>
        _direct.HasSelection && _direct.SelectedPerson == person ? _direct.SelectedBeat : null;

    private PassingEditorCell SelectedPassingCell =>
        _direct.People[_direct.SelectedPerson].Cells[_direct.SelectedBeat];

    private PassingEditorLanding SelectedPassingLanding => _direct.SelectedLanding;

    private void IncreaseSelectedHeight() => AdjustPassingHeight(1);

    private void DecreaseSelectedHeight() => AdjustPassingHeight(-1);

    private void OnSelectedTargetPersonChanged(int target)
    {
        _direct.SetTarget(_direct.SelectedPerson, _direct.SelectedBeat, target);
        SaveStateToUrl();
    }

    private IReadOnlyList<FeedingThrowChipTargetPill> SelectedTargetPillsFor(int person)
    {
        if (!_direct.HasSelection || _direct.SelectedPerson != person)
        {
            return [];
        }

        return _direct
            .AvailableTargetsFor(
                _direct.SelectedPerson,
                _direct.SelectedBeat,
                SelectedPassingCell.Height
            )
            .Select(index => new FeedingThrowChipTargetPill(index, _direct.People[index].Name))
            .ToArray();
    }

    private int? SelectedTargetPersonFor(int person) =>
        _direct.HasSelection && _direct.SelectedPerson == person
            ? SelectedPassingCell.TargetPerson
            : null;

    private string? SelectedTargetGroupAriaLabel(int person)
    {
        if (!_direct.HasSelection || _direct.SelectedPerson != person)
        {
            return null;
        }

        return L["Choose landing target"].Value;
    }

    private string SelectedTargetPillAriaLabel(FeedingThrowChipTargetPill pill) =>
        L["Land on {0}", pill.Label].Value;

    private bool CanIncreaseSelectedHeight(int person) =>
        _direct.HasSelection
        && _direct.SelectedPerson == person
        && SelectedPassingCell.Height < _direct.MaxThrowHeight;

    private bool CanDecreaseSelectedHeight(int person) =>
        _direct.HasSelection && _direct.SelectedPerson == person && SelectedPassingCell.Height > 0;

    private void AdjustPassingHeight(int delta)
    {
        _direct.SetHeight(
            _direct.SelectedPerson,
            _direct.SelectedBeat,
            SelectedPassingCell.Height + delta
        );
        SaveStateToUrl();
    }

    private IReadOnlyList<FeedingThrowDisplay.Chip> PassingChipsFor(int person) =>
        _direct.People[person]
            .Cells.Select(
                (cell, beat) =>
                    new FeedingThrowDisplay.Chip(
                        FeedingThrowDisplay.Format(
                            cell.Height,
                            _direct.ActiveTimeZoneCount,
                            _throwDisplayMode
                        ),
                        cell.TargetPerson == person ? PassOrSelf.Self : PassOrSelf.Pass,
                        cell.Height,
                        beat,
                        cell.TargetPerson is int targetPerson ? _direct.People[targetPerson].Name : null
                    )
            )
            .ToArray();

    private async Task TogglePassDestinationsAsync()
    {
        _showPassDestinations = !_showPassDestinations;
        var settings = await LocalStorage.GetItemAsync<SettingsDto>("settings") ?? new SettingsDto();
        settings.ShowPassDestinations = _showPassDestinations;
        await LocalStorage.SetItemAsync("settings", settings);
    }

    private int? LandingBeatFor(int person) =>
        _direct.HasSelection && SelectedPassingLanding.TargetPerson == person
            ? SelectedPassingLanding.TargetBeat
            : null;

    private string PassingChipAccessibleName(int person, FeedingThrowDisplay.Chip chip)
    {
        if (_dragSourcePerson is int dragPerson && _dragSourceBeat is int dragBeat)
        {
            if (person == dragPerson && chip.LocalBeat == dragBeat)
            {
                return L[
                    "Dragging {0} {1}, {2} beat {3}. Drop on another cell to set landing target.",
                    chip.Display,
                    PassingKindName(chip.Kind),
                    _direct.People[person].Name,
                    chip.LocalBeat + 1
                ];
            }

            if (_direct.CanSetLandingTarget(dragPerson, dragBeat, person, chip.LocalBeat))
            {
                return L[
                    "Drop to land dragged throw from {0} beat {1} on {2} beat {3}.",
                    _direct.People[dragPerson].Name,
                    dragBeat + 1,
                    _direct.People[person].Name,
                    chip.LocalBeat + 1
                ];
            }
        }

        var landing = _direct.LandingFor(person, chip.LocalBeat);
        var target =
            landing.TargetPerson is { } targetPerson ? _direct.People[targetPerson].Name : "—";
        var slotState = LandingSlotStateName(person, chip.LocalBeat);
        if (
            _direct.HasSelection
            && _direct.SelectedPerson == person
            && _direct.SelectedBeat == chip.LocalBeat
        )
        {
            var selectedLanding = SelectedPassingLanding;
            return L[
                "Selected throw {0} {1}, {2} beat {3}. Lands on {4} beat {5}. Press to clear.",
                chip.Display,
                PassingKindName(chip.Kind),
                _direct.People[person].Name,
                chip.LocalBeat + 1,
                selectedLanding.TargetPerson is { } selectedTarget
                    ? _direct.People[selectedTarget].Name
                    : "—",
                selectedLanding.TargetBeat + 1
            ];
        }

        if (
            _direct.HasSelection
            && SelectedPassingLanding.TargetBeat == chip.LocalBeat
            && SelectedPassingLanding.TargetPerson == person
        )
        {
            return L[
                "{0} {1}, {2} beat {3}. Landing of selected throw from {4} beat {5}.",
                chip.Display,
                PassingKindName(chip.Kind),
                _direct.People[person].Name,
                chip.LocalBeat + 1,
                _direct.People[_direct.SelectedPerson].Name,
                _direct.SelectedBeat + 1
            ];
        }

        if (_direct.HasSelection && IsIncomingSourceForSelection(person, chip.LocalBeat))
        {
            return L[
                "{0} {1}, {2} beat {3}. Lands on selected cell at {4} beat {5}.",
                chip.Display,
                PassingKindName(chip.Kind),
                _direct.People[person].Name,
                chip.LocalBeat + 1,
                _direct.People[_direct.SelectedPerson].Name,
                _direct.SelectedBeat + 1
            ];
        }

        return L[
            "{0}, beat {1}: throw {2} {3}, lands on {4}, beat {5}",
            _direct.People[person].Name,
            chip.LocalBeat + 1,
            chip.Display,
            PassingKindName(chip.Kind),
            target,
            landing.TargetBeat + 1
        ] + (slotState is null ? string.Empty : $". {slotState}");
    }

    private string PassingChipStateClass(int person, int beat)
    {
        var classes = new List<string>();
        var slotState = LandingSlotStateClass(person, beat);
        if (!string.IsNullOrEmpty(slotState))
        {
            classes.Add(slotState);
        }

        if (IsIncomingSourceForSelection(person, beat))
        {
            classes.Add("is-incoming");
        }

        return string.Join(' ', classes);
    }

    private bool IsIncomingSourceForSelection(int person, int beat) =>
        _direct.HasSelection
        && _direct
            .SourcesLandingAt(_direct.SelectedPerson, _direct.SelectedBeat)
            .Any(landing => landing.SourcePerson == person && landing.SourceBeat == beat);

    private string LandingSlotStateClass(int person, int beat)
    {
        var slot = new PassingLandingSlot(person, beat);
        return _direct.CollisionTargets.Contains(slot)
            ? "collision"
            : _direct.EmptyTargets.Contains(slot)
                ? "unfilled"
                : string.Empty;
    }

    private string? LandingSlotStateName(int person, int beat) =>
        LandingSlotStateClass(person, beat) switch
        {
            "collision" => L["Collision"].Value,
            "unfilled" => L["No incoming throw"].Value,
            _ => null,
        };

    private string PassingKindName(PassOrSelf kind) =>
        kind == PassOrSelf.Pass ? L["Pass"] : L["Self"];

    private void OnTimeZoneRowKeyDown(KeyboardEventArgs e, int personIndex)
    {
        if (e.Key is "Enter" or " ")
        {
            _direct.CycleTimeZone(personIndex);
            RebuildLayoutForCurrentPreset();
            SaveStateToUrl();
        }
    }

    private void ApplyCircleLayoutPreset() => ApplyLayoutPreset("circle");

    private void ApplyWvLayoutPreset() => ApplyLayoutPreset("w-v");

    private void ApplyLayoutPreset(string preset, bool save = true)
    {
        _layoutPreset = preset is "circle" or "w-v" ? preset : "w-v";
        _layoutPoses = CreateLayoutPoses(_layoutPreset, _direct.People.Select(person => person.TimeZone).ToArray());
        if (save)
        {
            SaveStateToUrl();
        }
    }

    private void RebuildLayoutForCurrentPreset()
    {
        if (_layoutPreset is "circle" or "w-v")
        {
            ApplyLayoutPreset(_layoutPreset, save: false);
            return;
        }

        var count = _direct.People.Count;
        if (_layoutPoses.Length > count)
        {
            _layoutPoses = _layoutPoses[..count];
        }
        else if (_layoutPoses.Length < count)
        {
            var defaults = CreateLayoutPoses(
                "w-v",
                _direct.People.Select(person => person.TimeZone).ToArray()
            );
            _layoutPoses = _layoutPoses.Concat(defaults.Skip(_layoutPoses.Length)).ToArray();
        }

    }

    private static JugglerLayoutPose[] CreateLayoutPoses(string preset, IReadOnlyList<int> timeZones)
    {
        if (timeZones.Count == 0)
        {
            return [];
        }

        return preset == "circle"
            ? JugglerLayoutPresets.CreateCircleLayout(timeZones.Count)
            : JugglerLayoutPresets.CreateWvLayout(timeZones);
    }

    private Task OnLayoutChanged(JugglerLayoutChange change)
    {
        _layoutPreset = change.Preset;
        _layoutPoses = change.Poses.ToArray();
        if (change.Commit)
        {
            SaveStateToUrl();
        }
        return Task.CompletedTask;
    }

    private void SaveStateToUrl(bool replace = false)
    {
        if (_direct.People.Count == 0)
        {
            return;
        }

        var snapshot = new LabDeepLinkState(
            1,
            _direct.MaxThrowHeight,
            _direct.People.Select(person => person.TimeZone).ToArray(),
            _direct.People.Select(person => person.Cells.Select(cell => cell.Height).ToArray()).ToArray(),
            _direct.People.Select(person => person.Cells.Select(cell => cell.TargetPerson ?? -1).ToArray()).ToArray(),
            _direct.ThrowsInitialized,
            _direct.HasSelection,
            _direct.SelectedPerson,
            _direct.SelectedBeat,
            _cellsStep,
            _visitedCellsSteps.Order().ToArray(),
            _throwDisplayMode.ToString(),
            _layoutPreset,
            _layoutPoses
        );
        var json = JsonSerializer.Serialize(snapshot);
        var encoded = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json))
            .TrimEnd('=')
            .Replace('+', '-')
            .Replace('/', '_');
        _lastAppliedState = encoded;
        UrlStateNavigation.SetQueryParameter("state", encoded, replace);
    }

    private bool TryRestoreState(string? encoded, int? localMaxHeight)
    {
        if (string.IsNullOrWhiteSpace(encoded) || encoded.Length > 12000)
        {
            return false;
        }

        try
        {
            var base64 = encoded.Replace('-', '+').Replace('_', '/');
            base64 += new string('=', (4 - base64.Length % 4) % 4);
            var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(base64));
            var state = JsonSerializer.Deserialize<LabDeepLinkState>(json);
            if (state is null || state.Version != 1 || state.TimeZones is null || state.Heights is null || state.Targets is null)
            {
                return false;
            }

            var peopleCount = state.TimeZones.Length;
            if (peopleCount is < PassingEditorState.MinPeople or > PassingEditorState.MaxPeople
                || state.Heights.Length != peopleCount || state.Targets.Length != peopleCount)
            {
                return false;
            }

            var period = state.Heights[0]?.Length ?? 0;
            if (period is < 1 or > Siteswap.MaxPeriodLength
                || state.Heights.Any(row => row is null || row.Length != period)
                || state.Targets.Any(row => row is null || row.Length != period)
                || state.TimeZones.Any(zone => zone < 0 || zone >= peopleCount))
            {
                return false;
            }

            var maxHeight = SettingsDto.ClampMaxHeight(state.MaxHeight > 0 ? state.MaxHeight : localMaxHeight ?? new SettingsDto().MaxHeight);
            _direct = new PassingEditorState(maxThrowHeight: maxHeight);
            _direct.SetPersonCount(peopleCount);
            while (_direct.Period < period) _direct.AddBeat();
            while (_direct.Period > period) _direct.RemoveBeat();
            for (var person = 0; person < peopleCount; person++)
            {
                for (var zone = _direct.People[person].TimeZone; zone != state.TimeZones[person]; zone = (zone + 1) % peopleCount)
                {
                    _direct.CycleTimeZone(person);
                }
            }

            if (state.ThrowsInitialized)
            {
                _direct.InitializeThrowsForFirstEntry();
                for (var person = 0; person < peopleCount; person++)
                {
                    for (var beat = 0; beat < period; beat++)
                    {
                        var height = Math.Clamp(state.Heights[person][beat], 0, maxHeight);
                        _direct.SetHeight(person, beat, height);
                        var target = state.Targets[person][beat];
                        if (target >= 0 && target < peopleCount && _direct.CanSetTarget(person, beat, target))
                        {
                            _direct.SetTarget(person, beat, target);
                        }
                    }
                }
            }

            _cellsStep = Math.Clamp(state.CellsStep, 0, CellsStepCount - 1);
            _visitedCellsSteps.Clear();
            _visitedCellsSteps.Add(0);
            if (state.VisitedSteps is not null)
            {
                foreach (var step in state.VisitedSteps.Where(step => step is >= 0 and < CellsStepCount))
                {
                    _visitedCellsSteps.Add(step);
                }
            }
            if (_cellsStep == 1) _visitedCellsSteps.Add(1);
            if (state.HasSelection && state.SelectedPerson >= 0 && state.SelectedPerson < peopleCount && state.SelectedBeat >= 0 && state.SelectedBeat < period)
            {
                _direct.SelectCell(state.SelectedPerson, state.SelectedBeat);
            }
            else
            {
                _direct.ClearSelection();
            }

            _throwDisplayMode = FeedingThrowDisplay.ParseMode(state.DisplayMode);
            _layoutPreset = state.LayoutPreset is "circle" or "w-v" or "custom"
                ? state.LayoutPreset
                : "w-v";
            if (
                state.LayoutPoses is { } storedPoses
                && storedPoses.Length == peopleCount
                && storedPoses.All(pose =>
                    pose is not null
                    && double.IsFinite(pose.X)
                    && double.IsFinite(pose.Z)
                    && double.IsFinite(pose.Rotation)
                    && Math.Abs(pose.X) <= 1
                    && Math.Abs(pose.Z) <= 1
                )
            )
            {
                _layoutPoses = storedPoses
                    .Select(pose => pose with { Rotation = JugglerLayoutPresets.NormalizeRotation(pose.Rotation) })
                    .ToArray();
            }
            else
            {
                _layoutPoses = CreateLayoutPoses(_layoutPreset, state.TimeZones);
            }
            return true;
        }
        catch (Exception exception) when (exception is FormatException or JsonException or ArgumentException or IndexOutOfRangeException)
        {
            return false;
        }
    }

    private sealed record LabDeepLinkState(
        int Version,
        int MaxHeight,
        int[] TimeZones,
        int[][] Heights,
        int[][] Targets,
        bool ThrowsInitialized,
        bool HasSelection,
        int SelectedPerson,
        int SelectedBeat,
        int CellsStep,
        int[] VisitedSteps,
        string DisplayMode,
        string? LayoutPreset = null,
        JugglerLayoutPose[]? LayoutPoses = null
    );

}
