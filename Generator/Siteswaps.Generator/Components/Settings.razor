@page "/Settings"
@using Blazored.LocalStorage
@using Microsoft.JSInterop
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@inject IStringLocalizer<Settings> L

<PageTitle>@L["Settings"]</PageTitle>

<div class="settings-page">
    <header class="settings-header">
        <h1 class="settings-title">@L["Settings"]</h1>
    </header>

    <div class="settings-body">
        <div class="settings-measure">
            <EditForm Model="Value" OnValidSubmit="SaveSettings">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="settings-field">
                    <p class="settings-section-label">@L["Language"]</p>
                    <div class="settings-segmented" role="radiogroup" aria-label="@L["Language"]">
                        <button type="button"
                                class="settings-segment @(Value.Culture == AppCultures.German ? "active" : null)"
                                role="radio"
                                aria-checked="@(Value.Culture == AppCultures.German ? "true" : "false")"
                                @onclick='() => Value.Culture = AppCultures.German'>
                            @L["German"]
                        </button>
                        <button type="button"
                                class="settings-segment @(Value.Culture == AppCultures.English ? "active" : null)"
                                role="radio"
                                aria-checked="@(Value.Culture == AppCultures.English ? "true" : "false")"
                                @onclick='() => Value.Culture = AppCultures.English'>
                            @L["English"]
                        </button>
                    </div>
                </div>

                <div class="settings-field">
                    <p class="settings-section-label">@L["Use throw names"]</p>
                    <div class="settings-segmented" role="radiogroup" aria-label="@L["Use throw names"]">
                        <button type="button"
                                class="settings-segment @(Value.ShowThrowNames ? "active" : null)"
                                role="radio"
                                aria-checked="@(Value.ShowThrowNames ? "true" : "false")"
                                @onclick="() => Value.ShowThrowNames = true">
                            @L["On"]
                        </button>
                        <button type="button"
                                class="settings-segment @(!Value.ShowThrowNames ? "active" : null)"
                                role="radio"
                                aria-checked="@(!Value.ShowThrowNames ? "true" : "false")"
                                @onclick="() => Value.ShowThrowNames = false">
                            @L["Off"]
                        </button>
                    </div>
                </div>

                <div class="settings-field">
                    <p class="settings-section-label">@L["Throw display (details)"]</p>
                    <div class="settings-segmented" role="radiogroup" aria-label="@L["Throw display (details)"]">
                        <button type="button"
                                class="settings-segment @(Value.ThrowDisplayMode == "Local" ? "active" : null)"
                                role="radio"
                                aria-checked="@(Value.ThrowDisplayMode == "Local" ? "true" : "false")"
                                @onclick='() => Value.ThrowDisplayMode = "Local"'>
                            @L["Local"]
                        </button>
                        <button type="button"
                                class="settings-segment @(Value.ThrowDisplayMode == "Global" ? "active" : null)"
                                role="radio"
                                aria-checked="@(Value.ThrowDisplayMode == "Global" ? "true" : "false")"
                                @onclick='() => Value.ThrowDisplayMode = "Global"'>
                            @L["Global"]
                        </button>
                        <button type="button"
                                class="settings-segment @(Value.ThrowDisplayMode == "Name" ? "active" : null)"
                                role="radio"
                                aria-checked="@(Value.ThrowDisplayMode == "Name" ? "true" : "false")"
                                @onclick='() => Value.ThrowDisplayMode = "Name"'>
                            @L["Names"]
                        </button>
                    </div>
                </div>

                <div class="settings-field">
                    <label class="settings-section-label" for="settings-max-height">@L["Max height"]</label>
                    <input id="settings-max-height"
                           type="number"
                           class="settings-input-number"
                           min="1"
                           max="50"
                           @bind="Value.MaxHeight"
                           @bind:event="oninput" />
                </div>

                <div class="settings-actions">
                    <button type="submit" class="settings-btn-primary">@L["Save settings"]</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private SettingsDto Value { get; set; } = new();
    private string _cultureWhenOpened = AppCultures.Default;

    protected override async Task OnInitializedAsync()
    {
        var settings = await LocalStorage.GetItemAsync<SettingsDto>("settings");
        if (settings != null)
        {
            Value = settings;
            if (string.IsNullOrWhiteSpace(Value.ThrowDisplayMode))
            {
                Value.ThrowDisplayMode = "Global";
            }
        }

        var preferred = await JsRuntime.InvokeAsync<string>("blazorCulture.getPreferred");
        Value.Culture = AppCultures.Normalize(
            string.IsNullOrWhiteSpace(Value.Culture) ? preferred : Value.Culture
        );
        _cultureWhenOpened = Value.Culture;
    }

    private async Task SaveSettings()
    {
        Value.Culture = AppCultures.Normalize(Value.Culture);
        Value.MaxHeight = SettingsDto.ClampMaxHeight(Value.MaxHeight);
        await LocalStorage.SetItemAsync("settings", Value);
        await JsRuntime.InvokeVoidAsync("blazorCulture.set", Value.Culture);

        if (!string.Equals(_cultureWhenOpened, Value.Culture, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
    }
}
