@page "/Settings"
@using Blazored.LocalStorage
@using Microsoft.JSInterop
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@using Siteswaps.Generator.Services
@inject AppUpdateService AppUpdate
@inject IStringLocalizer<Settings> L

<PageTitle>@L["Settings"]</PageTitle>

<SectionContent SectionName="@WizardShellSections.Header">
    <h1 id="settings-title" class="settings-title">@L["Settings"]</h1>
</SectionContent>

<SectionContent SectionName="@WizardShellSections.Body">
    <div class="wizard-steps settings-steps">
        <section class="wizard-step active" aria-labelledby="settings-title">
            <div class="wizard-measure settings-measure">
                <EditForm Model="Value" OnValidSubmit="SaveSettings">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="settings-field">
                        <p class="settings-section-label">@L["Language"]</p>
                        <div class="settings-segmented" role="radiogroup" aria-label="@L["Language"]">
                            <button type="button"
                                    class="settings-segment @(Value.Culture == AppCultures.German ? "active" : null)"
                                    role="radio"
                                    aria-checked="@(Value.Culture == AppCultures.German ? "true" : "false")"
                                    @onclick='() => Value.Culture = AppCultures.German'>
                                @L["German"]
                            </button>
                            <button type="button"
                                    class="settings-segment @(Value.Culture == AppCultures.English ? "active" : null)"
                                    role="radio"
                                    aria-checked="@(Value.Culture == AppCultures.English ? "true" : "false")"
                                    @onclick='() => Value.Culture = AppCultures.English'>
                                @L["English"]
                            </button>
                        </div>
                    </div>

                    <div class="settings-field">
                        <p class="settings-section-label">@L["Use throw names"]</p>
                        <div class="settings-segmented" role="radiogroup" aria-label="@L["Use throw names"]">
                            <button type="button"
                                    class="settings-segment @(Value.ShowThrowNames ? "active" : null)"
                                    role="radio"
                                    aria-checked="@(Value.ShowThrowNames ? "true" : "false")"
                                    @onclick="() => Value.ShowThrowNames = true">
                                @L["On"]
                            </button>
                            <button type="button"
                                    class="settings-segment @(!Value.ShowThrowNames ? "active" : null)"
                                    role="radio"
                                    aria-checked="@(!Value.ShowThrowNames ? "true" : "false")"
                                    @onclick="() => Value.ShowThrowNames = false">
                                @L["Off"]
                            </button>
                        </div>
                    </div>

                    <div class="settings-field">
                        <p class="settings-section-label">@L["Throw display (details)"]</p>
                        <div class="settings-segmented" role="radiogroup" aria-label="@L["Throw display (details)"]">
                            <button type="button"
                                    class="settings-segment @(Value.ThrowDisplayMode == "Local" ? "active" : null)"
                                    role="radio"
                                    aria-checked="@(Value.ThrowDisplayMode == "Local" ? "true" : "false")"
                                    @onclick='() => Value.ThrowDisplayMode = "Local"'>
                                @L["Local"]
                            </button>
                            <button type="button"
                                    class="settings-segment @(Value.ThrowDisplayMode == "Global" ? "active" : null)"
                                    role="radio"
                                    aria-checked="@(Value.ThrowDisplayMode == "Global" ? "true" : "false")"
                                    @onclick='() => Value.ThrowDisplayMode = "Global"'>
                                @L["Global"]
                            </button>
                            <button type="button"
                                    class="settings-segment @(Value.ThrowDisplayMode == "Name" ? "active" : null)"
                                    role="radio"
                                    aria-checked="@(Value.ThrowDisplayMode == "Name" ? "true" : "false")"
                                    @onclick='() => Value.ThrowDisplayMode = "Name"'>
                                @L["Names"]
                            </button>
                        </div>
                    </div>

                    <div class="settings-field">
                        <label class="settings-section-label" for="settings-max-height">@L["Max height"]</label>
                        <input id="settings-max-height"
                               type="number"
                               class="settings-input-number"
                               min="1"
                               max="50"
                               @bind="Value.MaxHeight"
                               @bind:event="oninput" />
                    </div>

                    <div class="settings-actions">
                        <button type="submit" class="settings-btn-primary">@L["Save settings"]</button>
                    </div>
                </EditForm>

                <div class="settings-field settings-update-section">
                    <p class="settings-section-label">@L["App updates"]</p>
                    <p class="settings-update-hint">@L["App updates hint"]</p>
                    @if (!string.IsNullOrEmpty(_updateStatusMessage))
                    {
                        <p class="settings-update-status" role="status">@_updateStatusMessage</p>
                    }
                    <div class="settings-actions">
                        <button type="button"
                                class="settings-btn-secondary"
                                disabled="@_updateCheckInProgress"
                                @onclick="CheckForUpdatesAsync">
                            @(_updateCheckInProgress ? L["Checking for updates…"] : L["Check for updates"])
                        </button>
                        @if (_updateAvailable)
                        {
                            <button type="button"
                                    class="settings-btn-primary"
                                    @onclick="ApplyUpdateAsync">
                                @L["Install update and reload"]
                            </button>
                        }
                    </div>
                </div>
            </div>
        </section>
    </div>
</SectionContent>

@code {
    private SettingsDto Value { get; set; } = new();
    private string _cultureWhenOpened = AppCultures.Default;
    private bool _updateCheckInProgress;
    private bool _updateAvailable;
    private string? _updateStatusMessage;

    protected override async Task OnInitializedAsync()
    {
        var settings = await LocalStorage.GetItemAsync<SettingsDto>("settings");
        if (settings != null)
        {
            Value = settings;
            if (string.IsNullOrWhiteSpace(Value.ThrowDisplayMode))
            {
                Value.ThrowDisplayMode = "Global";
            }
        }

        var preferred = await JsRuntime.InvokeAsync<string>("blazorCulture.getPreferred");
        Value.Culture = AppCultures.Normalize(
            string.IsNullOrWhiteSpace(Value.Culture) ? preferred : Value.Culture
        );
        _cultureWhenOpened = Value.Culture;
    }

    private async Task SaveSettings()
    {
        Value.Culture = AppCultures.Normalize(Value.Culture);
        Value.MaxHeight = SettingsDto.ClampMaxHeight(Value.MaxHeight);
        await LocalStorage.SetItemAsync("settings", Value);
        await JsRuntime.InvokeVoidAsync("blazorCulture.set", Value.Culture);

        if (!string.Equals(_cultureWhenOpened, Value.Culture, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
    }

    private async Task CheckForUpdatesAsync()
    {
        _updateCheckInProgress = true;
        _updateStatusMessage = null;
        _updateAvailable = false;

        try
        {
            var result = await AppUpdate.CheckForUpdatesAsync();
            _updateAvailable = result.Status == AppUpdateStatus.UpdateAvailable;
            _updateStatusMessage = result.Status switch
            {
                AppUpdateStatus.UpToDate => L["App is up to date"].Value,
                AppUpdateStatus.UpdateAvailable => L["Update available"].Value,
                AppUpdateStatus.Unsupported => L["Updates not available here"].Value,
                AppUpdateStatus.CheckFailed => result.Message ?? L["Update check failed"].Value,
                _ => null,
            };
        }
        finally
        {
            _updateCheckInProgress = false;
        }
    }

    private Task ApplyUpdateAsync() => AppUpdate.ApplyUpdateAsync();
}
