@page "/cardstack"
@layout MobileLayout
@using Siteswaps.Generator.Components.CardStackPage.Components
@using Siteswaps.Generator.Components.CardStackPage.Models
@using Siteswaps.Generator.Components.State

<PageTitle>Card Stack – Siteswap Generator</PageTitle>

<div class="cs-page" @ref="_pageRef">

    <div class="cs-header">
        <div class="cs-header-top">
            <div class="cs-brand">
                <span class="cs-logo">PZ</span>
                <span class="cs-eyebrow">SITESWAP GENERATOR</span>
            </div>
        </div>
        <h1 class="cs-font-display cs-title">Baue dein Pattern</h1>
        <p class="cs-subtitle">Alles auf einen Blick – scroll runter und stell ein.</p>
    </div>

    <div class="cs-scroll-area">

        <div class="cs-card">
            <div class="cs-card-header">
                <h2 class="cs-font-display cs-card-title">Jongleure</h2>
                <span class="cs-echo">@_state.Jugglers</span>
            </div>
            <PillChoice TValue="int" Options="JugglerOptions" Value="_state.Jugglers"
                        ValueChanged="v => _state.Jugglers = v" AriaLabel="Jongleure" />
            <div class="cs-exact-input-row">
                <label class="cs-exact-input-label" for="jugglersExact">oder genaue Anzahl</label>
                <input id="jugglersExact" type="number" inputmode="numeric" class="cs-number-input"
                       min="@CardStackFormState.MinJugglers" max="@CardStackFormState.MaxJugglersExact"
                       value="@_state.Jugglers" @oninput="OnJugglersExactChanged" @onchange="OnJugglersExactChanged" />
            </div>
        </div>

        <div class="cs-card">
            <div class="cs-card-header">
                <h2 class="cs-font-display cs-card-title">Periode</h2>
                <span class="cs-hint">wie viele Würfe wiederholen sich</span>
            </div>
            <Stepper Value="_state.Period" ValueChanged="v => _state.Period = v"
                     Min="CardStackFormState.MinPeriod" Max="CardStackFormState.MaxPeriod" AriaLabel="Periode" />
        </div>

        <div class="cs-card">
            <div class="cs-card-header">
                <h2 class="cs-font-display cs-card-title">Anzahl Clubs</h2>
                <span class="cs-echo">@_state.ClubsMin–@_state.ClubsMax</span>
            </div>
            <DualRangeSlider Min="CardStackFormState.MinClubs" Max="CardStackFormState.MaxClubs"
                              ValueMin="_state.ClubsMin" ValueMinChanged="v => _state.ClubsMin = v"
                              ValueMax="_state.ClubsMax" ValueMaxChanged="v => _state.ClubsMax = v"
                              MinAriaLabel="Clubs Minimum" MaxAriaLabel="Clubs Maximum" />
            <div class="cs-range-bounds">
                <span>@CardStackFormState.MinClubs</span>
                <span>@CardStackFormState.MaxClubs</span>
            </div>
        </div>

        <div class="cs-card">
            <div class="cs-card-header">
                <h2 class="cs-font-display cs-card-title">Erlaubte Würfe</h2>
                <div class="cs-header-actions">
                    <button type="button" class="cs-link-btn" @onclick="SelectAllThrows">Alle</button>
                </div>
            </div>
            <ThrowChipGrid Value="_state.AllowedThrowHeights" ValueChanged="v => _state.AllowedThrowHeights = v" />
        </div>

        <div class="cs-card">
            <div class="cs-card-header">
                <h2 class="cs-font-display cs-card-title">Filter</h2>
                <span class="cs-hint">optional</span>
            </div>
            <FilterList State="_state" OnEditRequested="OpenEditFilterSheet" />
            <p class="cs-and-hint">Filter in derselben Gruppe müssen alle zutreffen – schon eine passende Gruppe reicht aus.</p>
            <button type="button" class="cs-add-filter-btn" @onclick="OpenAddFilterSheet">+ Filter hinzufügen</button>
        </div>

        @if (_hasGenerated || _isGenerating)
        {
            <div class="cs-card cs-results-section">
                <div class="cs-card-header">
                    <h2 class="cs-font-display cs-card-title">Ergebnisse</h2>
                    <span class="cs-echo">@_results.Count</span>
                </div>
                @if (_isGenerating && _results.Count == 0)
                {
                    <div class="cs-spinner" role="status" aria-live="polite" aria-label="Generiere Ergebnisse">
                        <div class="cs-spinner-dot"></div>
                        <div class="cs-spinner-dot"></div>
                        <div class="cs-spinner-dot"></div>
                    </div>
                }
                else if (_results.Count == 0 && !_isGenerating)
                {
                    <p class="cs-hint">Keine Treffer für diese Einstellungen.</p>
                }
                else
                {
                    @if (_isGenerating)
                    {
                        <p class="cs-loading-more" role="status" aria-live="polite">Lädt weitere Ergebnisse…</p>
                    }
                    <div class="cs-results-grid">
                        @foreach (var siteswap in _results)
                        {
                            <SiteswapCard Siteswap="siteswap" NumberOfJugglers="_state.Jugglers" />
                        }
                    </div>
                }
            </div>
        }

    </div>

    <div @ref="_footerRef" class="cs-footer @(_sheetOpen ? "cs-footer-inert" : "")" aria-hidden="@(_sheetOpen ? "true" : null)">
        <button type="button" class="cs-btn-primary cs-generate-btn" disabled="@(_isGenerating || _sheetOpen)"
                tabindex="@(_sheetOpen ? -1 : 0)" @onclick="GenerateAsync">
            @(_isGenerating ? "Generiere…" : "Generieren →")
        </button>
    </div>

    <FilterEditorSheet
        IsOpen="_sheetOpen"
        IsOpenChanged="v => _sheetOpen = v"
        EditingItem="_editingItem"
        Period="_state.Period"
        Jugglers="_state.Jugglers"
        AllowedThrowHeights="_state.AllowedThrowHeights"
        OnSave="SaveFilter"
        OnDelete="DeleteFilter" />

</div>

@code {
    private void SelectAllThrows()
    {
        _state.AllowedThrowHeights = [..Throw.All(12).Select(t => t.Height)];
    }
}
