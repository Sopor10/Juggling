@using Siteswaps.Generator.Components.State

<p class="cs-sheet-hint">Tippe ein Feld an, dann einen Wurf darunter.</p>
<div class="cs-pattern-controls">
    <select class="cs-select cs-select-grow" value="@RotationSelectValue" @onchange="OnRotationSelectChanged">
        <option value="global">Global (ganzer Zyklus)</option>
        @for (var i = 0; i < Jugglers; i++)
        {
            var rotation = new PatternRotation(i);
            <option value="@i">Lokal – Jongleur @rotation.Display</option>
        }
    </select>
    <div class="cs-pill-group cs-pill-group-compact">
        <button type="button" class="cs-pill @(IsInclude ? "active" : "")" @onclick="() => SetInclude(true)">enthalten sein</button>
        <button type="button" class="cs-pill @(IsInclude is false ? "active" : "")" @onclick="() => SetInclude(false)">ausgeschlossen sein</button>
    </div>
</div>

<div class="cs-pattern-slots" role="group" aria-label="Muster-Sequenz">
    @for (var i = 0; i < PatternLength; i++)
    {
        var index = i;
        var height = index < SequenceHeights.Count ? SequenceHeights[index] : DefaultHeight;
        <button type="button" class="cs-chip @(index == _activeSlot ? "active" : "")" @onclick="() => SelectSlot(index)">
            @(Throw.All(13).FirstOrDefault(t => t.Height == height)?.GetDisplayValue(true) ?? height.ToString())
        </button>
    }
</div>

<div class="cs-chip-grid cs-chip-grid-palette" role="group" aria-label="Wurf-Palette">
    @foreach (var h in AllowedThrowHeights)
    {
        <button type="button" class="cs-chip" @onclick="() => PickHeight(h)">
            @(Throw.All(13).FirstOrDefault(t => t.Height == h)?.GetDisplayValue(true) ?? h.ToString())
        </button>
    }
</div>

@code {
    private int _activeSlot;

    [Parameter]
    public PatternRotation Rotation { get; set; } = PatternRotation.Global;

    [Parameter]
    public EventCallback<PatternRotation> RotationChanged { get; set; }

    [Parameter]
    public bool IsInclude { get; set; } = true;

    [Parameter]
    public EventCallback<bool> IsIncludeChanged { get; set; }

    [Parameter]
    public List<int> SequenceHeights { get; set; } = [];

    [Parameter]
    public EventCallback<List<int>> SequenceHeightsChanged { get; set; }

    [Parameter]
    public int Period { get; set; } = 5;

    [Parameter]
    public int Jugglers { get; set; } = 3;

    [Parameter]
    public List<int> AllowedThrowHeights { get; set; } = [];

    private int DefaultHeight => AllowedThrowHeights.Count > 0 ? AllowedThrowHeights[0] : 5;

    private string RotationSelectValue => Rotation == PatternRotation.Global ? "global" : Rotation.Value.ToString();

    private int PatternLength =>
        Rotation == PatternRotation.Global
            ? Math.Max(1, Period)
            : Math.Max(1, (int)Math.Round(Period / (double)Math.Max(1, Jugglers)));

    protected override void OnParametersSet()
    {
        if (SequenceHeights.Count != PatternLength)
        {
            var resized = new List<int>(PatternLength);
            for (var i = 0; i < PatternLength; i++)
            {
                resized.Add(i < SequenceHeights.Count ? SequenceHeights[i] : DefaultHeight);
            }

            SequenceHeights = resized;
        }

        if (_activeSlot >= PatternLength)
        {
            _activeSlot = 0;
        }
    }

    private void SelectSlot(int index) => _activeSlot = index;

    private async Task PickHeight(int height)
    {
        List<int> updated = [..SequenceHeights];
        updated[_activeSlot] = height;
        SequenceHeights = updated;
        _activeSlot = Math.Min(_activeSlot + 1, SequenceHeights.Count - 1);
        await SequenceHeightsChanged.InvokeAsync(SequenceHeights);
    }

    private async Task SetInclude(bool value)
    {
        IsInclude = value;
        await IsIncludeChanged.InvokeAsync(value);
    }

    private async Task OnRotationSelectChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "global";
        var rotation = raw == "global" ? PatternRotation.Global : new PatternRotation(int.Parse(raw));
        Rotation = rotation;
        _activeSlot = 0;
        await RotationChanged.InvokeAsync(rotation);
    }
}
