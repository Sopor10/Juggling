@using Siteswaps.Generator.Components.State
@using Siteswaps.Generator.Components.CardStackPage.Models

<p class="cs-sheet-hint">z. B. „genau 2× Heff“</p>
<div class="cs-number-row">
    <select class="cs-select" @bind:get="Comparison" @bind:set="OnComparisonChanged">
        <option value="@CardStackNumberComparison.Exactly">Genau</option>
        <option value="@CardStackNumberComparison.Maximum">Maximal</option>
        <option value="@CardStackNumberComparison.AtLeast">Mindestens</option>
    </select>
    <input type="number" class="cs-number-input" min="0" max="30" value="@Amount" @oninput="OnAmountInput" />
    <select class="cs-select cs-select-grow" @bind:get="ThrowHeight" @bind:set="OnThrowHeightChanged">
        @foreach (var h in AllowedThrowHeights)
        {
            <option value="@h">@Throw.All(13).FirstOrDefault(t => t.Height == h)?.GetDisplayValue(true)</option>
        }
    </select>
</div>

@code {
    [Parameter]
    public CardStackNumberComparison Comparison { get; set; }

    [Parameter]
    public EventCallback<CardStackNumberComparison> ComparisonChanged { get; set; }

    [Parameter]
    public int Amount { get; set; }

    [Parameter]
    public EventCallback<int> AmountChanged { get; set; }

    [Parameter]
    public int ThrowHeight { get; set; }

    [Parameter]
    public EventCallback<int> ThrowHeightChanged { get; set; }

    [Parameter]
    public List<int> AllowedThrowHeights { get; set; } = [];

    private async Task OnAmountInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            Amount = Math.Clamp(parsed, 0, 30);
            await AmountChanged.InvokeAsync(Amount);
        }
    }

    private async Task OnComparisonChanged(CardStackNumberComparison value)
    {
        Comparison = value;
        await ComparisonChanged.InvokeAsync(value);
    }

    private async Task OnThrowHeightChanged(int value)
    {
        ThrowHeight = value;
        await ThrowHeightChanged.InvokeAsync(value);
    }
}
