@* Single primary control: editable stepper (+/-, direct number entry). A
   redundant range slider for the same value used to be rendered underneath
   this, which read as unfinished/duplicated UI - removed in favor of this
   one control. *@
<div class="cs-stepper">
    <button type="button" class="cs-stepper-btn" @onclick="() => ChangeBy(-Step)" disabled="@(Value <= Min)" aria-label="Verringern">–</button>
    <input type="number" inputmode="numeric" class="cs-stepper-value cs-stepper-value-input"
           min="@Min" max="@Max" step="@Step" value="@Value"
           aria-label="@AriaLabel" @oninput="OnNumberInput" @onchange="OnNumberInput" />
    <button type="button" class="cs-stepper-btn" @onclick="() => ChangeBy(Step)" disabled="@(Value >= Max)" aria-label="Erhöhen">+</button>
</div>

@code {
    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    [Parameter]
    public int Min { get; set; }

    [Parameter]
    public int Max { get; set; } = 100;

    [Parameter]
    public int Step { get; set; } = 1;

    [Parameter]
    public string AriaLabel { get; set; } = "Wert";

    private async Task ChangeBy(int delta)
    {
        var next = Math.Clamp(Value + delta, Min, Max);
        if (next == Value)
        {
            return;
        }

        Value = next;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnNumberInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
        {
            var clamped = Math.Clamp(parsed, Min, Max);
            if (clamped == Value)
            {
                return;
            }

            Value = clamped;
            await ValueChanged.InvokeAsync(Value);
        }
    }
}
