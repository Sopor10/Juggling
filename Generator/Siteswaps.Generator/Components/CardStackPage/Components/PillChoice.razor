@typeparam TValue

<div class="cs-pill-group" role="radiogroup" aria-label="@AriaLabel">
    @foreach (var option in Options)
    {
        var isActive = EqualityComparer<TValue>.Default.Equals(option, Value);
        <button type="button" class="cs-pill @(isActive ? "active" : "")" role="radio" aria-checked="@(isActive ? "true" : "false")"
                @onclick="() => Select(option)">
            @GetLabel(option)
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TValue> Options { get; set; } = [];

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter]
    public Func<TValue, string>? Label { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Auswahl";

    private string GetLabel(TValue option) => Label is not null ? Label(option) : option?.ToString() ?? "";

    private async Task Select(TValue option)
    {
        if (EqualityComparer<TValue>.Default.Equals(option, Value))
        {
            return;
        }

        Value = option;
        await ValueChanged.InvokeAsync(option);
    }
}
