{
  "name": "Siteswaps",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0.400"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    "./features/aspire-cli": {},
    "./features/pi-coding-agent": {},
    "ghcr.io/devcontainers/features/powershell:2": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.hermes/auth.json,target=/host-hermes-auth.json,type=bind,readonly,consistency=cached",
    "source=juggling-pi-agent,target=/home/vscode/.pi/agent,type=volume",
    "source=juggling-nuget-packages,target=/home/vscode/.nuget/packages,type=volume",
    "source=juggling-nuget-http-cache,target=/home/vscode/.local/share/NuGet/http-cache,type=volume"
  ],
  "forwardPorts": [7021, 5000, 5001],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "DOTNET_NOLOGO": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
    "NUGET_PACKAGES": "/home/vscode/.nuget/packages",
    "NUGET_HTTP_CACHE_PATH": "/home/vscode/.local/share/NuGet/http-cache",
    "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/etc/ssl/certs",
    "PI_PROVIDER": "openai-codex",
    "PI_MODEL": "gpt-5.6-luna"
  },
  "initializeCommand": "test -e \"${localEnv:HOME}/.hermes/auth.json\" || install -D -m 600 /dev/null \"${localEnv:HOME}/.hermes/auth.json\"",
  "onCreateCommand": "bash .devcontainer/onCreate.sh",
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postStartCommand": "bash .devcontainer/postStart.sh",
  "customizations": {
    "jetbrains": {
      "settings": {
        "com.intellij:app:HttpConfigurable.use_proxy_pac": true
      },
      "plugins": []
    },
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "GitHub.copilot-chat",
        "GitHub.copilot"
      ]
    }
  }
}
