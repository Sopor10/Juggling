<Fluxor.Blazor.Web.StoreInitializer/>
<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="@(new[]{typeof(Siteswaps.Generator.AssemblyInfo).Assembly, typeof(Siteswaps.Components.Assembly).Assembly, typeof(Webassembly.Components.DesignTests.DesignTestComponentAttribute).Assembly})">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@SelectLayout(routeData)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private static Type SelectLayout(RouteData routeData) =>
        routeData.PageType.Assembly == typeof(Siteswaps.Generator.AssemblyInfo).Assembly
            ? typeof(WizardShellLayout)
            : typeof(MainLayout);
}
