@inject AppUpdateService AppUpdate
@inject IStringLocalizer<UpdateAvailableDetector> L
@implements IAsyncDisposable

@if (_newVersionAvailable)
{
    <button type="button"
            class="btn btn-warning shadow floating-update-button"
            @onclick="ApplyUpdateAsync">
        @L["Update available – reload"]
    </button>
}

@code {
    private DotNetObjectReference<UpdateAvailableDetector>? _self;
    private bool _newVersionAvailable;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        await AppUpdate.SubscribeAsync(_self);
    }

    [JSInvokable]
    public Task OnUpdateAvailable()
    {
        _newVersionAvailable = true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ApplyUpdateAsync() => await AppUpdate.ApplyUpdateAsync();

    public async ValueTask DisposeAsync()
    {
        if (_self is not null)
        {
            try
            {
                await AppUpdate.UnsubscribeAsync(_self);
            }
            catch (JSDisconnectedException) { }

            _self.Dispose();
        }
    }
}
