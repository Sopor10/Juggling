@inject NavigationManager Navigation

<nav class="pznav" aria-label="Hauptnavigation">
    <div class="pznav-bar">
        <a class="pznav-brand" href="" aria-label="Passing Zone – Siteswap Generator">
            <img class="pznav-logo" src="images/brand/passing_zone_short_logo.svg" width="52" height="32" alt="Passing Zone" />
            <span class="pznav-brand-text">Siteswap Generator</span>
        </a>
        <form class="pznav-search" @onsubmit="OpenSiteswap" @onsubmit:preventDefault>
            <label class="visually-hidden" for="pznav-siteswap">Siteswap öffnen</label>
            <input id="pznav-siteswap"
                   class="pznav-search-input"
                   type="search"
                   inputmode="text"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="Siteswap…"
                   aria-invalid="@(_invalid ? "true" : "false")"
                   @bind="_siteswapQuery"
                   @bind:event="oninput" />
            <button type="submit" class="pznav-search-submit" title="Details öffnen" aria-label="Details öffnen">
                →
            </button>
        </form>
        <button type="button" title="Navigation menu" class="pznav-toggler" aria-expanded="@(!collapseNavMenu)" @onclick="ToggleNavMenu">
            <span class="pznav-toggler-icon" aria-hidden="true"></span>
        </button>
        <div class="@NavMenuCssClass pznav-links">
            <NavLink class="pznav-link" href="Settings" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                Settings
            </NavLink>
        </div>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;
    private string _siteswapQuery = "";
    private bool _invalid;

    private string? NavMenuCssClass => collapseNavMenu ? "pznav-links-collapsed" : null;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private void CloseNavMenu() => collapseNavMenu = true;

    private void OpenSiteswap()
    {
        var query = _siteswapQuery.Trim();
        if (string.IsNullOrEmpty(query))
        {
            _invalid = true;
            return;
        }

        _invalid = false;
        CloseNavMenu();
        Navigation.NavigateTo($"/details?s={Uri.EscapeDataString(query)}");
    }
}
